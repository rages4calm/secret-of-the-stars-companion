diff --git a/recompiler/v2/native_interrupt_return.py b/recompiler/v2/native_interrupt_return.py
new file mode 100644
--- /dev/null
+++ b/recompiler/v2/native_interrupt_return.py
@@ -0,0 +1,28 @@
+"""E0 architectural RTI; original interrupt scheduler owns all boundaries."""
+from snes65816 import IMP,decode_insn,rom_offset
+from snes_cycles import instr_cpu_cycles
+from .ir import Return
+from .lowering import lower
+
+
+def collect_interrupt_return(rom,key,insn,ops,cycles,*,data_regions=(),exclude_ranges=(),forced=()):
+    if key.m not in(0,1)or key.x not in(0,1)or insn.data_region_exec:return None
+    if getattr(insn,'const_z_fold_unconditional',False)or getattr(insn,'dispatch_entries',None):return None
+    if(insn.mnem,insn.opcode,insn.mode,insn.length)!=('RTI',0x40,IMP,1):return None
+    pc=insn.addr&0xffffff
+    if key.pc&65535!=pc&65535 or pc&65535<0x8000 or pc>>16 in(0x7e,0x7f):return None
+    if(getattr(insn,'m_flag',None),getattr(insn,'x_flag',None))!=(key.m,key.x):return None
+    if pc&0x7fffff in forced or any(pc>>16 in(b,b^128)and lo<=pc&65535<hi for b,lo,hi in data_regions)or any(lo<=pc&65535<hi for lo,hi in exclude_ranges):return None
+    off=rom_offset(pc>>16,pc&65535)
+    if off<0 or off>=len(rom):return None
+    decoded=decode_insn(rom,off,pc&65535,pc>>16,key.m,key.x)
+    if decoded is None or(decoded.opcode,decoded.mnem,decoded.mode,decoded.operand,decoded.length)!=(insn.opcode,insn.mnem,insn.mode,insn.operand,insn.length):return None
+    decoded.m_flag,decoded.x_flag=key.m,key.x
+    if len(ops)!=1 or ops!=lower(decoded,value_factory=lambda:None):return None
+    op=ops[0]
+    if not isinstance(op,Return)or not op.interrupt or not op.long or op.source_pc24!=pc:return None
+    if cycles!=instr_cpu_cycles(insn.opcode,m=key.m,x=key.x,e=0):return None
+    # Original interp816 opcode40 / pullByte / setFlags. Status and X/Y
+    # truncation precede PC/PB reads; no PC increment or host return tag.
+    body='{ cpu->S=(uint16)(cpu->S+1); cpu->P=cpu_aot_read8(cpu,0x00,cpu->S);\ncpu_p_to_mirrors(cpu); if(cpu->x_flag){cpu->X&=0x00ffu;cpu->Y&=0x00ffu;}\ncpu->S=(uint16)(cpu->S+1); uint8 _rti_low=cpu_aot_read8(cpu,0x00,cpu->S);\ncpu->S=(uint16)(cpu->S+1); uint8 _rti_high=cpu_aot_read8(cpu,0x00,cpu->S);\ncpu->S=(uint16)(cpu->S+1); cpu->PB=cpu_aot_read8(cpu,0x00,cpu->S);\n*next_pc=((uint32)cpu->PB<<16)|((uint32)_rti_high<<8)|_rti_low; }'
+    return {'pc24':pc&0x7fffff,'m':key.m,'x':key.x,'length':1,'cycles':cycles,'bytes':rom[off:off+1].hex(),'next_pc':(pc+1)&65535,'body':body,'mnemonic':'RTI','contract':'source-native-e0-interrupt-return-v1','original_scheduler_interrupt_return':True,'popped_bytes':4,'dynamic_target':True}
