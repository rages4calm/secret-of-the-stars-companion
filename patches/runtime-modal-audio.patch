+static void OverlaySelftestKeyEvent(int key, bool pressed, bool repeat) {
+  SDL_Event e = {0};
+  e.type = pressed ? SDL_KEYDOWN : SDL_KEYUP;
+  e.key.repeat = repeat;
+#if SNESRECOMP_SDL3
+  e.key.key = key;
+  e.key.scancode = snesrecomp_sdl_scancode_from_key(key);
+#else
+  e.key.keysym.sym = key;
+  e.key.keysym.scancode = snesrecomp_sdl_scancode_from_key(key);
+#endif
+  SDL_PushEvent(&e);
+}
