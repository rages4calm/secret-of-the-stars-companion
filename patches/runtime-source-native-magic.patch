diff --git a/runner/src/snes/interp816.c b/runner/src/snes/interp816.c
--- a/runner/src/snes/interp816.c
+++ b/runner/src/snes/interp816.c
@@ -2532,6 +2532,34 @@
   uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
   interp816_arch_ror_a(cpu);
   interp_bridge_source_call_interp_exit(cpu, source, 0x6a);
+  return cpu->cyclesUsed;
+}
+
+/* Original magic long-indexed CPU cases shared verbatim. */
+static void interp816_arch_and_alx(Interp816 *cpu) {
+      uint32_t low = 0;
+      uint32_t high = interp816_adrAlx(cpu, &low);
+      interp816_and(cpu, low, high);
+}
+int interp816_native_and_alx(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x3f)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0x3f];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_and_alx(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x3f);
+  return cpu->cyclesUsed;
+}
+static void interp816_arch_adc_alx(Interp816 *cpu) {
+      uint32_t low = 0;
+      uint32_t high = interp816_adrAlx(cpu, &low);
+      interp816_adc(cpu, low, high);
+}
+int interp816_native_adc_alx(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x7f)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0x7f];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_adc_alx(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x7f);
   return cpu->cyclesUsed;
 }
 
