+def collect_stack_control(rom,key,insn,ops,cycles):
+    """Exact typed architectural step; never post-mode or host ownership."""
+    from snes65816 import decode_insn
+    from .ir import PullReg, Transfer, PushEffectiveAddress, Reg, SegKind
+    if insn.mnem not in STACK_CONTROLS or key.m not in (0,1) or key.x not in (0,1):return None
+    if insn.data_region_exec or getattr(insn,'const_z_fold_unconditional',False):return None
+    pc=insn.addr&0xffffff
+    if pc&0xffff<0x8000 or pc>>16 in (0x7e,0x7f) or len(ops)!=1:return None
+    offset=rom_offset(pc>>16,pc&0xffff)
+    if offset < 0 or offset + insn.length > len(rom):return None
+    decoded=decode_insn(rom,offset,pc&0xffff,pc>>16,key.m,key.x)
+    if decoded is None or (decoded.opcode,decoded.mnem,decoded.mode,decoded.operand,decoded.length)!=(insn.opcode,insn.mnem,insn.mode,insn.operand,insn.length):return None
+    from .lowering import lower
+    from snes_cycles import instr_cpu_cycles
+    decoded.m_flag,decoded.x_flag=key.m,key.x
+    if ops!=lower(decoded,value_factory=lambda:None):return None
+    if cycles!=instr_cpu_cycles(decoded.opcode,m=key.m,x=key.x,e=0):return None
+    op=ops[0]
+    if insn.mnem=='PLP':
