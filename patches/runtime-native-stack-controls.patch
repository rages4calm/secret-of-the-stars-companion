+        body='{ uint8 _old_p=cpu->P; uint16 _old_s=cpu->S; cpu->S=(uint16)(cpu->S+1); cpu->P=cpu_aot_read8(cpu,0,cpu->S); cpu_p_to_mirrors(cpu); if(cpu->x_flag){cpu->X&=0x00ffu;cpu->Y&=0x00ffu;} cpu_trace_stack_op(cpu,0,CPU_STACK_OP_PLP,_old_s,+1); cpu_trace_event(cpu,0,CPU_TR_PLP,_old_p,cpu->P); cpu_trace_px_record(cpu,0,2,_old_p,cpu->P); }'
+    elif insn.mnem in {'TCS','TXS'}:
+        src=Reg.A if insn.mnem=='TCS' else Reg.X
+        if not isinstance(op,Transfer) or op.src!=src or op.dst!=Reg.S:return None
+        body='{ uint16 _old_s=cpu->S; cpu->S='+('cpu->A' if src==Reg.A else 'cpu->X')+'; cpu_trace_event(cpu,0,CPU_TR_DB_WRITE,(uint8)(_old_s>>8),cpu->S); }'
+    else:
+        kind=SegKind.DP_INDIRECT if insn.mnem=='PEI' else SegKind.ABS_BANK
+        if not isinstance(op,PushEffectiveAddress) or op.seg.kind!=kind or op.seg.offset!=insn.operand or op.seg.index is not None:return None
+        if insn.mnem=='PEI':
+            body='if(cpu->D&0xff){cpu_aot_extra(cpu,1);} { uint16 _old_s=cpu->S; uint16 _stack_value=cpu_aot_read16(cpu,0,(uint16)(cpu->D+0x%04xu)); '%insn.operand
+            trace='CPU_STACK_OP_PEI'
+        else:
+            body='{ uint16 _old_s=cpu->S; uint16 _stack_value=0x%04xu; '%insn.operand
+            # Preserve the exact original runtime's explicit compatibility effect.
+            if insn.mnem=='PEA' and insn.operand==0xc2ae:body+='cpu->Y=0; '
+            trace='CPU_STACK_OP_PEA'
+        body+='cpu_aot_write8(cpu,0,cpu->S,(uint8)(_stack_value>>8)); cpu->S=(uint16)(cpu->S-1); cpu_aot_write8(cpu,0,cpu->S,(uint8)_stack_value); cpu->S=(uint16)(cpu->S-1); cpu_trace_stack_op(cpu,0,'+trace+',_old_s,-2); }'
+    return {'pc24':pc&0x7fffff,'m':key.m,'x':key.x,'length':insn.length,'cycles':cycles,'bytes':rom[offset:offset+insn.length].hex(),'next_pc':(pc+insn.length)&0xffff,'body':body,'mnemonic':insn.mnem}
 
