+/* Only source-registered stack instructions, never implicit general decoding.
+ * Legacy CALL/return registrations remain unchanged with stack_mode=0. */
+bool interp_bridge_add_native_stack_site(uint32_t pc, uint8_t opcode,
+                                         unsigned m, const int *enabled) {
+    if (!enabled || pc>0xffffff || (pc&0xffff)<0x8000 ||
+        (pc>>16)==0x7e || (pc>>16)==0x7f ||
+        ((opcode==0x48 || opcode==0x68) ? m>1 :
+         (opcode==0x08 || opcode==0x28) ? m!=2 : true) ||
+        s_native_control_site_count==32 || s_pre_opcode_callback_cpu ||
+        s_native_instruction_cpu || s_interp_bus_timing_active) return false;
+    for(unsigned n=0;n<s_native_control_site_count;++n)
+        if(s_native_control_sites[n].pc24==pc)return false;
+    NativeControlSite *site=&s_native_control_sites[s_native_control_site_count++];
+    site->pc24=pc;site->bytes[0]=opcode;site->length=1;site->enabled=enabled;
+    site->stack_mode=(uint8_t)(m+1);
+    site->step=opcode==0x08?interp816_native_php:opcode==0x48?interp816_native_pha:
+               opcode==0x68?interp816_native_pla:interp816_native_plp;
+    return true;
+}
 uint64_t interp_bridge_native_control_site_count(uint32_t pc) {
     for (unsigned n=0;n<s_native_control_site_count;++n)
         if (s_native_control_sites[n].pc24==pc)return s_native_control_sites[n].completed;
