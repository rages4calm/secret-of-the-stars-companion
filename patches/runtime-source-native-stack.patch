+/* Original stack opcode bodies shared verbatim. No saved-P reconstruction,
+ * synthetic frame, return certificate or future history/owner grant. */
+static void interp816_arch_php(Interp816 *cpu) {
+      interp816_pushByte(cpu, interp816_getFlags(cpu));
+}
+static void interp816_arch_pha(Interp816 *cpu) {
+      if(cpu->mf) {
+        interp816_pushByte(cpu, (uint8_t)cpu->a);
+      } else {
+        cpu->cyclesUsed++; // m = 0: 1 extra cycle
+        interp816_pushWord(cpu, cpu->a);
+      }
+}
+static void interp816_arch_pla(Interp816 *cpu) {
+      if(cpu->mf) {
+        cpu->a = (cpu->a & 0xff00) | interp816_pullByte(cpu);
+      } else {
+        cpu->cyclesUsed++; // 16-bit m: 1 extra cycle
+        cpu->a = interp816_pullWord(cpu);
+      }
+      interp816_setZN(cpu, cpu->a, cpu->mf);
+}
+static void interp816_arch_plp(Interp816 *cpu) {
+      interp816_setFlags(cpu, interp816_pullByte(cpu));
+}
+int interp816_native_php(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x08)) return 0;
+  cpu->cyclesUsed = 3;
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_php(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x08);
+  return cpu->cyclesUsed;
+}
+int interp816_native_pha(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x48)) return 0;
+  cpu->cyclesUsed = 3;
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_pha(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x48);
+  return cpu->cyclesUsed;
+}
+int interp816_native_pla(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x68)) return 0;
+  cpu->cyclesUsed = 4;
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_pla(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x68);
+  return cpu->cyclesUsed;
+}
+int interp816_native_plp(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x28)) return 0;
+  cpu->cyclesUsed = 4;
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_plp(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x28);
   return cpu->cyclesUsed;
 }
 
