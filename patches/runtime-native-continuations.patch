+fn continuation_graph_safe(graph: &FunctionDecodeGraph, inputs: &Inputs, rom: &[u8]) -> bool {
+    let mapping = detect_rom_mapping(rom);
+    if graph.is_empty()
+        || graph.authority_conflict
+        || graph.unstable_exit_fact
+        || !graph.data_region_exec_pcs.is_empty()
+        || !graph.unknown_callee_exit_sites.is_empty()
+        || !graph.unresolved_indirects.is_empty()
+        || !graph.suppressed_indirect_calls.is_empty()
+        || !graph.dispatch_targets_suppressed.is_empty()
+        || has_truncated_call_continuation(graph)
+    {
+        return false;
+    }
+    graph.insns().iter().all(|di| {
+        let ins = &di.insn;
+        !matches!(
+            ins.mnem,
+            "BRK" | "COP" | "RTI" | "XCE" | "TCS" | "TXS" | "STP" | "WAI"
+        ) && !(ins.mnem == "PLP" && di.key.p_stack.is_empty())
+            && ins.dispatch_entries.is_none()
+            && !ins.dispatch_runtime
+            && !ins.terminal_jsr
+            && ins.dispatch_consumed_stack_bytes == 0
+            && (0..u32::from(ins.length)).all(|n| {
+                let pc = (ins.addr & 0xff0000) | ((ins.addr + n) & 0xffff);
+                target_is_code(
+                    VariantKey::new(pc, di.key.m, di.key.x),
+                    inputs,
+                    rom,
+                    mapping,
+                ) && !inputs
+                    .authority_data
+                    .get(&(pc >> 16))
+                    .is_some_and(|mask| mask[(pc & 0xffff) as usize])
+            })
+            && (matches!(ins.mnem, "RTS" | "RTL")
+                || !di.successors.is_empty()
+                || graph
+                    .boundary_exits
+                    .iter()
+                    .any(|(site, _)| *site == ins.addr))
+            && di.successors.iter().all(|s| {
+                graph.contains(s)
+                    || graph
+                        .boundary_exits
+                        .iter()
+                        .any(|(site, t)| *site == ins.addr && t == s)
+            })
+    })
+}
