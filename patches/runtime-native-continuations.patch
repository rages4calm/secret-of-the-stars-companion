+    /* Ambiguous certificates never use manifest iteration order as policy. */
+    if (lo + 1 < g_native_continuation_count &&
+        g_native_continuations[lo + 1].pc24 == e->pc24 &&
+        g_native_continuations[lo + 1].m == e->m &&
+        g_native_continuations[lo + 1].x == e->x) return 0;
