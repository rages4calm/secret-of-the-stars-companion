+#[derive(Clone)]
+struct BalancedFrame {
+    bytes: u8,
+    returns: BTreeSet<u32>,
+}
+
+struct ContinuationProof<'a> {
+    inputs: &'a Inputs,
+    rom: &'a [u8],
+    max_insns: usize,
+    nodes: &'a BTreeMap<VariantKey, NodeSummary>,
+    exact: &'a HashMap<(u32, u8, u8), (u8, u8)>,
+    sets: &'a HashMap<(u32, u8, u8), Vec<(u8, u8)>>,
+    helpers: &'a HashMap<u32, String>,
+    inline_args: &'a HashMap<u32, i32>,
+    graphs: HashMap<VariantKey, FunctionDecodeGraph>,
+    proven: HashMap<VariantKey, BalancedFrame>,
+    refused: HashSet<VariantKey>,
+    active: HashSet<VariantKey>,
+}
+
+impl ContinuationProof<'_> {
+    fn graph(&mut self, key: VariantKey) -> Option<FunctionDecodeGraph> {
+        if let Some(graph) = self.graphs.get(&key) {
+            return Some(graph.clone());
+        }
+        let node = self.nodes.get(&key)?;
+        if node.disposition != "aot_eligible"
+            || !node.reasons.is_empty()
+            || !self.exact.contains_key(&(key.pc24, key.m, key.x))
+        {
+            return None;
+        }
+        let graph = continuation_decode(
+            key,
+            key,
+            self.inputs,
+            self.rom,
+            self.max_insns,
+            self.exact,
+            self.sets,
+            self.helpers,
+            self.inline_args,
+        )?;
+        if !continuation_graph_safe(&graph, self.inputs, self.rom) {
+            return None;
+        }
+        self.graphs.insert(key, graph.clone());
+        Some(graph)
+    }
+
+    fn frame(&mut self, key: VariantKey) -> Option<BalancedFrame> {
+        if let Some(proof) = self.proven.get(&key) {
+            return Some(proof.clone());
+        }
+        if self.refused.contains(&key) || self.active.len() >= 256 || !self.active.insert(key) {
+            return None;
+        }
+        let result = self.frame_inner(key);
+        self.active.remove(&key);
+        if let Some(proof) = &result {
+            self.proven.insert(key, proof.clone());
+        } else {
+            self.refused.insert(key);
+        }
+        result
+    }
+
+    fn frame_inner(&mut self, key: VariantKey) -> Option<BalancedFrame> {
+        let graph = self.graph(key)?;
+        let summary = self.nodes.get(&key)?.clone();
+        self.balance_graph(&graph, &summary)
+    }
+
+    fn balance_graph(
+        &mut self,
+        graph: &FunctionDecodeGraph,
+        summary: &NodeSummary,
+    ) -> Option<BalancedFrame> {
+        let states = continuation_stack_states(graph)?;
+        let mut widths = BTreeSet::new();
+        let mut returns = BTreeSet::new();
+        for di in graph.insns() {
+            if matches!(di.insn.mnem, "RTS" | "RTL") {
+                if states.get(&di.key)? != &BTreeSet::from([0]) || !di.key.p_stack.is_empty() {
+                    return None;
+                }
+                widths.insert(if di.insn.mnem == "RTS" { 2 } else { 3 });
+                returns.insert(di.insn.addr);
+            }
+        }
+        for edge in &summary.demands {
+            if edge.resolution != "aot_exact" {
+                return None;
+            }
+            let target = edge.target?;
+            let proof = self.frame(target)?;
+            match edge.kind {
+                "direct_call" => {
+                    let call = graph.insns().iter().find(|di| {
+                        di.insn.addr == edge.site_pc24
+                            && di.key.m == target.m
+                            && di.key.x == target.x
+                    })?;
+                    let expected = if call.insn.mnem == "JSR" {
+                        2
+                    } else if call.insn.mnem == "JSL" {
+                        3
+                    } else {
+                        return None;
+                    };
+                    if proof.bytes != expected
+                        || self.inline_args.get(&target.pc24).is_some_and(|n| *n != 0)
+                    {
+                        return None;
+                    }
+                }
+                "direct_tail_call" => {
+                    let tail = graph
+                        .insns()
+                        .iter()
+                        .find(|di| di.insn.addr == edge.site_pc24)?;
+                    if states.get(&tail.key)? != &BTreeSet::from([0])
+                        || !tail.key.p_stack.is_empty()
+                    {
+                        return None;
+                    }
+                    widths.insert(proof.bytes);
+                    returns.extend(proof.returns);
+                }
+                _ => return None,
+            }
+        }
+        if widths.len() != 1 || returns.is_empty() {
+            return None;
+        }
+        Some(BalancedFrame {
+            bytes: *widths.first()?,
+            returns,
+        })
+    }
+}
+
+fn continuation_suffix_digest(graph: &FunctionDecodeGraph, rom: &[u8], inputs: &Inputs) -> String {
+    let mapping = detect_rom_mapping(rom);
+    let mut rows: Vec<_> = graph
+        .insns()
+        .iter()
+        .map(|di| {
+            let ins = &di.insn;
+            let bytes: String = (0..u32::from(ins.length))
+                .map(|n| {
+                    let pc = (ins.addr & 0xff0000) | ((ins.addr + n) & 0xffff);
+                    let off =
+                        addr_to_rom_offset(mapping, pc >> 16, pc & 0xffff, &inputs.reloc_regions);
+                    format!("{:02x}", rom[off])
+                })
+                .collect();
+            (di.key.pc, di.key.m, di.key.x, bytes)
+        })
+        .collect();
+    rows.sort();
+    sha256_hex(&serde_json::to_vec(&rows).unwrap())
+}
+
+fn certify_native_continuations(
+    inputs: &Inputs,
+    rom: &[u8],
+    max_insns: usize,
+    nodes: &BTreeMap<VariantKey, NodeSummary>,
+    exact: &HashMap<(u32, u8, u8), (u8, u8)>,
+    sets: &HashMap<(u32, u8, u8), Vec<(u8, u8)>>,
+    helpers: &HashMap<u32, String>,
+    inline_args: &HashMap<u32, i32>,
+) -> Vec<NativeContinuation> {
+    let mut proof = ContinuationProof {
+        inputs,
+        rom,
+        max_insns,
+        nodes,
+        exact,
+        sets,
+        helpers,
+        inline_args,
+        graphs: HashMap::new(),
+        proven: HashMap::new(),
+        refused: HashSet::new(),
+        active: HashSet::new(),
+    };
+    let rom_sha256 = sha256_hex(rom);
+    let mut candidates = BTreeMap::<VariantKey, Vec<NativeContinuation>>::new();
+    for (&owner, node) in nodes {
+        let Some(owner_frame) = proof.frame(owner) else {
+            continue;
+        };
+        let Some(owner_graph) = proof.graph(owner) else {
+            continue;
+        };
+        let Some(states) = continuation_stack_states(&owner_graph) else {
+            continue;
+        };
+        for edge in &node.demands {
+            if edge.kind != "direct_call" || edge.resolution != "aot_exact" {
+                continue;
+            }
+            let Some(callee) = edge.target else { continue };
+            let Some(callee_frame) = proof.frame(callee) else {
+                continue;
+            };
+            for call in owner_graph.insns().iter().filter(|di| {
+                di.insn.addr == edge.site_pc24 && di.key.m == callee.m && di.key.x == callee.x
+            }) {
+                // Only exact direct fallthroughs with the remaining owner frame
+                // already at the top of stack can use the first admission class.
+                if !call.key.p_stack.is_empty()
+                    || states.get(&call.key) != Some(&BTreeSet::from([0]))
+                    || call.successors.len() != 1
+                {
+                    continue;
+                }
+                let successor = &call.successors[0];
+                let Some(&(m, x)) = exact.get(&(callee.pc24, callee.m, callee.x)) else {
+                    continue;
+                };
+                let landing = (call.insn.addr & 0xff0000)
+                    | ((call.insn.addr + u32::from(call.insn.length)) & 0xffff);
+                if successor.pc != landing
+                    || (successor.m, successor.x) != (m, x)
+                    || !successor.p_stack.is_empty()
+                {
+                    continue;
+                }
+                let entry = VariantKey::new(landing, m, x);
+                if inputs.entries.contains_key(&entry.pc24) || nodes.contains_key(&entry) {
+                    continue;
+                }
+                let Some(suffix_graph) = continuation_decode(
+                    entry,
+                    owner,
+                    inputs,
+                    rom,
+                    max_insns,
+                    exact,
+                    sets,
+                    helpers,
+                    inline_args,
+                ) else {
+                    continue;
+                };
+                if !continuation_graph_safe(&suffix_graph, inputs, rom) {
+                    continue;
+                }
+                let suffix = summarize(
+                    entry,
+                    &suffix_graph,
+                    inputs,
+                    rom,
+                    detect_rom_mapping(rom),
+                    &HashSet::new(),
+                    false,
+                );
+                if suffix.disposition != "aot_eligible" || !suffix.reasons.is_empty() {
+                    continue;
+                }
+                let Some(suffix_frame) = proof.balance_graph(&suffix_graph, &suffix) else {
+                    continue;
+                };
+                if suffix_frame.bytes != owner_frame.bytes {
+                    continue;
+                }
+                candidates
+                    .entry(entry)
+                    .or_default()
+                    .push(NativeContinuation {
+                        entry,
+                        owner,
+                        callsite_pc24: call.insn.addr,
+                        callee,
+                        remaining_frame: owner_frame.bytes,
+                        call_frame: callee_frame.bytes,
+                        return_pcs: callee_frame.returns.iter().copied().collect(),
+                        suffix,
+                        suffix_sha256: continuation_suffix_digest(&suffix_graph, rom, inputs),
+                        rom_sha256: rom_sha256.clone(),
+                    });
+            }
+        }
+    }
+    // Runtime lookup is exact pc/m/x. Conflicting owner/callsite contracts at
+    // one landing are refused, rather than depending on iteration order.
