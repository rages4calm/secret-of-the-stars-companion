+typedef struct NativeContinuationInvocation {
+    CpuState *cpu;
+    NativeContinuationFrame frame;
+    int root_depth, snapshot_pending, published;
+    int host_frame;
+    uint64_t generation;
+    uint32 actual_pc;
+    uint16 actual_s;
+} NativeContinuationInvocation;
+enum { kNativeContinuationSlots = 16 };
+static NativeContinuationInvocation s_native_continuations[kNativeContinuationSlots];
+static unsigned s_native_continuation_depth;
+extern int snes_frame_counter;
+
+void cpu_continuation_reset(void) {
+    memset(s_native_continuations, 0, sizeof s_native_continuations);
+    s_native_continuation_depth = 0;
+}
+static NativeContinuationInvocation *continuation_current(void) {
+    if (!s_native_continuation_depth) return NULL;
+    NativeContinuationInvocation *c = &s_native_continuations[s_native_continuation_depth - 1];
+    /* Static bounded slots cannot dangle when WatchdogCheck longjmps out of
+     * an invocation. No unfinished context survives a host frame/restore. */
+    if (g_watchdog_tripped || c->host_frame != snes_frame_counter ||
+        c->generation != RtlStateGeneration()) {
+        cpu_continuation_reset();
+        return NULL;
+    }
+    return c;
+}
+
+int cpu_take_continuation_snapshot(CpuState *cpu, uint16 entry_s, uint8 hrv,
+                                   uint32 *out) {
+    NativeContinuationInvocation *c = continuation_current();
+    if (!c || !out || c->cpu != cpu || !c->snapshot_pending ||
+        g_recomp_stack_top != c->root_depth || entry_s != c->frame.entry_s ||
+        cpu->S != entry_s || hrv != c->frame.entry->remaining_frame) return 0;
+    c->snapshot_pending = 0;
+    *out = c->frame.outer_return_pc;
+    return 1;
+}
+int cpu_publish_continuation_return(CpuState *cpu, uint16 entry_s, uint16 pre_s,
+                                    uint32 pc, uint8 frame) {
+    NativeContinuationInvocation *c = continuation_current();
+    if (!c || c->cpu != cpu || c->snapshot_pending || c->published ||
+        g_recomp_stack_top != c->root_depth || entry_s != c->frame.entry_s ||
+        (frame != 2 && frame != 3) || pc > 0xffffffu ||
+        cpu->S != (uint16)(pre_s + frame)) return 0;
+    c->published = 1; c->actual_pc = pc; c->actual_s = cpu->S;
+    return 1;
+}
+NativeContinuationResult cpu_dispatch_continuation(
+    CpuState *cpu, const NativeContinuationFrame *f) {
+    NativeContinuationResult out = {NATIVE_CONT_REFUSED, 0, 0, RECOMP_RETURN_NORMAL};
+    uint8 raw[3] = {0};
+    (void)continuation_current(); /* clear an abandoned watchdog/host epoch */
+    if (!cpu || !f || !f->entry || continuation_disabled()) return out;
+    int table_member = 0;
+    for (unsigned i = 0; i < g_native_continuation_count; ++i)
+        if (f->entry == &g_native_continuations[i]) { table_member = 1; break; }
+    if (!table_member || !f->entry->fn || g_recomp_stack_top < 0 ||
+        g_recomp_stack_top == 0x7fffffff || g_watchdog_tripped ||
+        s_native_continuation_depth == kNativeContinuationSlots ||
+        (((uint32)cpu->PB << 16) | (uint16)f->entry->pc24) != f->entry->pc24 ||
+        cpu->S != f->entry_s || cpu->m_flag != f->entry->m ||
+        cpu->x_flag != f->entry->x || cpu->emulation || cpu_interrupt_context_active() ||
+        !continuation_stack_bytes(cpu, cpu->S, f->entry->remaining_frame, raw) ||
+        memcmp(raw, f->raw_remaining, f->entry->remaining_frame)) return out;
+    const unsigned slot = s_native_continuation_depth++;
+    NativeContinuationInvocation *c = &s_native_continuations[slot];
+    memset(c, 0, sizeof(*c));
+    c->cpu = cpu; c->frame = *f;
+    c->root_depth = g_recomp_stack_top + 1; c->snapshot_pending = 1;
+    c->host_frame = snes_frame_counter; c->generation = RtlStateGeneration();
+    const uint8 old_hrv = cpu->host_return_valid;
+    cpu->host_return_valid = f->entry->remaining_frame;
+    out.recomp_result = f->entry->fn(cpu);
+    cpu->host_return_valid = old_hrv;
+    out.actual_s = cpu->S;
+    if (s_native_continuation_depth != slot + 1 ||
+        c->host_frame != snes_frame_counter || c->generation != RtlStateGeneration()) {
+        out.disposition = NATIVE_CONT_CONTAINED_FAILURE;
+        cpu_continuation_reset();
+        return out;
+    }
+    if (c->published) {
+        out.disposition = NATIVE_CONT_COMPLETED;
+        out.actual_pc = c->actual_pc;
+        if (c->actual_s != cpu->S) out.disposition = NATIVE_CONT_CONTAINED_FAILURE;
+    } else if (out.recomp_result != RECOMP_RETURN_NORMAL) {
+        out.disposition = NATIVE_CONT_ORIGINAL_UNWIND;
+    } else {
