+         * permission to replay it. Preserve state and contain the failed run. */
+        out.disposition = NATIVE_CONT_CONTAINED_FAILURE;
+    }
+    memset(c, 0, sizeof(*c));
+    s_native_continuation_depth = slot;
+    return out;
+}
