+    memset(out, 0, sizeof(*out));
+    out->frame_bytes = opcode == 0x6b ? 3 : 2;
+    if (!continuation_stack_bytes(cpu, before_s, out->frame_bytes,
+                                   out->raw_return)) return 0;
