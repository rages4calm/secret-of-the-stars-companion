+/* Metadata probes must never call cpu_read8: no bus/latch/cart notification,
+ * guest clocks or devices are advanced by eligibility or prologue snapshots. */
+static int continuation_stack_bytes(CpuState *cpu, uint16 s, uint8 count,
+                                    uint8 *out) {
+    if (!cpu || !cpu->ram || count < 2 || count > 3 ||
+        s > 0x1fffu - count) return 0;
+    for (unsigned i = 0; i < count; ++i) out[i] = cpu->ram[s + 1u + i];
+    return 1;
+}
+static int continuation_rom_bytes(uint32 pc, unsigned count, uint8 *out) {
+    if (pc > 0xffffffu || !count || count > 4 ||
+        (pc & 0xffffu) < 0x8000u || (pc & 0xffffu) > 0x10000u - count ||
+        !g_snes || !g_snes->cart || !g_snes->cart->rom) return 0;
+    Cart *cart = g_snes->cart;
+    for (unsigned i = 0; i < count; ++i) {
+        const uint8 *p = cart_getRomPtr(cart, (uint8)(pc >> 16), (uint16)(pc + i));
+        const uintptr_t base = (uintptr_t)cart->rom, at = (uintptr_t)p;
+        if (!p || at < base || at - base >= cart->romSize) return 0;
+        out[i] = *p;
+    }
+    return 1;
+}
+static uint32 continuation_pop_pc(const uint8 *raw, uint8 count, uint8 bank) {
+    return ((uint32)(count == 3 ? raw[2] : bank) << 16) |
+        (uint16)((((uint16)raw[1] << 8) | raw[0]) + 1u);
+}
+static int continuation_direct_call(uint32 site, uint32 target, uint8 frame,
+                                     uint32 *fallthrough) {
+    uint8 b[4];
+    unsigned n = frame == 3 ? 4u : 3u;
+    if ((frame != 2 && frame != 3) || !continuation_rom_bytes(site, n, b) ||
+        b[0] != (frame == 3 ? 0x22 : 0x20)) return 0;
+    uint32 actual = ((uint32)(frame == 3 ? b[3] : (uint8)(site >> 16)) << 16) |
+        ((uint16)b[2] << 8) | b[1];
+    if (actual != target) return 0;
+    *fallthrough = (site & 0xff0000u) | (uint16)((site & 0xffffu) + n);
+    return 1;
