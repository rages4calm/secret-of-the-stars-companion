+fn continuation_decode(
+    key: VariantKey,
+    owner: VariantKey,
+    inputs: &Inputs,
+    rom: &[u8],
+    max_insns: usize,
+    exact: &HashMap<(u32, u8, u8), (u8, u8)>,
+    sets: &HashMap<(u32, u8, u8), Vec<(u8, u8)>>,
+    helpers: &HashMap<u32, String>,
+    inline_args: &HashMap<u32, i32>,
+) -> Option<FunctionDecodeGraph> {
+    let mapping = detect_rom_mapping(rom);
+    if !target_is_code(key, inputs, rom, mapping) {
+        return None;
+    }
+    let bank = key.pc24 >> 16;
+    let mirror = mirror_bank(mapping, bank);
+    let cfg = inputs
+        .cfg_index
+        .get(&bank)
+        .or_else(|| mirror.and_then(|m| inputs.cfg_index.get(&m)))
+        .map(|&i| &inputs.cfgs[i]);
+    let entry = inputs
+        .entries
+        .get(&owner.pc24)
+        .or_else(|| mirror_pc24(mapping, owner.pc24).and_then(|p| inputs.entries.get(&p)));
+    if entry.is_some_and(|e| e.entry_s_offset != 0) {
+        return None;
+    }
+    let mut siblings = inputs
+        .sibling_entries
+        .get(&bank)
+        .or_else(|| mirror.and_then(|m| inputs.sibling_entries.get(&m)))
+        .cloned()
+        .unwrap_or_default();
+    // The suffix does not become a new sibling of its owner or any other
+    // suffix. The original declared ownership boundaries remain authoritative.
+    siblings.remove(&(key.pc24 & 0xffff));
+    let env = DecodeEnv {
+        rom_mapping: mapping,
+        rom_image_size: Some(inputs.rom_image_size),
+        max_insns: Some(max_insns),
+        dispatch_helpers: Some(helpers),
+        indirect_dispatch: Some(&inputs.indirect_dispatch),
+        hle_dispatch: Some(&inputs.hle_dispatch),
+        authority_bytes: Some(&inputs.authority_bytes),
+        authority_data: Some(&inputs.authority_data),
+        data_regions: Some(&inputs.data_regions),
+        callee_exit_mx: Some(exact),
+        callee_exit_mx_modes: Some(sets),
+        sibling_entry_pcs: Some(&siblings),
+        hle_entry_pcs: inputs
+            .hle_entries
+            .get(&bank)
+            .or_else(|| mirror.and_then(|m| inputs.hle_entries.get(&m))),
+        callee_inline_skip: Some(inline_args),
+        inline_dispatch_loop_pcs: cfg.map(|c| &c.inline_dispatch_loops),
+        terminal_jsr_sites: Some(&inputs.terminal_jsr_sites),
+        global_inline_skip: Some(inline_args),
+        stop_on_unknown_callee_exit: true,
+        reloc_regions: Some(&inputs.reloc_regions),
+        ..Default::default()
+    };
+    catch_unwind(AssertUnwindSafe(|| {
+        decode_function(
+            rom,
+            bank,
+            key.pc24 & 0xffff,
+            key.m,
+            key.x,
+            entry.and_then(|e| e.end),
+            &env,
+        )
+    }))
+    .ok()
+}
