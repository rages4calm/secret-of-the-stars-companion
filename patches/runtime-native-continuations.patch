+/// Exact local stack heights at every instruction. Direct calls are net zero
+/// only after their callees have independently proved a balanced return.
+fn continuation_stack_states(
+    graph: &FunctionDecodeGraph,
+) -> Option<HashMap<DecodeKey, BTreeSet<i32>>> {
+    let entry = graph.entry.as_ref()?.clone();
+    let mut states = HashMap::from([(entry.clone(), BTreeSet::from([0]))]);
+    let mut pending = vec![entry];
+    while let Some(key) = pending.pop() {
+        let di = graph.get(&key)?;
+        let ins = &di.insn;
+        let delta = match ins.mnem {
+            "PEA" | "PEI" | "PER" | "PHD" => 2,
+            "PHP" | "PHB" | "PHK" => 1,
+            "PHA" => {
+                if ins.m_flag == 1 {
+                    1
+                } else {
+                    2
+                }
+            }
+            "PHX" | "PHY" => {
+                if ins.x_flag == 1 {
+                    1
+                } else {
+                    2
+                }
+            }
+            "PLD" => -2,
+            "PLP" | "PLB" => -1,
+            "PLA" => {
+                if ins.m_flag == 1 {
+                    -1
+                } else {
+                    -2
+                }
+            }
+            "PLX" | "PLY" => {
+                if ins.x_flag == 1 {
+                    -1
+                } else {
+                    -2
+                }
+            }
+            "TCS" | "TXS" => return None,
+            _ => 0,
+        };
+        let next: BTreeSet<_> = states.get(&key)?.iter().map(|v| v + delta).collect();
+        if next.iter().any(|v| !(0..=64).contains(v)) {
+            return None;
+        }
+        for successor in &di.successors {
+            if !graph.contains(successor) {
+                continue;
+            }
+            let old = states.entry(successor.clone()).or_default();
+            let before = old.len();
+            old.extend(&next);
+            if before != old.len() {
+                pending.push(successor.clone());
+            }
+        }
+    }
+    Some(states)
+}
