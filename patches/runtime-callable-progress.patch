diff --git a/runner/src/snes/bridge_callable_progress120.inc b/runner/src/snes/bridge_callable_progress120.inc
new file mode 100644
--- /dev/null
+++ b/runner/src/snes/bridge_callable_progress120.inc
@@ -0,0 +1,71 @@
+/* Callable-only, synchronous original-core progress boundary.
+ * Timing ownership only: never grants native instruction/return admission. */
+typedef struct BridgeCallableProgress {
+    CpuState *cpu;
+    uint64_t *write_epoch, *dynamic_epoch;
+    long *steps;
+    const SnesProgramModule *module;
+    uint64_t owner_serial, state_generation, lifecycle, hook_generation;
+    int depth, frame, owner_scheduler, apu_driving;
+    uint16_t owner_exit_s;
+} BridgeCallableProgress;
+static BridgeCallableProgress s_callable_progress;
+static const SnesProgramModule *callable_progress_module(void) {
+    const SnesProgramModule *m=snes_program_module_active();
+    return m ? m : &g_program_module;
+}
+static bool callable_progress_current(const BridgeCallableProgress *p) {
+    return p->cpu && p->write_epoch && p->dynamic_epoch && p->steps &&
+        s_interp_owner_exit_valid && p->depth==s_interp_bridge_depth &&
+        p->owner_serial==s_task_owner_serial && p->owner_exit_s==s_interp_owner_exit_s &&
+        p->owner_scheduler==s_interp_owner_is_scheduler &&
+        p->frame==snes_frame_counter && p->lifecycle==s_scheduler_hook_lifecycle &&
+        p->hook_generation==s_pre_opcode_hook_generation &&
+        p->state_generation==RtlStateGeneration() && p->module==callable_progress_module();
+}
+/* Borrow the actual original-core flag only for this faithful committed
+ * instruction. The enclosing legacy callable/HLE retains its own flag. */
+static int callable_progress_driving_begin(CpuState *cpu) {
+    const int previous=g_interp_apu_driving;
+    if(s_callable_progress.cpu==cpu && callable_progress_current(&s_callable_progress))
+        g_interp_apu_driving=s_callable_progress.apu_driving;
+    return previous;
+}
+static void callable_progress_driving_end(int previous) {
+    g_interp_apu_driving=previous;
+}
+static BridgeCallableProgress callable_progress_quarantine(void) {
+    BridgeCallableProgress previous=s_callable_progress;
+    s_callable_progress=(BridgeCallableProgress){0};
+    return previous;
+}
+static void callable_progress_restore(BridgeCallableProgress previous) {
+    s_callable_progress=callable_progress_current(&previous)
+        ? previous : (BridgeCallableProgress){0};
+}
+static BridgeCallableProgress callable_progress_enter(CpuState *cpu, bool auto_quiescent,
+        uint64_t *write_epoch, uint64_t *dynamic_epoch, long *steps, int apu_driving) {
+    BridgeCallableProgress previous=callable_progress_quarantine();
+    if(auto_quiescent && cpu && write_epoch && dynamic_epoch && steps &&
+       s_interp_owner_exit_valid && s_task_owner_serial && s_interp_bridge_depth>0) {
+        s_callable_progress=(BridgeCallableProgress){
+            .cpu=cpu,.write_epoch=write_epoch,.dynamic_epoch=dynamic_epoch,.steps=steps,
+            .module=callable_progress_module(),.owner_serial=s_task_owner_serial,
+            .state_generation=RtlStateGeneration(),.lifecycle=s_scheduler_hook_lifecycle,
+            .hook_generation=s_pre_opcode_hook_generation,.depth=s_interp_bridge_depth,
+            .frame=snes_frame_counter,.owner_scheduler=s_interp_owner_is_scheduler,
+            .owner_exit_s=s_interp_owner_exit_s,.apu_driving=apu_driving};
+    }
+    return previous;
+}
+static void callable_progress_committed(CpuState *cpu) {
+    if(!s_callable_progress.cpu || s_callable_progress.cpu!=cpu)return;
+    if(!callable_progress_current(&s_callable_progress)) {
+        s_callable_progress=(BridgeCallableProgress){0};return;
+    }
+    /* Quarantine through the existing flush's callbacks. Its actual epoch
+     * pointers and step counter remain those of the live original core. */
+    BridgeCallableProgress current=callable_progress_quarantine();
+    bridge_progress_checkpoint(cpu,true,current.write_epoch,current.dynamic_epoch,current.steps);
+    callable_progress_restore(current);
+}
