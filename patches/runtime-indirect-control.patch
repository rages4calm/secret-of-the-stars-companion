diff --git a/recompiler/v2/native_indirect_control.py b/recompiler/v2/native_indirect_control.py
new file mode 100644
--- /dev/null
+++ b/recompiler/v2/native_indirect_control.py
@@ -0,0 +1,47 @@
+"""Original architectural indirect transfers, never host callee/dispatch roots."""
+from snes65816 import INDIR,INDIR_X,decode_insn,rom_offset
+from snes_cycles import instr_cpu_cycles
+from .ir import IndirectGoto,Call
+from .lowering import lower
+
+FORMS={0x6c:('JMP',INDIR),0x7c:('JMP',INDIR_X),0xdc:('JMP',INDIR),0xfc:('JSR',INDIR_X)}
+
+def collect_indirect_control(rom,key,insn,ops,cycles,*,data_regions=(),exclude_ranges=(),forced=()):
+    # A source CFG instruction boundary supplies modes; never an observed PC.
+    if key.m not in(0,1)or key.x not in(0,1)or insn.data_region_exec:return None
+    if getattr(insn,'const_z_fold_unconditional',False):return None
+    if insn.opcode not in FORMS or(insn.mnem,insn.mode)!=FORMS[insn.opcode]or insn.length!=3:return None
+    pc=insn.addr&0xffffff
+    if key.pc&65535!=pc&65535 or pc&65535<0x8000 or pc&65535>0xfffd or pc>>16 in(0x7e,0x7f):return None
+    if(getattr(insn,'m_flag',None),getattr(insn,'x_flag',None))!=(key.m,key.x):return None
+    for n in range(3):
+        at=pc+n
+        if at&0x7fffff in forced or any(at>>16 in(b,b^128)and lo<=at&65535<hi for b,lo,hi in data_regions)or any(lo<=at&65535<hi for lo,hi in exclude_ranges):return None
+    off=rom_offset(pc>>16,pc&65535)
+    if off<0 or off+3>len(rom):return None
+    decoded=decode_insn(rom,off,pc&65535,pc>>16,key.m,key.x)
+    if decoded is None or(decoded.opcode,decoded.mnem,decoded.mode,decoded.operand,decoded.length)!=(insn.opcode,insn.mnem,insn.mode,insn.operand,insn.length):return None
+    decoded.m_flag,decoded.x_flag=key.m,key.x
+    canonical=lower(decoded,value_factory=lambda:None)
+    if len(ops)!=1 or ops!=canonical:return None
+    if insn.opcode==0xfc:
+        call=ops[0]
+        if not isinstance(call,Call)or not call.indirect or call.long or call.terminal or call.noreturn or call.target is not None or call.source_pc24!=pc or(call.entry_m,call.entry_x)!=(key.m,key.x):return None
+    elif not isinstance(ops[0],IndirectGoto):return None
+    if cycles!=instr_cpu_cycles(insn.opcode,m=key.m,x=key.x,e=0):return None
+    # Original interp816: opcode operand fetch precedes pointer transactions;
+    # FC completes PB-relative pointer reads before the high/low byte pushes.
+    indexed=insn.opcode in(0x7c,0xfc)
+    bank='cpu->PB'if indexed else'0x00'
+    body='{ uint16 _indirect_operand=cpu_aot_get_indirect_control_operand(cpu,(((uint32)cpu->PB<<16)|0x%04xu),0x%02xu);\n'%(pc&65535,insn.opcode)
+    body+='uint16 _indirect_address=(uint16)(_indirect_operand'+(' + cpu->X'if indexed else'')+');\n'
+    body+='uint16 _indirect_target=cpu_aot_read16(cpu,'+bank+',_indirect_address);\n'
+    if insn.opcode==0xdc:
+        body+='uint8 _indirect_bank=cpu_aot_read8(cpu,0x00,(uint16)(_indirect_address+2u));\ncpu->PB=_indirect_bank;\n'
+    if insn.opcode==0xfc:
+        # This instruction has no host return tag/callee invocation/permit.
+        ret=(pc+2)&65535
+        body+='cpu_aot_write8(cpu,0x00,cpu->S,0x%02xu); cpu->S=(uint16)(cpu->S-1);\n'%(ret>>8)
+        body+='cpu_aot_write8(cpu,0x00,cpu->S,0x%02xu); cpu->S=(uint16)(cpu->S-1);\n'%(ret&255)
+    body+='*next_pc=((uint32)cpu->PB<<16)|_indirect_target; }'
+    return {'pc24':pc&0x7fffff,'m':key.m,'x':key.x,'length':3,'cycles':cycles,'bytes':rom[off:off+3].hex(),'next_pc':(pc+3)&65535,'body':body,'mnemonic':insn.mnem,'contract':'source-indirect-control-architectural-v1','original_scheduler_call':insn.opcode==0xfc,'frame_bytes':2 if insn.opcode==0xfc else 0,'dynamic_target':True}
