+}
+
+uint16 cpu_aot_get_indirect_control_operand(CpuState *cpu,uint32 pc24,uint8 opcode) {
+  aot_require(cpu);
+  /* Pointer reads belong to the instruction body; this copies only the
+   * already fetched operand word without bus work, clocks or authority. */
+  if(s_aot_pc!=pc24 || s_aot_length!=3u || s_aot_fetched[0]!=opcode ||
+     (opcode!=0x6cu && opcode!=0x7cu && opcode!=0xdcu && opcode!=0xfcu) ||
+     (((uint32)cpu->PB<<16)|(pc24&0xffffu))!=pc24) {
+    fputs("Invalid cached indirect control operands\n",stderr);abort();
+  }
+  return ((uint16)s_aot_fetched[2]<<8)|s_aot_fetched[1];
 }
 
 uint8 cpu_aot_read8(CpuState *cpu,uint8 b,uint16 a){aot_require(cpu);return bridge_bus_read(cpu,((uint32)b<<16)|a);}
