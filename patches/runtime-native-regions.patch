diff --git a/recompiler/v2/native_regions.py b/recompiler/v2/native_regions.py
new file mode 100644
--- /dev/null
+++ b/recompiler/v2/native_regions.py
@@ -0,0 +1,51 @@
+"""Source-derived scheduler-owned leaf instructions; never callable roots."""
+import re
+from snes65816 import ABS, rom_offset
+from .ir import CondBranch
+from .codegen import emit_op, _reg
+
+READS={'LDA','LDX','LDY','BIT','CMP','CPX','CPY'}
+BRANCHES={'BCC','BCS','BEQ','BNE','BMI','BPL','BVC','BVS'}
+
+def collect(rom,key,insn,ops,cycles):
+    if key.m not in (0,1) or key.x not in (0,1) or insn.data_region_exec:
+        return None
+    if not (insn.mnem in READS and insn.mode==ABS or insn.mnem in BRANCHES):
+        return None
+    if insn.mnem in BRANCHES and (len(ops)!=1 or not isinstance(ops[0],CondBranch)):
+        return None
+    pc=insn.addr&0xffffff
+    if pc&0xffff<0x8000 or pc>>16 in (0x7e,0x7f):return None
+    body=[];next_pc=(pc+insn.length)&0xffff
+    for op in ops:
+        if isinstance(op,CondBranch):
+            body.append(f'if ({_reg(op.flag)} == {int(op.take_if)}) {{ *next_pc = {insn.operand&0xffff}u; cpu_aot_extra(cpu,1); }}')
+        else:
+            lines=emit_op(op,pc)
+            if any('unsupported' in line or 'return' in line for line in lines):return None
+            body.extend(lines)
+    code='\n'.join(body).replace('cpu_read16_linear(', 'cpu_aot_read16_linear(').replace('cpu_read16(', 'cpu_aot_read16(').replace('cpu_read8(', 'cpu_aot_read8(')
+    names={}
+    def local(match):
+        return names.setdefault(match[0],f'_region_v{len(names)}')
+    code=re.sub(r'_(?:v\d+|tc\d+_\d+)\b',local,code)
+    offset=rom_offset(pc>>16,pc&0xffff)
+    return {'pc24':pc&0x7fffff,'m':key.m,'x':key.x,'length':insn.length,'cycles':cycles,'bytes':rom[offset:offset+insn.length].hex(),'next_pc':next_pc,'body':code,'mnemonic':insn.mnem}
+
+def emit(rows,module_prefix=None):
+    header='#include "cpu_state.h"\n#include "program_module.h"\n#include <stdlib.h>\n'
+    if module_prefix:header+='#include "module_namespace.h"\n'
+    out=[header,'extern SnesProgramModule g_program_module;', 'bool cpu_native_region_step(CpuState *cpu,uint32 pc24,uint8 mx,uint16 *next_pc) {',
+         '  static int enabled=-1; if(enabled<0) {const char *e=getenv("SNESRECOMP_DISABLE_NATIVE_REGIONS");enabled=!(e&&e[0]&&e[0]!=\'0\');}',
+         '  const SnesProgramModule *active=snes_program_module_active();',
+         '  if(!enabled || !cpu || !next_pc || cpu->emulation || cpu->m_flag>1 || cpu->x_flag>1 || mx!=((cpu->m_flag<<1)|cpu->x_flag) || (active && active!=&g_program_module)) return false;',
+         '  if ((((uint32)cpu->PB<<16)|(pc24&0xffff)) != pc24) return false;',
+         '  switch (((pc24&0x7fffffu)<<2)|mx) {']
+    for row in sorted(rows,key=lambda r:(r['pc24'],r['m'],r['x'])):
+        case=(row['pc24']<<2)|(row['m']<<1)|row['x']
+        out.extend([f'    case {case}u: {{ /* {row["pc24"]:06x} M{row["m"]}X{row["x"]} {row["mnemonic"]}; ROM {row["bytes"]} */',
+                    f'      if(!cpu_aot_begin(cpu,pc24,{row["length"]}u,{row["cycles"]}u)) return false;',
+                    f'      *next_pc={row["next_pc"]}u;',row['body'],'      cpu_aot_commit(cpu); return true; }'])
+    out.extend(['    default: return false;','  }','}',''])
+    return '\n'.join(out)
+
