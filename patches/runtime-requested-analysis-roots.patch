+def load_analysis_roots(paths: Iterable[pathlib.Path]) -> tuple[VariantKey, ...]:
+    """Read explicit analysis seeds without declaring guest function boundaries.
+
+    These owner-reviewed PC/mode addresses are not runtime coverage and carry
+    no instruction bytes, timings, call outcomes or qualification claims.
+    They still pass through the ordinary ROM analyzer and LLE eligibility.
+    """
+    roots = set()
+    for path in paths:
+        path = pathlib.Path(path)
+        for line_number, raw in enumerate(path.read_text(encoding="utf-8-sig").splitlines(), 1):
+            token = raw.partition("#")[0].strip()
+            if not token:
+                continue
+            match = re.fullmatch(r"([0-9a-fA-F]{1,6}):M([01])X([01])", token, re.IGNORECASE)
+            if not match:
+                raise ValueError(f"{path}:{line_number}: expected PC24:M0X0 analysis root, got {token!r}")
+            pc24, m, x = match.groups()
+            roots.add(VariantKey(int(pc24, 16), int(m), int(x)))
     return tuple(sorted(roots))
 
 
