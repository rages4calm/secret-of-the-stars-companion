+/* Host supplies completed guest periods / elapsed walltime, never requested
+ * target alone. The consumer slews between measurements without losing phase. */
+void RtlAudioSetFastForwardCadence(double speed) {
+  if (!isfinite(speed)) speed=1.0;
+  if (speed<0.1) speed=0.1;
+  if (speed>2.0) speed=2.0;
+  RtlApuLock();
+  g_audio_ff_target=g_audio_fast_forward ? speed : 1.0;
+  RtlApuUnlock();
+}
+static double rtl_audio_tempo_step(double current,double target,int frames,double rate) {
+  double change=16.0*(double)frames/rate;
+  if (current<target) return fmin(target,current+change);
+  return fmax(target,current-change);
 }
 
