+/* Turbo remains one original guest frame per execution, with bounded host
+ * scheduling and independently timed latest-frame presentation. */
+typedef struct HostTurboCadence { double start,periods; } HostTurboCadence;
+static unsigned g_audio_timeline_epoch;
+static void HostTurboCadenceReset(HostTurboCadence *c,double now) {
+  *c=(HostTurboCadence){now,0};
+}
+static double HostTurboCadenceCompleted(HostTurboCadence *c,double now,double periods,double hz) {
+  c->periods+=periods;
+  double elapsed=now-c->start;
+  if(elapsed<0.05)return 0;
+  double speed=c->periods/(elapsed*hz);
+  HostTurboCadenceReset(c,now);
+  return fmax(0.1,fmin(2.0,speed));
+}
+static void HostTurboSimulationDone(SnesHostClock *c,double now,double periods) {
+  /* No repayment burst, and no extra sleep after a host that cannot meet2x.
+   * Ordinary slow-frame debt policy is intentionally unchanged. */
+  double deadline=c->next_simulation+periods/c->simulation_hz;
+  snes_host_clock_simulation_done(c,now,false,periods);
+  c->next_simulation=fmax(now,deadline);
+}
