+    return {'pc24':pc&0x7fffff,'m':key.m,'x':key.x,'length':4,'cycles':cycles,'bytes':rom[off:off+4].hex(),'next_pc':target,'body':body,'mnemonic':insn.mnem,'contract':'source-long-jump-architectural-prefix-v1'}
+
 
