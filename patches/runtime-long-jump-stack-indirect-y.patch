+        if at&0x7fffff in forced or any(at>>16 in(b,b^128)and lo<=at&65535<hi for b,lo,hi in data_regions)or any(lo<=at&65535<hi for lo,hi in exclude_ranges):return None
+    off=rom_offset(pc>>16,pc&65535)
