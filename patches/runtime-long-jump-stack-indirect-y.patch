+    if decoded is None or(decoded.opcode,decoded.mnem,decoded.mode,decoded.operand,decoded.length)!=(insn.opcode,insn.mnem,insn.mode,insn.operand,insn.length):return None
+    if(getattr(insn,'m_flag',None),getattr(insn,'x_flag',None))!=(key.m,key.x):return None
+    decoded.m_flag,decoded.x_flag=key.m,key.x
+    if len(ops)!=1 or ops!=lower(decoded,value_factory=lambda:None)or not isinstance(ops[0],Goto):return None
+    if cycles!=instr_cpu_cycles(decoded.opcode,m=key.m,x=key.x,e=0)or faithful_lines is None:return None
+    if any(t in '\n'.join(faithful_lines)for t in('cpu_aot_prefix','precise-mode unsupported:')):return None
+    target=decoded.operand&0xffffff
+    if target&65535<0x8000 or target>>16 in(0x7e,0x7f)or target&0x7fffff in forced:return None
