+/* Original item-effect compare CPU body shared verbatim. */
+static void interp816_arch_cmp_ily(Interp816 *cpu) {
+      uint32_t low = 0;
+      uint32_t high = interp816_adrIly(cpu, &low);
+      interp816_cmp(cpu, low, high);
+}
+int interp816_native_cmp_ily(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0xd7)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0xd7];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_cmp_ily(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0xd7);
   return cpu->cyclesUsed;
 }
 
