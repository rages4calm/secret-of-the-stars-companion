   interp_bridge_source_call_interp_exit(cpu, source, 0xce);
+  return cpu->cyclesUsed;
+}
+
+/* Original menu/condition CPU bodies shared verbatim. */
+static void interp816_arch_and_dp(Interp816 *cpu) {
+      uint32_t low = 0;
+      uint32_t high = interp816_adrDp(cpu, &low);
+      interp816_and(cpu, low, high);
+}
+int interp816_native_and_dp(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x25)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0x25];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_and_dp(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x25);
+  return cpu->cyclesUsed;
+}
+static void interp816_arch_dec_dp(Interp816 *cpu) {
+      uint32_t low = 0;
+      uint32_t high = interp816_adrDp(cpu, &low);
+      interp816_dec(cpu, low, high);
+}
+int interp816_native_dec_dp(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0xc6)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0xc6];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_dec_dp(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0xc6);
   return cpu->cyclesUsed;
 }
 
