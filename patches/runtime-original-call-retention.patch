+    p->depth!=s_task_original_invocation_count+1u||
+    !task_original_registers(&v,&s_task_original_exec.expected)||!task_original_environment(c,&v)){
+  task_original_runtime_reset();return;
+ }
+ TaskOriginalInvocation *f=&s_task_original_invocations[s_task_original_invocation_count++];
+ *f=(TaskOriginalInvocation){.fp=fp,.epoch=task_original_current_epoch(c),
