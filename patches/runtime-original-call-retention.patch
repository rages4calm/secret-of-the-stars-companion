+static uint32 task_original_native_next(const TaskOriginalExecution *x,const CpuState *c){
+ /* Calls consume the actual fetched-and-written push receipt. The top call
+  * intentionally has no callee graph row until its original push commits. */
+ if(x->opcode==0x20u||x->opcode==0x22u){
+  const TaskOriginalCall *p=&s_task_original_call;
+  if(!x->prepared||!x->inflight||!p->inflight||p->depth>=2u||
+     p->write_live||p->write_done!=p->write_count)return 0;
+  const TaskOriginalGuestFrame *f=&p->frame[p->depth];
+  if(f->site!=x->source||f->frame!=(x->opcode==0x22u?3u:2u)||
+     p->write_count!=f->frame)return 0;
+  return f->target;
+ }
+ const TaskOriginalInstruction *r=x->row;if(!r)return 0;
+ int taken=0;switch(x->opcode){
+ case 0x10: taken=!c->_flag_N;break;case 0x30:taken=c->_flag_N;break;
+ case 0x50: taken=!c->_flag_V;break;case 0x70:taken=c->_flag_V;break;
+ case 0x90: taken=!c->_flag_C;break;case 0xb0:taken=c->_flag_C;break;
+ case 0xd0: taken=!c->_flag_Z;break;case 0xf0:taken=c->_flag_Z;break;
+ case 0x80:case 0x82:case 0x4c:case 0x5c:taken=1;break;
+ default:break;
+ }
+ if(taken&&r->branch)return r->branch;
+ return r->target?r->target:r->fall;
