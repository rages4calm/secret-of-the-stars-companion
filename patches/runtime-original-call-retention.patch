+static int task_original_prepare(CpuState *c,const TaskResumeState *v,uint32 source){
+ if(!task_original_runtime_allowed()||!s_task_original_call.phase)return 0;
+ TaskOriginalExecution *x=&s_task_original_exec;TaskOriginalCall *p=&s_task_original_call;
+ if(p->phase!=TASK_ORIGINAL_RUNNING||x->prepared||x->inflight||
+    !task_original_environment(c,v)||!task_original_registers(v,&x->expected)||source!=v->pc){task_original_runtime_reset();return 0;}
+ unsigned mx=((v->p>>5)&1u)*2u+((v->p>>4)&1u);uint8 opcode;
+ x->row=NULL;
