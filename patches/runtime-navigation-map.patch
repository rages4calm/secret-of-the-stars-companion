+    if (!has_gamepad_command[kKeys_Map] &&
+        !GamepadMapHasExact(kGamepadBtn_L3, 1u << kGamepadBtn_Back))
+      GamepadMap_Add(kGamepadBtn_L3, 1u << kGamepadBtn_Back, kKeys_Map);
   }
   s_parsing_gamepad_binding = false;
