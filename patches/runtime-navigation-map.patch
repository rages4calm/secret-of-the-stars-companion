     /* An enabled legacy system gesture owns its complete chord, so R3 does
      * not also queue a HUD toggle while Select+R3 opens rewind. Explicitly
      * disabling that gesture leaves the chord available to the title map. */
@@ -4752,6 +4752,19 @@
   }
   if (pressed)
     gi->last_cmd[button] = FindCmdForGamepadButton(button + gi->index * kGamepadBtn_Count, gi->modifiers);
+  /* A completed map chord owns its currently held gameplay modifiers.
+   * Clear their host pad bits before the next guest frame; plain Select
+   * remains unchanged when no map chord is pressed. */
+  if (pressed && gi->last_cmd[button] == kKeys_Map) {
+    for (int b = 0; b < kGamepadBtn_Count; ++b) {
