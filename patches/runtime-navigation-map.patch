+/* Title defaults must not replace an explicit binding of the same chord.
+ * A plain L3 journal binding may coexist with the more specific Back+L3. */
+static bool GamepadMapHasExact(int button, uint32 modifiers) {
+  for (int e = joymap_first[button]; e; e = joymap_ents[e - 1].next)
+    if (joymap_ents[e - 1].modifiers == modifiers) return true;
+  return false;
 }
 
