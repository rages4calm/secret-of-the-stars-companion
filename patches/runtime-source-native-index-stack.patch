   uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
   interp816_arch_plp(cpu);
   interp_bridge_source_call_interp_exit(cpu, source, 0x28);
+  return cpu->cyclesUsed;
+}
+
+/* Original index-stack bodies sharedVERBATIM; no pre-hook stack redirect. */
+static void interp816_arch_phy(Interp816 *cpu) {
+      if(cpu->xf) {
+        interp816_pushByte(cpu, (uint8_t)cpu->y);
+      } else {
+        cpu->cyclesUsed++; // m = 0: 1 extra cycle
+        interp816_pushWord(cpu, cpu->y);
+      }
+}
+static void interp816_arch_ply(Interp816 *cpu) {
+      if(cpu->xf) {
+        cpu->y = interp816_pullByte(cpu);
+      } else {
+        cpu->cyclesUsed++; // 16-bit x: 1 extra cycle
+        cpu->y = interp816_pullWord(cpu);
+      }
+      interp816_setZN(cpu, cpu->y, cpu->xf);
+}
+int interp816_native_phy(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x5a)) return 0;
+  cpu->cyclesUsed = 3;
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_phy(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x5a);
+  return cpu->cyclesUsed;
+}
+int interp816_native_ply(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x7a)) return 0;
+  cpu->cyclesUsed = 4;
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_ply(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x7a);
   return cpu->cyclesUsed;
 }
 
