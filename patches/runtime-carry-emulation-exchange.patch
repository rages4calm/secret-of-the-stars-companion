diff --git a/recompiler/v2/native_exchange.py b/recompiler/v2/native_exchange.py
new file mode 100644
--- /dev/null
+++ b/recompiler/v2/native_exchange.py
@@ -0,0 +1,27 @@
+"""Source-owned E0 XCE; original scheduler owns the dynamic E/M/X successor."""
+from snes65816 import IMP, decode_insn, rom_offset
+from snes_cycles import instr_cpu_cycles
+from .ir import XCE
+from .lowering import lower
+
+
+def collect_exchange(rom,key,insn,ops,cycles,*,data_regions=(),exclude_ranges=(),forced=()):
+    if key.m not in (0,1) or key.x not in (0,1) or insn.data_region_exec:return None
+    if getattr(insn,'const_z_fold_unconditional',False) or getattr(insn,'dispatch_entries',None):return None
+    if (insn.mnem,insn.opcode,insn.mode,insn.length)!=('XCE',0xfb,IMP,1):return None
+    pc=insn.addr&0xffffff
+    if key.pc&65535!=pc&65535 or pc&65535<0x8000 or pc>>16 in (0x7e,0x7f):return None
+    if (getattr(insn,'m_flag',None),getattr(insn,'x_flag',None))!=(key.m,key.x):return None
+    if pc&0x7fffff in forced or any(pc>>16 in (b,b^128) and lo<=pc&65535<hi for b,lo,hi in data_regions) or any(lo<=pc&65535<hi for lo,hi in exclude_ranges):return None
+    off=rom_offset(pc>>16,pc&65535)
+    if off<0 or off>=len(rom):return None
+    decoded=decode_insn(rom,off,pc&65535,pc>>16,key.m,key.x)
+    if decoded is None or (decoded.opcode,decoded.mnem,decoded.mode,decoded.operand,decoded.length)!=(insn.opcode,insn.mnem,insn.mode,insn.operand,insn.length):return None
+    decoded.m_flag,decoded.x_flag=key.m,key.x
+    if len(ops)!=1 or not isinstance(ops[0],XCE) or ops!=lower(decoded,value_factory=lambda:None):return None
+    if cycles!=instr_cpu_cycles(insn.opcode,m=key.m,x=key.x,e=0):return None
+    # Original opcodeFB swaps live C/E, then setFlags(getFlags()) normalizes
+    # the status and index/stack state. Neither static exit modes nor the
+    # callable emitter's shorter XCE body can substitute for this operation.
+    body='{ uint8 _xce_e=cpu->emulation; cpu->emulation=cpu->_flag_C?1:0; cpu->_flag_C=_xce_e?1:0;\nif(cpu->emulation){cpu->m_flag=1;cpu->x_flag=1;cpu->S=(uint16)((cpu->S&0x00ffu)|0x0100u); }\nif(cpu->x_flag){cpu->X&=0x00ffu;cpu->Y&=0x00ffu;}\ncpu_mirrors_to_p(cpu);cpu_p_to_mirrors(cpu);\n*next_pc=((uint32)cpu->PB<<16)|0x%04xu; }'%((pc+1)&65535)
+    return {'pc24':pc&0x7fffff,'m':key.m,'x':key.x,'length':1,'cycles':cycles,'bytes':rom[off:off+1].hex(),'next_pc':(pc+1)&65535,'body':body,'mnemonic':'XCE','contract':'source-native-e0-carry-emulation-exchange-v1','dynamic_emulation_mode':True,'original_scheduler_mode_successor':True}
