+static void interp816_arch_rol_a(Interp816 *cpu) {
+      int result = (cpu->a << 1) | cpu->c;
+      if(cpu->mf) {
+        cpu->c = result & 0x100;
+        cpu->a = (cpu->a & 0xff00) | (result & 0xff);
+      } else {
+        cpu->c = result & 0x10000;
+        cpu->a = result;
+      }
+      interp816_setZN(cpu, cpu->a, cpu->mf);
+}
