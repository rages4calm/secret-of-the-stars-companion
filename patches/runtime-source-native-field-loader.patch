+static void interp816_arch_asl_dp(Interp816 *cpu) {
+      uint32_t low = 0;
+      uint32_t high = interp816_adrDp(cpu, &low);
+      interp816_asl(cpu, low, high);
+}
+int interp816_native_asl_dp(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x06)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0x06];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_asl_dp(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x06);
+  return cpu->cyclesUsed;
+}
