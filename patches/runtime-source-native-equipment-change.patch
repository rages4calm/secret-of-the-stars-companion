+  interp816_arch_adc_dp(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x65);
+  return cpu->cyclesUsed;
+}
+static void interp816_arch_ora_dp(Interp816 *cpu) {
+      uint32_t low = 0;
