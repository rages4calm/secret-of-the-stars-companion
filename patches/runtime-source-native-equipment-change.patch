+static void interp816_arch_brl(Interp816 *cpu) {
+      uint16_t offset = interp816_readOpcodeWord(cpu);
+      cpu->pc += (int16_t) offset;
+}
+int interp816_native_brl(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x82)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0x82];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_brl(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x82);
+  return cpu->cyclesUsed;
+}
+static void interp816_arch_adc_ily(Interp816 *cpu) {
+      uint32_t low = 0;
+      uint32_t high = interp816_adrIly(cpu, &low);
+      interp816_adc(cpu, low, high);
+}
+int interp816_native_adc_ily(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x77)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0x77];
