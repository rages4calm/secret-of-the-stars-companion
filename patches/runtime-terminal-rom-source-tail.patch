+"""One source-issued architectural terminal tail; no target/owner/exit authority."""
+import hashlib,weakref
+from .architecture_emission_policy import _digest,_graph_digest
+from snes65816 import rom_offset
+_RECORDS=weakref.WeakKeyDictionary()
+_USED=weakref.WeakSet()
+_REFUSALS=weakref.WeakKeyDictionary()
+CONTRACT='source-ROM-word-terminal-stack-tail-v1'
+
+def _scope_context(rom,parsed,stream,scope):
+    from .architecture_rom_stack_dispatch_sources import _TargetPolicy,_TARGETS,_ISSUER,_ProducerCertificate,_ISSUED
+    from .decoder import FunctionDecodeGraph
+    if type(scope)is not _TargetPolicy or scope not in _TARGETS or scope._issuer is not _ISSUER or not scope._used or scope._rom is not rom or scope._parsed is not parsed or scope._stream is not stream or scope._graph is None:
+        raise ValueError('fresh actual original target child required')
+    cert=scope._certificate
+    if type(cert)is not _ProducerCertificate or cert not in _ISSUED or not cert._sealed or not cert._used or scope._start not in cert._targets or stream._parsed is not parsed or stream._rom_object is not rom or not stream._sealed:
+        raise ValueError('original ROM-word target protocol required')
+    expected_role={'sibling_entry_pcs':cert._role.get('sibling_entry_pcs'),'source_instruction_only':False,'entry_range_end':None}
+    if _digest(scope._role)!=_digest(expected_role):raise ValueError('original target child role changed')
+    graph=scope._graph
+    if type(graph)is not FunctionDecodeGraph or cert._children.get(id(graph),(None,))[0]is not graph:raise ValueError('foreign original graph identity')
+    if (graph.entry.pc,graph.entry.m,graph.entry.x)!=(scope._start,0,1):raise ValueError('target entry identity changed')
+    for field in('exclude_ranges','hle_func','hle_spc_upload','hle_dispatch','forced'):
+        if _digest(scope._options.get(field))!=_digest(cert._parent._options.get(field)):raise ValueError('target policy weakened')
+    if any(v not in(scope._options.get('data_regions')or())for v in(cert._parent._options.get('data_regions')or()))or _digest(scope._role.get('sibling_entry_pcs'))!=_digest(cert._role.get('sibling_entry_pcs')):raise ValueError('target masks/sibling role weakened')
+    if _digest(scope._options)!=scope._options_sha or _digest(scope._role)!=scope._role_sha:raise ValueError('original child options/role changed')
+    return cert,graph
+
+def _validate(rom,parsed,stream,scope):
+    cert,graph=_scope_context(rom,parsed,stream,scope)
+    cert.validate(rom,parsed,stream)
+    if cert._children.get(id(graph))!=(graph,_graph_digest(rom,graph)):raise ValueError('original issued target child changed')
+    return cert,graph
+
+def _role_ok(cert,pc,m,x,length):
+    # Mathematical ROM read-domain is not an exclusive declared data mask.
+    # Keep every original occupied-byte and target-interior role guard.
+    from .architecture_rom_stack_dispatch_sources import _mapped
+    if not _mapped(cert._rom,pc,length):return False
+    occupied=set(range(pc,pc+length))
+    for (start,km,kx),lengths in cert._roles_snapshot.items():
+        for oldlen in lengths:
+            if not occupied.intersection(range(start,start+oldlen)):continue
+            if start!=pc or (km,kx)==(m,x)and oldlen!=length:return False
+    if any(pc<other<pc+length for other in cert._targets):return False
+    return True
+
+def _shape(rom,graph):
+    start=graph.entry
+    if (start.m,start.x)!=(0,1) or len(graph.insns)!=4 or graph.authority_conflict or graph.data_region_exec_pcs or graph.unresolved_indirects or graph.unknown_callee_exit_sites:return None
+    current=start;keys=[]
+    expected=((0xe2,'SEP',0x20,2,0,1),(0x68,'PLA',0,1,1,1),(0x68,'PLA',0,1,1,1),(0x60,'RTS',0,1,1,1))
+    for n,(opcode,mnem,operand,length,m,x)in enumerate(expected):
+        di=graph.insns.get(current)
+        if di is None:return None
+        ins=di.insn;off=rom_offset(current.pc>>16,current.pc&65535)
+        if (current.m,current.x,ins.addr,ins.opcode,ins.mnem,ins.operand,ins.length)!=(m,x,current.pc,opcode,mnem,operand,length):return None
+        if ins.data_region_exec or getattr(ins,'const_z_fold_unconditional',False)or any(getattr(ins,f,None)for f in('dispatch_entries','dispatch_runtime','dispatch_consumed_stack_bytes','terminal_jsr','noreturn_jsr')):return None
+        if off<0 or off+length>len(rom)or rom[off:off+length]!=(bytes((opcode,operand))if length==2 else bytes((opcode,))):return None
+        keys.append(current)
+        if n==3:
+            if di.successors:return None
+        else:
+            if len(di.successors)!=1:return None
+            nxt=next(iter(di.successors))
+            if nxt.pc!=current.pc+length or (nxt.m,nxt.x)!=(1,1)or any(k!=current and nxt in v.successors for k,v in graph.insns.items()):return None
+            current=nxt
+    if set(keys)!=set(graph.insns):return None
+    return tuple(keys)
+
+def _record_original_tail(producer,stream,scope,rom,parsed,local_rows):
+    from .architecture_rom_stack_dispatch_sources import _TAIL_PRODUCER
+    from .architecture_eligibility import _mask,_independent
+    from .architecture_return_steps import SOURCE_RETURN_CONTRACT,validate_return
+    if producer is not _TAIL_PRODUCER or stream in _USED:raise ValueError('original target completion issuer required')
+    cert,graph=_scope_context(rom,parsed,stream,scope)
+    keys=_shape(rom,graph)
+    if keys is None:return # rejection only: no certificate/body/authority issued
+    cert,graph=_validate(rom,parsed,stream,scope)
+    if _shape(rom,graph)!=keys:raise ValueError('terminal shape changed during full proof')
+    # Dedicated dual-read/code subset only. Other old pure targets are untouched.
+    if not any(set(range(k.pc,k.pc+graph.insns[k].insn.length)).intersection(range(cert._base,cert._base+256))for k in keys):return
+    if scope._start&65535 in(scope._role.get('sibling_entry_pcs')or()):raise ValueError('original sibling entry role refused')
+    rows={}
+    for row in local_rows:
+        k=tuple(row[f]for f in('pc24','m','x'))
+        if k in rows:raise ValueError('ambiguous original terminal collector')
+        rows[k]=row
+    missing=[];output=[]
+    for k in keys:
+        ins=graph.insns[k].insn
+        if _mask(parsed,k.pc,ins.length)or not _role_ok(cert,k.pc,k.m,k.x,ins.length):raise ValueError('terminal source byte role or mask refused')
+        row=rows.get((k.pc,k.m,k.x))
+        if row is None:missing.append([k.pc,k.m,k.x]);continue
+        row=dict(row)
+        if row['mnemonic']!=ins.mnem or row['length']!=ins.length:raise ValueError('terminal collector source shape differs')
+        if ins.mnem=='RTS':
+            row['source_return_contract']=SOURCE_RETURN_CONTRACT
+            if not validate_return(rom,parsed,row):raise ValueError('original architectural return collector refused')
+        if not _independent(rom,parsed,row):raise ValueError('original terminal canonical body refused')
+        output.append(row)
+    if missing:
+        _REFUSALS.setdefault(stream,[]).append({'target':scope._start,'source_graph_sha256':_graph_digest(rom,graph),'reason':'original faithful collector unavailable; interpreter fallback retained','missing_keys':missing})
+        return # no partial tail or source return marker is issued
+    records=_RECORDS.setdefault(stream,[])
+    if any(r['scope']is scope or r['start']==scope._start for r in records):raise ValueError('terminal target issued twice')
+    record={'scope':scope,'certificate':cert,'start':scope._start,'graph':graph,'graph_sha':_graph_digest(rom,graph),'keys':tuple((k.pc,k.m,k.x)for k in keys),'rows':tuple(output),'row_sha':_digest(output),'options_sha':scope._options_sha,'role_sha':scope._role_sha}
+    record['seal']=_digest((record['start'],record['graph_sha'],record['keys'],record['rows'],record['options_sha'],record['role_sha']))
+    records.append(record)
+
+def scope_context(scope):return _digest(scope._options),_digest(scope._role)
+
+def derive(rom,parsed,stream):
+    from .architecture_eligibility import _mask,_independent
+    if stream in _USED or not stream._sealed or stream._parsed is not parsed or stream._rom_object is not rom:raise ValueError('sealed one-use original terminal stream required')
+    _USED.add(stream) # consume before validation/refusal/decoder callbacks
+    records=_RECORDS.pop(stream,[]);refused=_REFUSALS.pop(stream,[]);rows={};origins=[]
+    for r in records:
+        cert,graph=_validate(rom,parsed,stream,r['scope'])
+        if cert is not r['certificate']or scope_context(r['scope'])!=(r['options_sha'],r['role_sha'])or graph is not r['graph']or _graph_digest(rom,graph)!=r['graph_sha']or _digest(list(r['rows']))!=r['row_sha']or _digest((r['start'],r['graph_sha'],r['keys'],r['rows'],r['options_sha'],r['role_sha']))!=r['seal']:raise ValueError('terminal graph/body/context seal changed')
+        if _shape(rom,graph)!=tuple(sorted(graph.insns,key=lambda k:k.pc)):raise ValueError('terminal typed source changed')
+        for row in r['rows']:
+            k=tuple(row[f]for f in('pc24','m','x'))
+            if _mask(parsed,k[0],row['length'])or not _role_ok(cert,*k,row['length'])or not _independent(rom,parsed,row):raise ValueError('terminal consume mask/body/role refused')
+            if k in rows and rows[k]!=row:raise ValueError('unequal terminal canonical row')
+            rows[k]=dict(row)
+        origins.append({'target':r['start'],'entry_m':0,'entry_x':1,'source_graph_sha256':r['graph_sha'],'instruction_keys':[list(k)for k in r['keys']],'producer_keys':[[k.pc,k.m,k.x]for k in cert._keys],'ROM_read_base':cert._base,'mathematical_read_count':len(cert._reads),'intentional_table_extent_claimed':False})
+    return [rows[k]for k in sorted(rows)],{'contract':CONTRACT,'origins':origins,'refused':refused,'ordinary_roots_added':False,'callee_exit_modes_added':False,'caller_owner_added':False,'saved_history_exported':False,'read_domain_is_declared_data':False,'old_pure_family_changed':False,'shape':'typed SEP20/PLA/PLA/RTS only','source_bound_changes':False,'E0_runtime_guard_unchanged':True}
