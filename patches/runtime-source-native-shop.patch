@@ -2736,6 +2736,47 @@
   uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
   interp816_arch_eor_abs(cpu);
   interp_bridge_source_call_interp_exit(cpu, source, 0x4d);
+  return cpu->cyclesUsed;
+}
+
+/* Original shop CPU case shared verbatim. */
+static void interp816_arch_rol_abs(Interp816 *cpu) {
+      uint32_t low = 0;
+      uint32_t high = interp816_adrAbs(cpu, &low);
+      interp816_rol(cpu, low, high);
+}
+int interp816_native_rol_abs(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x2e)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0x2e];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_rol_abs(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x2e);
+  return cpu->cyclesUsed;
+}
+static void interp816_arch_sbc_absx(Interp816 *cpu) {
+      uint32_t low = 0;
+      uint32_t high = interp816_adrAbx(cpu, &low, false);
+      interp816_sbc(cpu, low, high);
+}
+int interp816_native_sbc_absx(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0xfd)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0xfd];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_sbc_absx(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0xfd);
+  return cpu->cyclesUsed;
+}
+static void interp816_arch_adc_absx(Interp816 *cpu) {
+      uint32_t low = 0;
+      uint32_t high = interp816_adrAbx(cpu, &low, false);
+      interp816_adc(cpu, low, high);
+}
+int interp816_native_adc_absx(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x7d)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0x7d];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_adc_absx(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x7d);
   return cpu->cyclesUsed;
 }
 
