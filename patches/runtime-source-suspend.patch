+ const TaskSlotLifetime *,uint32_t,uint32_t,unsigned,uint64_t,uint16_t);
+int task_slot_save_committed(TaskSuspendLineage *,const TaskResumeState *);
+int task_slot_suspend_call_committed(TaskSuspendLineage *,const TaskResumeState *);
