+  raw=list(bytes.fromhex(r['bytes']));raw +=[0]*(4-len(raw))
+  code+=' {'+','.join(str(r[k])+'u'for k in ('pc','fall','branch','target','m','x','next_m','next_x','length'))+',{'+','.join(str(v)+'u'for v in raw)+'}},\n'
