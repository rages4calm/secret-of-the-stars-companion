+int task_slot_call_prepare(TaskSuspendLineage *,const TaskResumeSnapshot *,
+ const TaskResumeState *,const TaskSlotLifetime *,uint32_t,uint32_t,unsigned,uint64_t);
+void task_slot_observe_write(TaskSuspendLineage *,uint32_t,uint64_t,uint32_t,uint8_t);
+int task_slot_call_committed(TaskSuspendLineage *,const TaskResumeState *);
