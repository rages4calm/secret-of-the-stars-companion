+ code+='default:return false;}}\nbool cpu_source_suspend_task_member(uint32 pc,uint8 mx){switch((pc<<2)|mx){\n'
+ for pc,m,x in family['task_members']:code+=f'case {(pc<<2)|(m<<1)|x}u:return true;\n'
+ code+='default:return false;}}\n#include "task_original_call_contract.h"\n'
+ code+='static const TaskOriginalInstruction s_native_suspend_rows[]={\n'
