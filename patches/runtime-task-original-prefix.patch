+ if(!context||mx>3u||!task_original_runtime_allowed()||!s_task_original_call.phase)return false;
+ TaskOriginalCall *p=&s_task_original_call;TaskOriginalExecution *x=&s_task_original_exec;
+ TaskResumeState v=task_cpu_view(c,source);
+ if(p->phase!=TASK_ORIGINAL_RUNNING||!p->depth||p->depth>2u||p->inflight||p->return_pending||
+    !x->prepared||x->inflight||x->source!=source||!x->row||s_task_original_pop.valid||
+    !task_original_environment(c,&v)||!task_original_registers(&v,&x->before)||
+    mx!=(((v.p>>5)&1u)*2u+((v.p>>4)&1u)))return false;
+ unsigned graph=x->graph[p->depth-1u];
+ const TaskOriginalInstruction *row=cpu_source_task_original_row(graph,source,mx);
+ if(!row||row!=x->row||row->bytes[0]==0x20u||row->bytes[0]==0x22u||row->bytes[0]==0x60u||row->bytes[0]==0x6bu||
+    !cpu_source_task_original_row_matches(row,task_peek,c))return false;
+ *context=graph;return true;
