+
+
+def derive(rom,parsed):
+    cfgs=[cfg for bank,path,cfg in parsed if bank==0 and cfg.bank==0 and cfg.auto_vectors]
+    if len(cfgs)!=1:raise ValueError('bootstrap requires exactly one declared bank00 auto_vectors owner')
+    cfg=cfgs[0];vo=rom_offset(0,0xfffc)
+    if vo<0 or vo+2>len(rom):raise ValueError('bootstrap reset vector is not materialized')
+    vector=rom[vo:vo+2];entry=int.from_bytes(vector,'little')
+    declared=[r for r in cfg.entries if r.start==entry and r.entry_m==1 and r.entry_x==1]
+    if len(declared)!=1 or entry<0x8000 or entry>0xfffb:raise ValueError('bootstrap reset vector requires its existing source-declared M1X1 entry')
+    masks=[r for bank,path,c in parsed for r in c.data_regions]+[(bank,lo,hi)for bank,path,c in parsed for lo,hi in c.authority_data]
+    forced={r&0x7fffff for bank,path,c in parsed for r in c.force_lle}
+    rows=[];pc=entry
+    for mnemonic,opcode,mode,length in [('SEI',0x78,IMP,1),('REP',0xc2,IMM,2),('XCE',0xfb,IMP,1)]:
+        off=rom_offset(0,pc)
+        if off<0 or off+length>len(rom):raise ValueError('bootstrap instruction is not materialized')
+        i=decode_insn(rom,off,pc,0,1,1)
+        if i is None or(i.mnem,i.opcode,i.mode,i.length)!=(mnemonic,opcode,mode,length):raise ValueError('bootstrap original instruction sequence differs')
+        i.m_flag=i.x_flag=1;ops=lower(i,value_factory=lambda:None)
+        expected=[SetFlag(Reg.I,1)]if mnemonic=='SEI'else[RepFlags(9)]if mnemonic=='REP'else[XCE()]
+        if ops!=expected or mnemonic=='REP'and i.operand!=9:raise ValueError('bootstrap independent typed operation differs')
+        for at in range(pc,pc+length):
+            if at in forced or any(0 in(b,b^128)and lo<=at<hi for b,lo,hi in masks)or any(lo<=at<hi for lo,hi in cfg.exclude_ranges):raise ValueError('bootstrap original byte is masked')
+        raw=rom[off:off+length].hex();body=''
+        if mnemonic=='SEI':body='cpu->_flag_I=1;cpu_mirrors_to_p(cpu);'
+        elif mnemonic=='REP':body='cpu_mirrors_to_p(cpu);cpu->P&=(uint8)~9u;cpu_p_to_mirrors(cpu);cpu->m_flag=1;cpu->x_flag=1;cpu->S=(uint16)((cpu->S&0x00ffu)|0x0100u);cpu->X&=0x00ffu;cpu->Y&=0x00ffu;cpu_mirrors_to_p(cpu);'
+        else:body='uint8 _bootstrap_e=cpu->emulation;cpu->emulation=cpu->_flag_C?1:0;cpu->_flag_C=_bootstrap_e?1:0;if(cpu->emulation){cpu->m_flag=1;cpu->x_flag=1;cpu->S=(uint16)((cpu->S&0x00ffu)|0x0100u);}if(cpu->x_flag){cpu->X&=0x00ffu;cpu->Y&=0x00ffu;}cpu_mirrors_to_p(cpu);cpu_p_to_mirrors(cpu);'
+        body+='*next_pc=((uint32)cpu->PB<<16)|0x%04xu;'%(pc+length)
+        rows.append({'pc24':pc,'e':1,'m':1,'x':1,'bytes':raw,'length':length,'cycles':instr_cpu_cycles(opcode,m=1,x=1,e=1),'mnemonic':mnemonic,'body':body,'contract':'source-reset-e1-bootstrap-step-v1'})
+        pc+=length
+    recipe={'entry':entry,'source_declared_name':declared[0].name,'vector_pc':0xfffc,'vector_bytes':vector.hex(),'prefix_pc':entry,'prefix_bytes':''.join(r['bytes']for r in rows),'successor':pc,'rows':rows,'source_contract':'declared-reset-vector-three-step-e1-bootstrap-v1','exit_e':'dynamic_live_C_after_source_REP09','ordinary_roots_added':False}
+    return recipe
+
+
+def emit_bootstrap(recipe):
+    rows=recipe['rows'];out=['#include "snes/snes.h"','#include "snes/cart.h"','extern Snes *g_snes;','extern SnesProgramModule g_program_module;','bool cpu_native_region_step(CpuState*,uint32,uint8,uint32*);','bool cpu_source_reset_bootstrap_match(CpuState *cpu,uint32 pc,unsigned length,unsigned cycles,const uint8 *expected){',' if(!cpu||!expected||cpu->emulation!=1||cpu->m_flag!=1||cpu->x_flag!=1||cpu->PB!=0||!g_snes||!g_snes->cart)return false;',' const SnesProgramModule *active=snes_program_module_active();if(active&&active!=&g_program_module)return false;',' switch(pc){']
+    for r in rows:
+        arr=','.join(str(b)+'u'for b in bytes.fromhex(r['bytes']))
+        out.append(' case %su:{const uint8 bytes[]={%s};if(length!=%su||cycles!=%su)return false;for(unsigned n=0;n<length;n++)if(expected[n]!=bytes[n])return false;break;}'%(r['pc24'],arr,r['length'],r['cycles']))
+    out+=[' default:return false;}']
+    for pc,data in [(recipe['vector_pc'],recipe['vector_bytes']),(recipe['prefix_pc'],recipe['prefix_bytes'])]:
+        arr=','.join(str(b)+'u'for b in bytes.fromhex(data));out.append(' {const uint8 bytes[]={%s};for(unsigned n=0;n<sizeof bytes;n++){const uint8*p=cart_getRomPtr(g_snes->cart,0,(uint16)(%su+n));if(!p||*p!=bytes[n])return false;}}'%(arr,pc))
+    out+=[' return true;}','static bool cpu_source_reset_bootstrap_step(CpuState *cpu,uint32 pc,uint8 mx,uint32 *next_pc){',' if(mx!=3u)return false;switch(pc){']
+    for r in rows:
+        arr=','.join(str(b)+'u'for b in bytes.fromhex(r['bytes']))
+        out.append(' case %su:{const uint8 expected[]={%s};if(!cpu_source_reset_bootstrap_match(cpu,pc,%su,%su,expected)||!cpu_aot_begin_scheduler_region(cpu,pc,%su,%su,expected,cpu_native_region_step))return false;%s cpu_aot_commit(cpu);return true;}'%(r['pc24'],arr,r['length'],r['cycles'],r['length'],r['cycles'],r['body']))
+    out+=[' default:return false;}}','']
+    return '\n'.join(out)
