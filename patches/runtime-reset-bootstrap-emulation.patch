+"""Three source-declared reset E1 steps; no ordinary emulation admission."""
+from snes65816 import rom_offset,decode_insn,IMP,IMM
+from snes_cycles import instr_cpu_cycles
+from .ir import SetFlag,Reg,RepFlags,XCE
