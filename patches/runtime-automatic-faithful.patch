+def _cached_address(seg, read=False):
+    # A pointer is a bus transaction, never a repeatable C expression. Native
+    # mode pointer bytes wrap within bank zero; effective data addresses carry
+    # across banks. Explicit statements prescribe low/high/bank read ordering.
+    k = seg.kind
+    idx = 'cpu->X' if seg.index == Reg.X else 'cpu->Y' if seg.index == Reg.Y else '0'
+    lines = []
+    if k in (SegKind.DP_INDIRECT, SegKind.DP_INDIRECT_LONG, SegKind.DP_INDIRECT_X, SegKind.STACK_REL_INDIRECT_Y):
+        base = 'cpu->S' if k == SegKind.STACK_REL_INDIRECT_Y else 'cpu->D'
+        ptr_idx = ' + cpu->X' if k == SegKind.DP_INDIRECT_X else ''
+        lines += [f'uint16 _ea_p = (uint16)({base} + {seg.offset:#06x}{ptr_idx});',
+                  'uint16 _ea_lo = cpu_read16(cpu, 0x00, _ea_p);']
+        if k == SegKind.DP_INDIRECT_LONG:
+            lines += ['uint8 _ea_hi = cpu_read8(cpu, 0x00, (uint16)(_ea_p + 2u));',
+                      f'uint32 _ea = ((((uint32)_ea_hi << 16) | _ea_lo) + {idx}) & 0xffffffu;']
+        else:
+            # (dp,X) indexes the pointer, not the resolved data address.
+            data_idx = 'cpu->Y' if k == SegKind.STACK_REL_INDIRECT_Y else idx if k == SegKind.DP_INDIRECT else '0'
+            if read and k == SegKind.DP_INDIRECT and seg.index == Reg.Y:
+                # CPU x=0 penalty is already folded in the shared static table.
+                lines += ['if (cpu->x_flag && ((_ea_lo >> 8) != (((uint32)_ea_lo + cpu->Y) >> 8))) cpu_aot_extra(cpu, 1u);']
+            lines += [f'uint32 _ea = (((uint32)cpu->DB << 16) + _ea_lo + {data_idx}) & 0xffffffu;']
+    elif k == SegKind.DIRECT:
+        lines += [f'uint32 _ea = (uint16)(cpu->D + {seg.offset:#06x} + {idx});']
+    elif k == SegKind.STACK:
+        lines += [f'uint32 _ea = (uint16)(cpu->S + {seg.offset:#06x});']
+    elif k == SegKind.ABS_BANK:
+        lines += [f'uint32 _ea = (((uint32)cpu->DB << 16) + {seg.offset:#06x} + {idx}) & 0xffffffu;']
+    elif k == SegKind.LONG:
+        lines += [f'uint32 _ea = ({(((seg.bank or 0) << 16) | seg.offset):#08x}u + {idx}) & 0xffffffu;']
+    else:
+        raise ValueError(f'unsupported cached data address {k}')
+    return lines, '(uint8)(_ea >> 16)', '(uint16)_ea'
