+}
+
+/* Original indexed zero-store CPU body shared verbatim. */
+static void interp816_arch_stz_abx(Interp816 *cpu) {
+      uint32_t low = 0;
+      uint32_t high = interp816_adrAbx(cpu, &low, true);
+      interp816_stz(cpu, low, high);
+}
+int interp816_native_stz_abx(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x9e)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0x9e];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_stz_abx(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x9e);
   return cpu->cyclesUsed;
 }
 
