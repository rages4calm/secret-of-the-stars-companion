+        if pc not in covered or pc in barriers or pc in siblings or pc in hle:return False
+        if any(((pc&0xff0000)|((pc+n)&65535))not in covered for n in range(ins.length)):return False
+        for n in range(ins.length):
+            at=(pc&0xff0000)|((pc+n)&65535)
+            if at&0x7fffff in forced or any(at>>16 in(b,b^128)and lo<=at&65535<hi for b,lo,hi in data)or any(lo<=at&65535<hi for lo,hi in exclude):return False
+        return True
+    def successors(ins,key):
+        unknown=[]
+        normal=_labeled_successors(ins,key,bank,callee_exit_mx=arguments.get('callee_exit_mx'),callee_exit_mx_modes=arguments.get('callee_exit_mx_modes'),rom=rom,inline_arg_map=inline,stop_on_unknown_callee_exit=True,unknown_callee_exit_sites=unknown)
+        dynamic=ins.mnem=='PLP'
