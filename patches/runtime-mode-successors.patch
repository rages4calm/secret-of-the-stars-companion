+                native_mode_successors=False,_native_instruction_members=frozenset({key.pc}),
+                source_task_resume_stops=None,suppressed_collector=None,const_z_fold_collector=None,
+                dispatch_target_suppressed_collector=None,unresolved_indirect_collector=None)
