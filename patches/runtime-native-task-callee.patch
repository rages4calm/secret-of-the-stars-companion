diff --git a/runner/src/snes/bridge_task_call.inc b/runner/src/snes/bridge_task_call.inc
new file mode 100644
--- /dev/null
+++ b/runner/src/snes/bridge_task_call.inc
@@ -0,0 +1,105 @@
+/* One source-selected call, inside the SAME original scheduler owner only. */
+__attribute__((weak)) int cpu_source_task_call_sources_match(TaskResumePeek peek,void *ctx){(void)peek;(void)ctx;return 0;}
+__attribute__((weak)) int cpu_source_task_call_row(uint32 pc,uint8 mx,unsigned *len,uint32 *fall,uint32 *branch,uint8 *op){
+ (void)pc;(void)mx;(void)len;(void)fall;(void)branch;(void)op;return 0;
+}
+typedef struct {
+ TaskResumeSnapshot task;
+ TaskResumeState before,expected;
+ uint16 entry_s;
+ uint32 source,fall,branch;
+ uint64 hooks;
+ unsigned phase,depth,length,inflight;
+ uint8 opcode;
+} SourceTaskCall;
+static SourceTaskCall s_task_call;
+static void task_call_reset(void){memset(&s_task_call,0,sizeof(s_task_call));}
+static int task_call_epoch(const TaskResumeState *v) {
+ const TaskResumeState *e=&s_task_call.before;
+ return v->cpu==e->cpu&&v->module==e->module&&v->owner&&v->owner==e->owner&&
+  v->owner_epoch==e->owner_epoch&&v->generation==e->generation&&v->frame==e->frame&&
+  !v->e&&s_task_call.depth==(unsigned)s_interp_bridge_depth&&s_task_call.hooks==s_pre_opcode_hook_generation;
+}
+static int task_call_registers(const TaskResumeState *a,const TaskResumeState *b){
+ return a->pc==b->pc&&a->s==b->s&&a->a==b->a&&a->x==b->x&&a->y==b->y&&a->d==b->d&&a->db==b->db&&a->p==b->p&&a->e==b->e;
+}
+static int task_call_frame(CpuState *c,unsigned count){
+ TaskResumeSnapshot *a=&s_task_call.task;uint8 b,lo,hi;
+ for(unsigned n=0;n<count;n++)if(!task_peek(c,a->saved_s+1+n,&b)||b!=a->bytes[n])return 0;
+ if(!task_peek(c,a->recipe->current_index,&lo)||!task_peek(c,a->recipe->current_index+1,&hi)||
+    (uint16)(lo|((uint16)hi<<8))!=a->index||!task_peek(c,a->recipe->status_base+a->index,&b)||b!=1||
+    !task_peek(c,a->recipe->saved_s_base+a->index,&lo)||!task_peek(c,a->recipe->saved_s_base+a->index+1,&hi)||
+    (uint16)(lo|((uint16)hi<<8))!=a->saved_s)return 0;
+ return 1;
+}
+static int task_call_environment(CpuState *c,const TaskResumeState *v,unsigned count){
+ return task_call_epoch(v)&&task_call_frame(c,count)&&cpu_source_task_call_sources_match(task_peek,c)&&
+  !g_watchdog_tripped&&!s_pre_opcode_callback_cpu&&
+  !(g_snes&&g_snes->inIrq&&!(v->p&CPU_P_I))&&!interp_bridge_lle_master_deadline_reached(c);
+}
+/* Called only immediately before the real original JSR, after old gates. */
+static void task_call_arm(CpuState *c,const TaskResumeState *v,uint32 source){
+ if(s_task_call.phase||source!=0x01d80fu||!s_task_active.published)return;
+ SourceTaskCall candidate={0};candidate.task=s_task_active;candidate.before=candidate.expected=*v;
+ candidate.entry_s=v->s;candidate.hooks=s_pre_opcode_hook_generation;candidate.depth=(unsigned)s_interp_bridge_depth;
+ candidate.phase=1;s_task_call=candidate;
+ if(v->s!=candidate.task.saved_s+11u||v->pc!=source||v->module!=(uintptr_t)&g_program_module||
+    (v->p&CPU_P_M)==0||!task_call_registers(v,&candidate.task.actual)||!task_call_environment(c,v,11))task_call_reset();
+}
+static void task_call_pre_view(CpuState *c,const TaskResumeState *v,uint32 source){
+ if(!s_task_call.phase){task_call_arm(c,v,source);return;}
+ if(s_task_call.phase!=2){task_call_reset();return;}
+ SourceTaskCall *p=&s_task_call;
+ unsigned length;uint32 fall,branch;uint8 opcode,mx=(uint8)(((v->p>>5)&1)*2+((v->p>>4)&1));
+ if(p->inflight||!task_call_environment(c,v,11)||!task_call_registers(v,&p->expected)||
+    !cpu_source_task_call_row(source,mx,&length,&fall,&branch,&opcode)||v->s!=(uint16)(p->entry_s-2u)||
+    v->d!=p->before.d||v->db!=p->before.db||v->y!=p->before.y||source!=v->pc){task_call_reset();return;}
+ p->source=source;p->length=length;p->fall=fall;p->branch=branch;p->opcode=opcode;p->inflight=1;
+}
+static void task_call_pre_local(CpuState *c,const Interp816 *in,uint32 source){
+ TaskResumeState v=task_local_view(c,in,source);task_call_pre_view(c,&v,source);
+}
+static void task_call_pre_cpu(CpuState *c,uint32 source){
+ if(!s_task_call.phase)return;TaskResumeState v=task_cpu_view(c,source);task_call_pre_view(c,&v,source);
+}
+static void task_call_commit_view(CpuState *c,uint32 source,const TaskResumeState *v){
+ SourceTaskCall *p=&s_task_call;if(!p->phase)return;
+ if(p->phase==1){
+  uint8 low,high;
+  /* The real JSR owns precisely these two writes in the consumed FF03 frame. */
+  if(source!=0x01d80fu||v->pc!=0x01d87fu||v->s!=(uint16)(p->entry_s-2u)||
+     !task_call_environment(c,v,9)||v->a!=p->before.a||v->x!=p->before.x||v->y!=p->before.y||
+     v->d!=p->before.d||v->db!=p->before.db||v->p!=p->before.p||
+     !task_peek(c,p->entry_s-1u,&low)||!task_peek(c,p->entry_s,&high)||low!=0x11u||high!=0xd8u){task_call_reset();return;}
+  p->task.bytes[9]=low;p->task.bytes[10]=high;p->expected=*v;p->phase=2;task_resume_reset(&s_task_active);return;
+ }
+ if(p->phase!=2||!p->inflight)return;
+ const uint32 next=p->opcode==0xd0u&&!(v->p&CPU_P_Z)?p->branch:p->fall;
+ if(source!=p->source||!task_call_environment(c,v,11)||v->pc!=next||
+    v->d!=p->before.d||v->db!=p->before.db||v->y!=p->before.y){task_call_reset();return;}
+ if(p->opcode==0x60u){
+  if(source!=0x01d8b0u||v->pc!=0x01d812u||v->s!=p->entry_s||((v->p>>4)&3)!=0){task_call_reset();return;}
+  p->expected=*v;p->phase=3;p->inflight=0;return;
+ }
+ if(v->s!=(uint16)(p->entry_s-2u)){task_call_reset();return;}
+ p->expected=*v;p->inflight=0;
+}
+static void task_call_committed_local(CpuState *c,uint32 source,const Interp816 *in,uint32 actual){
+ TaskResumeState v=task_local_view(c,in,actual);task_call_commit_view(c,source,&v);
+}
+static void task_call_committed_cpu(CpuState *c,uint32 source){
+ if(s_task_call.phase!=2||!s_task_call.inflight)return;
+ if(c->PB!=1){task_call_reset();return;}
+ /* Native source19 RTS semantics consume the exact prechecked two-byte frame.
+    Candidate only: original watermark/paired owner decision must publish later. */
+ const uint32 next=s_task_call.opcode==0xd0u&&!c->_flag_Z?s_task_call.branch:s_task_call.fall;
+ TaskResumeState v=task_cpu_view(c,next);task_call_commit_view(c,source,&v);
+}
+/* Observes only after the original scheduler retained this SAME owner. */
+static void task_call_owner_resume_local(CpuState *c,const Interp816 *in,uint32 actual){
+ SourceTaskCall *p=&s_task_call;if(p->phase!=3)return;
+ TaskResumeState v=task_local_view(c,in,actual);
+ if(actual!=0x01d812u||!task_call_environment(c,&v,11)||!task_call_registers(&v,&p->expected)){task_call_reset();return;}
+ s_task_active=p->task;s_task_active.actual=v;s_task_active.actual_landing=v.pc;s_task_active.actual_p=v.p;
+ task_call_reset();
+}
