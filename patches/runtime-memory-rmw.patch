+def faithful_memory_rmw_contract(insn, ops):
+    """Match exact original-byte RMW forms AND their connected lowered IR.
+
+    The ordinary Read/Shift/Write path recomputes the EA and uses ordinary
+    word-write order. It cannot become faithful merely by admitting an opcode.
+    A matched contract instead uses one original operand snapshot for both
+    bus phases and retains the original per-operation flag ordering.
+    """
+    from snes65816 import DP, DP_X, ABS, ABS_X
+    groups = {
+        'ASL': (0x06, 0x16, 0x0E, 0x1E),
+        'ROL': (0x26, 0x36, 0x2E, 0x3E),
+        'LSR': (0x46, 0x56, 0x4E, 0x5E),
+        'ROR': (0x66, 0x76, 0x6E, 0x7E),
+        'DEC': (0xC6, 0xD6, 0xCE, 0xDE),
+        'INC': (0xE6, 0xF6, 0xEE, 0xFE),
+    }
+    modes = (DP, DP_X, ABS, ABS_X)
+    mode = getattr(insn, 'mode', None)
+    mnem = getattr(insn, 'mnem', None)
+    if (mnem not in groups or mode not in modes
+            or getattr(insn, 'm_flag', None) not in (0, 1)
+            or getattr(insn, 'x_flag', None) not in (0, 1)
+            or getattr(insn, 'data_region_exec', False)):
+        return None
+    index = modes.index(mode)
+    if (getattr(insn, 'opcode', None) != groups[mnem][index]
+            or getattr(insn, 'length', None) != (2 if index < 2 else 3)
+            or type(getattr(insn, 'operand', None)) is not int
+            or not 0 <= insn.operand <= (0xFF if index < 2 else 0xFFFF)):
+        return None
+    seg = SegRef(kind=SegKind.DIRECT if index < 2 else SegKind.ABS_BANK,
+                 offset=insn.operand, index=Reg.X if index in (1, 3) else None)
+    width = 1 if insn.m_flag else 2
+    if mnem in ('INC', 'DEC'):
+        if (len(ops) != 1 or not isinstance(ops[0], IncMem)
+                or ops[0].seg != seg or ops[0].width != width
+                or ops[0].delta != (1 if mnem == 'INC' else -1)):
+            return None
+    else:
+        if len(ops) != 3:
+            return None
+        read, shift, write = ops
+        if (not isinstance(read, Read) or not isinstance(shift, Shift)
+                or not isinstance(write, Write) or read.seg != seg or write.seg != seg
+                or (read.width, shift.width, write.width) != (width, width, width)
+                or shift.op.value != mnem.lower() or shift.src != read.out
+                or write.src != shift.out or read.out == shift.out):
+            return None
+    return ('CPU_AOT_RMW_DP', 'CPU_AOT_RMW_DPX',
+            'CPU_AOT_RMW_ABS', 'CPU_AOT_RMW_ABSX')[index], (5, 6, 6, 7)[index]
+
+
+def emit_faithful_memory_rmw(insn, ops):
+    """Original RMW data/flag phases using a cached runtime operand.
+
+    Helpers retain original read-word claiming/atomic MMIO behavior, reversed
+    result-word writes, actual fetched operands, wrapping and cycle penalties.
+    No effective address expression is evaluated again after a bus callback.
+    """
+    contract = faithful_memory_rmw_contract(insn, ops)
+    if contract is None:
+        return None
+    mode, _base_cycles = contract
+    width = 1 if insn.m_flag else 2
+    ctype = widths.ctype(width)
+    lines = ['{', '  uint16 _rmw_value;',
+             f'  CpuAotRmwOperand _rmw_operand = cpu_aot_rmw_read(cpu, {mode}, &_rmw_value);']
+    if insn.mnem in ('INC', 'DEC'):
+        delta = '+ 1u' if insn.mnem == 'INC' else '- 1u'
+        lines.append(f'  {ctype} _rmw_result = ({ctype})(_rmw_value {delta});')
+        carry = []
+        nz = widths.set_nz_no_p('_rmw_result', width)
+    else:
+        # Reuse the proven IR's width-aware arithmetic while moving N/Z past
+        # the original write phase. ROR publishes carry after that phase too.
+        read, shift, _write = ops
+        lines.append(f'  {ctype} {_v(read.out)} = ({ctype})_rmw_value;')
+        arithmetic = _emit_shift(shift)
+        lines.append('  ' + arithmetic[0])
+        lines.append(f'  {ctype} _rmw_result = {_v(shift.out)};')
+        carry = arithmetic[1:2]
+        nz = arithmetic[2:]
+    if insn.mnem != 'ROR':
+        lines.extend('  ' + line for line in carry)
+    lines.append('  cpu_aot_rmw_write(cpu, &_rmw_operand, (uint16)_rmw_result);')
+    lines.extend('  ' + line for line in nz)
+    if insn.mnem == 'ROR':
+        lines.extend('  ' + line for line in carry)
+    lines.append('}')
+    return lines
+
+
+def faithful_accumulator_incdec(insn, ops):
+    """Accumulator INC/DEC is a register operation, never a memory RMW."""
+    from snes65816 import ACC
+    expected = {0x1A: ('INC', 1), 0x3A: ('DEC', -1)}
+    shape = expected.get(getattr(insn, 'opcode', None))
+    return (shape is not None and getattr(insn, 'mode', None) == ACC
+            and getattr(insn, 'length', None) == 1 and insn.mnem == shape[0]
+            and getattr(insn, 'm_flag', None) in (0, 1)
+            and getattr(insn, 'x_flag', None) in (0, 1)
+            and not getattr(insn, 'data_region_exec', False)
+            and len(ops) == 1 and isinstance(ops[0], IncReg)
+            and ops[0].reg == Reg.A and ops[0].delta == shape[1])
 
 
