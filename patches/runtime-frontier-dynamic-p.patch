+    forced={p&0x7fffff for c in cfg.values()for p in c.force_lle}
+    # Producer is the internal exact source factory, never external JSON/PCs.
+    cert=derive_nested(rom,parsed,enable_native_call_prefix=True)[1]
+    calls={}
+    for row in cert['source_calls']:
+        pc=row['pc24'];off=rom_offset(pc>>16,pc&65535)
+        ins=decode_insn(rom,off,pc&65535,pc>>16,row['m'],row['x'])
