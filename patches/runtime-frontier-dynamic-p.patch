+    rows={};successors=[]
+    for pc in sorted(barriers):
+        active_boundary=False
+        for m,x in((0,0),(0,1),(1,0),(1,1)):
+            off=rom_offset(pc>>16,pc&65535);ins=decode_insn(rom,off,pc&65535,pc>>16,m,x)
+            if not ins or ins.opcode!=0x28 or ins.mnem!='PLP'or ins.length!=1:raise ValueError('authentic PLP opcode')
