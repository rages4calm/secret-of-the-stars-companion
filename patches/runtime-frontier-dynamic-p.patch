+        calls.setdefault(pc,[]).append(row)
+    barriers=set();origins=[]
+    for g in cert['graphs']:
+        if g['parameter_m']not in(0,1)or g['parameter_x']not in(0,1):raise ValueError('frontier live-mode source parameter')
+        for pc,m,x,mnem in g['barriers']:
+            if mnem!='PLP':continue
+            if m not in(0,1)or x not in(0,1):raise ValueError('frontier source mode')
+            for callpc in g['source_calls']:
+                sources=calls.get(callpc,[])
+                if not sources:raise ValueError('frontier barrier lost original call source')
+                expected={r['next_pc']if g['source_kind']=='callee'else((callpc&0xff0000)|((callpc&65535)+r['length']))for r in sources}
+                if g['source_kind']not in('callee','return')or g['source_start']not in expected:raise ValueError('frontier origin source start')
+                if _mask(parsed,g['source_start'],1):continue
