+        # This never calls decoder.post_state(PLP) or exports a restored pair.
+        start=(pc&65535)+1
+        if start>=65536:raise ValueError('mode-boundary nextPC wrap')
+        for m,x in((0,0),(0,1),(1,0),(1,1)):
+            g=decode_function(rom,pc>>16,start,m,x,max_insns=128,data_regions=masks,stop_on_unknown_callee_exit=True)
+            if g.authority_conflict or g.data_region_exec_pcs or len(g.insns)>=128:raise ValueError('mode-successor source authority')
+            local=[];calls=[];c=cfg[pc>>16]
+            emit_function(rom,pc>>16,start,m,x,func_name='DiscardedLiveModeSuccessor',data_regions=masks,exclude_ranges=c.exclude_ranges,hle_func=c.hle_func,hle_spc_upload=c.hle_spc_upload,source_task_resume_stops=g.unknown_callee_exit_sites,native_region_collector=local,native_call_prefix_collector=calls if enable_native_call_prefix else None,native_call_prefix_forced=forced,_native_collector_only=True)
+            supported={tuple(r[k]for k in('pc24','m','x'))for r in local+calls if _independent(rom,parsed,r)};todo=[g.entry];allowed=set();stops=[]
+            while todo:
+                key=todo.pop()
+                if key in allowed:continue
+                di=g.insns.get(key)
+                if not di:continue
+                if di.insn.mnem in BARRIERS or (key.pc,key.m,key.x)not in supported or getattr(di.insn,'const_z_fold_unconditional',False):stops.append([key.pc,key.m,key.x,di.insn.mnem]);continue
+                allowed.add(key)
+                if di.insn.mnem not in('JSR','JSL'):todo.extend(di.successors)
+            members={(k.pc,k.m,k.x)for k in allowed};keys=[]
+            for row in local+calls:
+                key=tuple(row[k]for k in('pc24','m','x'))
+                if key not in members:continue
+                if key in rows and rows[key]!=row:raise ValueError('unequal live-mode body')
+                rows[key]=row;keys.append(list(key))
+            successors.append({'source_PLP':pc,'next_pc':(pc&0xff0000)|start,'parameter_m':m,'parameter_x':x,'instruction_keys':keys,'barriers':stops,'static_restored_mode_asserted':False})
+    return [rows[k]for k in sorted(rows)],{'origins':origins,'boundaries':sorted(barriers),'successors':successors,'callee_exit_modes_added':False,'caller_owner_added':False}
