+      interp816_eor(cpu, low, high);
+}
+int interp816_native_eor_dp(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x45)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0x45];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_eor_dp(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x45);
+  return cpu->cyclesUsed;
+}
+static void interp816_arch_lsr_dp(Interp816 *cpu) {
