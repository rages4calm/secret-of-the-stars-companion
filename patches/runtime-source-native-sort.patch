+  cpu->cyclesUsed = cyclesPerOpcode[0x55];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_eor_dpx(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x55);
+  return cpu->cyclesUsed;
+}
+static void interp816_arch_ror_abs(Interp816 *cpu) {
+      uint32_t low = 0;
+      uint32_t high = interp816_adrAbs(cpu, &low);
