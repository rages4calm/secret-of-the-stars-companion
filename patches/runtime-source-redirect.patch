diff --git a/runner/src/redirect_contract.h b/runner/src/redirect_contract.h
new file mode 100644
--- /dev/null
+++ b/runner/src/redirect_contract.h
@@ -0,0 +1,22 @@
+#ifndef SOURCE_REDIRECT_CONTRACT_H
+#define SOURCE_REDIRECT_CONTRACT_H
+#include "task_resume_contract.h"
+typedef struct {
+ TaskResumeState state;
+ uint64_t hook,lifecycle;
+ uintptr_t dispatch;
+ unsigned depth;
+} RedirectState;
+typedef struct {
+ RedirectState initial,expected,arrival;
+ uint16_t s0;
+ uint8_t p,db,task[64],stage,pending,published,handoff,active;
+} RedirectProof;
+void redirect_reset(RedirectProof *);
+int redirect_arm(RedirectProof *,const RedirectState *,TaskResumePeek,void *);
+int redirect_before(RedirectProof *,const RedirectState *,TaskResumePeek,void *);
+int redirect_committed(RedirectProof *,uint32_t,const RedirectState *,TaskResumePeek,void *);
+int redirect_handoff(RedirectProof *,unsigned,const RedirectState *,const RedirectState *);
+int redirect_take(RedirectProof *,const RedirectState *,TaskResumePeek,void *);
+int redirect_active(RedirectProof *,const RedirectState *,TaskResumePeek,void *);
+#endif
diff --git a/runner/src/redirect_contract.inc b/runner/src/redirect_contract.inc
new file mode 100644
--- /dev/null
+++ b/runner/src/redirect_contract.inc
@@ -0,0 +1,96 @@
+#include "redirect_contract.h"
+#include <string.h>
+static const uint32_t redirect_sites[]={0x00ff20,0x0084d9,0x0084da,0x0084db,0x0084dd,0x0084e0,0x0084e1,0x0084e2,0x0084e4,0x0084e6,0x0084e7,0x0084e8,0x0084ea,0x0084eb,0x0084ec,0x0084ee,0x0084ef,0x0084f2,0x0084f3,0x0084f6,0x0084f8,0x0084f9,0x0084fa};
+void redirect_reset(RedirectProof *p){if(p)memset(p,0,sizeof(*p));}
+static int red_epoch(const RedirectState *a,const RedirectState *b){
+ const TaskResumeState *x=&a->state,*y=&b->state;
+ return x->cpu==y->cpu&&x->module==y->module&&x->owner==y->owner&&x->generation==y->generation&&x->frame==y->frame&&x->owner_epoch==y->owner_epoch&&a->hook==b->hook&&a->lifecycle==b->lifecycle&&a->dispatch==b->dispatch&&a->depth==b->depth;
+}
+static int red_regs(const RedirectState *a,const RedirectState *b){
+ const TaskResumeState *x=&a->state,*y=&b->state;
+ return x->pc==y->pc&&x->s==y->s&&x->a==y->a&&x->x==y->x&&x->y==y->y&&x->d==y->d&&x->p==y->p&&x->db==y->db&&x->e==y->e;
+}
+static int red_byte(TaskResumePeek peek,void *c,uint32_t at,uint8_t v){uint8_t b;return peek(c,at,&b)&&b==v;}
+static int red_word(TaskResumePeek peek,void *c,uint32_t at,uint16_t v){return red_byte(peek,c,at,(uint8_t)v)&&red_byte(peek,c,at+1,(uint8_t)(v>>8));}
+static int red_memory(const RedirectProof *p,TaskResumePeek peek,void *c){
+ for(unsigned n=0;n<64;n++)if(!red_byte(peek,c,n,p->task[n]))return 0;
+ if(!red_word(peek,c,0x01d119,0xd176)||!red_byte(peek,c,((uint32_t)p->db<<16)|0x442,2))return 0;
+ const uint16_t ret=p->stage>=20?0xd175:0xd114;
+ if(!red_word(peek,c,p->s0+1,ret)||!red_byte(peek,c,p->s0+3,1))return 0;
+ if(p->stage>=2&&!red_byte(peek,c,p->s0,p->p))return 0;
+ if(p->stage>=3&&!red_byte(peek,c,p->s0-1,p->db))return 0;
+ if(p->stage>=10&&!red_byte(peek,c,p->s0-2,1))return 0;
+ return 1;
+}
+int redirect_arm(RedirectProof *p,const RedirectState *v,TaskResumePeek peek,void *c){
+ if(!p)return 0;redirect_reset(p);
+ if(!v||!peek)return 0;const TaskResumeState *s=&v->state;
+ /* Source task footprint and scratch stack must not alias; all bytes WRAM. */
+ if(s->e||!s->cpu||!s->module||!s->owner||!s->owner_epoch||!v->dispatch||!v->depth||
+    s->pc!=0x00ff20||(s->p&0x38)!=0x20||(s->a&255)!=2||s->s<0x43||s->s>0x1ffc||
+    !((s->db<=0x3f)||(s->db>=0x80&&s->db<=0xbf))||
+    !red_word(peek,c,s->s+1,0xd114)||!red_byte(peek,c,s->s+3,1)||
+    !red_word(peek,c,0x01d119,0xd176)||!red_byte(peek,c,((uint32_t)s->db<<16)|0x442,2))return 0;
+ p->initial=p->expected=*v;p->s0=s->s;p->p=s->p;p->db=s->db;
+ for(unsigned n=0;n<64;n++)if(!peek(c,n,&p->task[n])){redirect_reset(p);return 0;}
+ p->pending=1;return 1;
+}
+int redirect_before(RedirectProof *p,const RedirectState *v,TaskResumePeek peek,void *c){
+ if(!p||!v||!p->pending)return 0;
+ if(p->stage>=sizeof(redirect_sites)/sizeof(*redirect_sites)||v->state.pc!=redirect_sites[p->stage]||
+    !red_epoch(&p->expected,v)||!red_regs(&p->expected,v)||!red_memory(p,peek,c)){redirect_reset(p);return 0;}
+ return 1;
+}
+static void red_nz(TaskResumeState *v,uint16_t n,unsigned width){uint16_t mask=width==8?255:65535,sign=width==8?128:32768;v->p=(uint8_t)((v->p&~0x82)|((n&mask)?0:2)|((n&sign)?128:0));}
+int redirect_committed(RedirectProof *p,uint32_t source,const RedirectState *actual,TaskResumePeek peek,void *c){
+ if(!p||!actual||!p->pending)return 0;
+ if(p->stage>=23||source!=redirect_sites[p->stage]||!red_epoch(&p->expected,actual)){redirect_reset(p);return 0;}
+ RedirectState next=p->expected;TaskResumeState *v=&next.state;
+ switch(p->stage){
+ case 0:break; /* original FF20 JMP */
+ case 1:--v->s;break; /* PHP */
+ case 2:--v->s;break; /* PHB */
+ case 3:v->p&=(uint8_t)~0x30;break;
+ case 4:v->a&=255;red_nz(v,v->a,16);break;
+ case 5:v->a=4;v->p&=(uint8_t)~1;red_nz(v,v->a,16);break;
+ case 6:v->x=v->a;red_nz(v,v->x,16);break;
+ case 7:v->p|=0x20;break;
+ case 8:v->a=(uint16_t)((v->a&0xff00)|1);red_nz(v,1,8);break;
+ case 9:--v->s;break;
+ case 10:++v->s;v->db=1;red_nz(v,1,8);break;
+ case 11:v->p&=(uint8_t)~0x20;break;
+ case 12:v->a=v->x;red_nz(v,v->a,16);break;
+ case 13:v->p|=1;break;
+ case 14:v->a=0xd119;v->p&=(uint8_t)~0x41;red_nz(v,v->a,16);break;
+ case 15:v->y=v->a;red_nz(v,v->y,16);break;
+ case 16:v->a=0xd176;red_nz(v,v->a,16);break;
+ case 17:v->p|=1;break;
+ case 18:v->a=0xd175;v->p=(uint8_t)((v->p&~0x40)|1);red_nz(v,v->a,16);break;
+ case 19:break; /* original STA $03,S */
+ case 20:++v->s;v->db=p->db;red_nz(v,v->db,8);break;
+ case 21:++v->s;v->p=p->p;break;
+ case 22:v->s=(uint16_t)(v->s+3);break;
+ }
+ ++p->stage;v->pc=p->stage==23?0x01d176:redirect_sites[p->stage];
+ if(!red_regs(&next,actual)||!red_memory(p,peek,c)){redirect_reset(p);return 0;}
+ p->expected=next;
+ if(p->stage==23){p->pending=0;p->published=1;p->arrival=next;}
+ return 1;
+}
+int redirect_handoff(RedirectProof *p,unsigned route,const RedirectState *from,const RedirectState *to){
+ if(!p||!from||!to)return 0;
+ int ok=p->published&&!p->pending&&!p->handoff&&(route==1||route==2)&&red_epoch(&p->arrival,from)&&red_regs(&p->arrival,from)&&red_regs(from,to)&&
+  from->state.cpu==to->state.cpu&&from->state.module==to->state.module&&from->state.generation==to->state.generation&&from->state.frame==to->state.frame&&
+  from->hook==to->hook&&from->lifecycle==to->lifecycle&&to->state.owner&&to->state.owner_epoch&&to->dispatch&&to->depth;
+ if(!ok){redirect_reset(p);return 0;}
+ p->arrival=*to;p->expected=*to;p->handoff=1;return 1;
+}
+int redirect_take(RedirectProof *p,const RedirectState *v,TaskResumePeek peek,void *c){
+ if(!p||!v)return 0;
+ int ok=p->published&&!p->pending&&!p->active&&red_epoch(&p->arrival,v)&&red_regs(&p->arrival,v)&&red_memory(p,peek,c);
+ if(!ok){redirect_reset(p);return 0;}p->published=0;p->active=1;return 1;
+}
+int redirect_active(RedirectProof *p,const RedirectState *v,TaskResumePeek peek,void *c){
+ if(!p||!v||!p->active)return 0;
+ if(!red_epoch(&p->expected,v)||!red_regs(&p->expected,v)||!red_memory(p,peek,c)){redirect_reset(p);return 0;}return 1;
+}
