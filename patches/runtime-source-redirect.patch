+++ b/recompiler/v2/source_redirect.py
@@ -0,0 +1,57 @@
+"""One source-bound original dispatcher arrival; no roots or callee summary."""
+from snes65816 import rom_offset
+from .decoder import decode_function
+from .emit_function import emit_function
+from .native_regions import emit
+from .program_analysis import VariantKey,NodeDisposition
+
+def derive(rom,parsed,manifest,module_prefix=None):
+ specs=[s for _b,_p,c in parsed for s in getattr(c,'source_redirects',())]
+ if not specs:return [],None
+ if len(specs)!=1 or module_prefix:raise ValueError('redirect module/recipe ownership refusal')
+ if specs[0]!=(0x01d111,0x00ff20,0x0084d9,0x0084fa,0x01d119,2,0x01d176):raise ValueError('redirect source recipe refusal')
+ key=VariantKey(0x01c406,1,0);node=manifest.nodes.get(key)
+ if not node or node.disposition!=NodeDisposition.AOT_PREFIX or not any(e.site_pc24==0x01d111 and e.target==VariantKey(0x00ff20,1,0)for e in node.demands):
+  raise ValueError('redirect lacks existing typed D111 demand authority')
+ raw=lambda p,n:rom[rom_offset(p>>16,p&65535):rom_offset(p>>16,p&65535)+n]
+ spans=[(0x00a403,bytes.fromhex('4cfda8')),(0x00a8fd,bytes.fromhex('e220a9028d42042206c401')),
+ (0x01c406,bytes.fromhex('4c07d1')),(0x01d107,bytes.fromhex('e220ad4204c9ffd0016b2220ff00')),
+ (0x00ff20,bytes.fromhex('4cd984')),
+ (0x0084d9,bytes.fromhex('088bc23029ff000aaae220a30548abc2208a386303a8b9000038e901008303ab286b')),
+ (0x01d119,bytes.fromhex('76d1'))]
+ for p,b in spans:
+  if raw(p,len(b))!=b:raise ValueError('redirect source byte mismatch '+hex(p))
+ masks=[r for _b,_p,c in parsed for r in c.data_regions]+[(c.bank,a,b)for _b,_p,c in parsed for a,b in c.authority_data+c.exclude_ranges]
+ forced={p&0x7fffff for _b,_p,c in parsed for p in c.force_lle}
+ if not {0x00ff20,0x0084d9}<=forced:raise ValueError('redirect original dispatcher guards missing')
+ # Dispatcher source remains quarantined; only independently derived receiving
+ # architectural rows undergo ordinary all-byte data/native exclusion guards.
+ graph=decode_function(rom,1,0xd176,1,0,end=0xd182,max_insns=32,data_regions=masks,stop_on_unknown_callee_exit=True)
+ if set(graph.unknown_callee_exit_sites)!={(0x01d17e,0x01e000,0,0)}:raise ValueError('redirect unknown call barrier changed '+repr(graph.unknown_callee_exit_sites))
+ local=[]
+ emit_function(rom,1,0xd176,1,0,end=0xd182,func_name='SourceRedirectDerivation',data_regions=masks,
+  exclude_ranges=[(p&65535,(p&65535)+1)for p in forced if p>>16==1],native_region_collector=local,
+  source_task_resume_stops=graph.unknown_callee_exit_sites)
+ rows=[r for r in local if r['pc24']in(0x01d176,0x01d178,0x01d17b)]
+ if len(rows)!=3 or {r['mnemonic']for r in rows}!={'REP','LDA','STA'}:raise ValueError('redirect masked or ambiguous prefix')
+ for r in rows:
+  if any((((r['pc24']&0xff0000)|((r['pc24']+j)&65535))&0x7fffff)in forced for j in range(r['length'])):raise ValueError('redirect forced prefix')
+  if r['bytes']!=raw(r['pc24'],r['length']).hex():raise ValueError('redirect row bytes mismatch')
+  r['contract']='native-e0-source-original-redirect-v1'
+ return rows,{'entry':0x01d111,'return':0x0084fa,'selector':2,'table':0x01d119,'landing':0x01d176,'decimal':0,'spans':spans,'barrier':0x01d17e}
+
+def emit_source(rows,recipe,module_prefix=None):
+ code=emit(rows,module_prefix).replace('cpu_native_region_step','cpu_source_redirect_region_step')
+ code=code.replace('extern SnesProgramModule g_program_module;','extern SnesProgramModule g_program_module;\nextern bool cpu_source_redirect_active(CpuState *,uint32,uint8);')
+ code=code.replace('  switch (((pc24&0x7fffffu)<<2)|mx) {','  if(!cpu_source_redirect_active(cpu,pc24,mx))return false;\n  switch (((pc24&0x7fffffu)<<2)|mx) {')
+ code+='\nint cpu_source_redirect_recipe_matches(int (*peek)(void *,uint32,unsigned char *),void *ctx){\n unsigned char b;\n'
+ if recipe:
+  for pc,raw in recipe['spans']:
+   for n,value in enumerate(raw):code+=f' if(!peek(ctx,{pc+n}u,&b)||b!={value}u)return 0;\n'
+  for row in rows:
+   for n,value in enumerate(bytes.fromhex(row['bytes'])):code+=f' if(!peek(ctx,{row["pc24"]+n}u,&b)||b!={value}u)return 0;\n'
+  code+=' return 1;\n}\n'
+ else:code+=' (void)peek;(void)ctx;(void)b;return 0;\n}\n'
+ return code
+
+
