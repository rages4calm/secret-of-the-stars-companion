+int interp816_native_cpx_dp(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0xe4)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0xe4];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_cpx_dp(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0xe4);
+  return cpu->cyclesUsed;
+}
+static void interp816_arch_phx(Interp816 *cpu) {
+      if(cpu->xf) {
+        interp816_pushByte(cpu, (uint8_t)cpu->x);
+      } else {
+        cpu->cyclesUsed++; // m = 0: 1 extra cycle
+        interp816_pushWord(cpu, cpu->x);
+      }
+}
+int interp816_native_phx(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0xda)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0xda];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_phx(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0xda);
+  return cpu->cyclesUsed;
+}
+static void interp816_arch_plx(Interp816 *cpu) {
+      if(cpu->xf) {
+        cpu->x = interp816_pullByte(cpu);
+      } else {
+        cpu->cyclesUsed++; // 16-bit x: 1 extra cycle
+        cpu->x = interp816_pullWord(cpu);
+      }
+      interp816_setZN(cpu, cpu->x, cpu->xf);
+}
+int interp816_native_plx(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0xfa)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0xfa];
