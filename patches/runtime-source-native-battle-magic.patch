+/* Original battle-magic CPU cases shared verbatim. */
+static void interp816_arch_sbc_abs(Interp816 *cpu) {
+      uint32_t low = 0;
+      uint32_t high = interp816_adrAbs(cpu, &low);
+      interp816_sbc(cpu, low, high);
+}
+int interp816_native_sbc_abs(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0xed)) return 0;
+  cpu->cyclesUsed = cyclesPerOpcode[0xed];
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_sbc_abs(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0xed);
+  return cpu->cyclesUsed;
+}
