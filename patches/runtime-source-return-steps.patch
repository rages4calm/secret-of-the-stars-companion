+"""Scoped architectural returns from internal source barrier certificates."""
+import re
+from snes65816 import decode_insn,rom_offset
+from snes_cycles import instr_cpu_cycles
+from .architecture_callee_sources import derive as derive_callees
+from .architecture_mode_sources import derive as derive_modes
+from .architecture_nested_sources import derive as derive_nested
+from .architecture_frontier_mode_sources import derive as derive_frontier_modes
+from .decoder import decode_function
+from .emit_function import emit_function
+from .lowering import lower
+from .ir import Return
+SOURCE_RETURN_CONTRACT='source-e0-scheduler-architectural-return-v1'
+
+def validate_return(rom,parsed,row):
+    """No general return admission: exact original architecture prefix only."""
+    from .architecture_eligibility import _mask
+    if row.get('source_return_contract')!=SOURCE_RETURN_CONTRACT:return False
+    try:
+        pc,m,x=(row[k]for k in('pc24','m','x'));length=row['length']
+        if m not in(0,1)or x not in(0,1)or length!=1 or pc>>16 in(0x7e,0x7f)or pc&65535<0x8000 or _mask(parsed,pc,1):return False
+        off=rom_offset(pc>>16,pc&65535)
+        if off<0 or off>=len(rom):return False
+        ins=decode_insn(rom,off,pc&65535,pc>>16,m,x)
+        if not ins or ins.opcode not in(0x60,0x6b)or ins.mnem not in('RTS','RTL')or ins.length!=1 or row['bytes']!=rom[off:off+1].hex()or row['mnemonic']!=ins.mnem:return False
+        ins.m_flag,ins.x_flag=m,x
+        ops=lower(ins,value_factory=lambda:None)
+        if len(ops)!=1 or not isinstance(ops[0],Return)or ops[0].interrupt or ops[0].source_pc24!=pc or ops[0].long!=(ins.mnem=='RTL'):return False
+        if row['cycles']!=instr_cpu_cycles(ins.opcode,m=m,x=x,e=0)or row['next_pc']!=(pc+1)&65535:return False
+        increment='cpu->S = (uint16)(cpu->S + 1);'
+        exact=['{ uint16 _ret_s = cpu->S;',increment,'uint16 _rpcl = (uint16)cpu_aot_read8(cpu, 0x00, cpu->S);',increment,'uint16 _rpch = (uint16)cpu_aot_read8(cpu, 0x00, cpu->S);']
+        if ins.mnem=='RTL':exact += [increment,'uint8 _rpb = cpu_aot_read8(cpu, 0x00, cpu->S);','cpu->PB = _rpb;']
+        else:exact += ['uint8 _rpb = cpu->PB;']
+        exact += ['uint32 _rpc = (uint32)((((_rpch << 8) | _rpcl) + 1) & 0xFFFFu);','uint32 _rpc24 = ((uint32)_rpb << 16) | _rpc;','*next_pc=_rpc24;',f'cpu_source_call_return_stage(cpu,0x{pc:06x}u,0x{ins.opcode:02x}u,_ret_s,(uint8)_rpcl,(uint8)_rpch,_rpb,_rpc24);','}']
+        clean=lambda value:re.sub(r'\s+','',re.sub(r'/\*.*?\*/','',value,flags=re.S))
+        return clean(row['body'])==clean(''.join(exact))
+    except(KeyError,TypeError,ValueError):return False
+
+def derive(rom,parsed,*,enable_native_call_prefix=True):
+    from .architecture_eligibility import _independent
+    cfg={b:c for b,_p,c in parsed}
+    masks=[r for c in cfg.values()for r in c.data_regions]+[(c.bank,a,b)for c in cfg.values()for a,b in c.authority_data+c.exclude_ranges]
+    # All views are produced internally by unchanged source factories. These
+    # dictionaries cannot be supplied by external files, flags, or observedPCs.
+    sources=[]
+    for g in derive_callees(rom,parsed,enable_native_call_prefix=True)[1]:sources.append(('source_callee',g,g['barriers']))
+    for g in derive_modes(rom,parsed,enable_native_call_prefix=True)[1]['successors']:sources.append(('source_live_mode',g,g['barriers']))
+    for g in derive_nested(rom,parsed,enable_native_call_prefix=True)[1]['graphs']:sources.append(('source_nested',g,g['barriers']))
+    for g in derive_frontier_modes(rom,parsed,enable_native_call_prefix=True)[1]['successors']:sources.append(('source_frontier_mode',g,g['barriers']))
+    origins=[];starts=set()
+    for kind,g,barriers in sources:
+        for pc,m,x,mnem in barriers:
+            if mnem not in('RTS','RTL'):continue
+            off=rom_offset(pc>>16,pc&65535);ins=decode_insn(rom,off,pc&65535,pc>>16,m,x)
+            if not ins or ins.mnem!=mnem or ins.opcode not in(0x60,0x6b)or ins.length!=1:raise ValueError('authentic source return barrier')
+            starts.add(pc);origins.append({'origin':kind,'source':g,'return_pc':pc,'source_m':m,'source_x':x,'mnemonic':mnem})
+    rows={};refused=[]
+    for pc in sorted(starts):
+        for m,x in((0,0),(0,1),(1,0),(1,1)):
+            local=[];c=cfg[pc>>16]
+            emit_function(rom,pc>>16,pc&65535,m,x,func_name='DiscardedSourceArchitecturalReturn',data_regions=masks,exclude_ranges=c.exclude_ranges,hle_func=c.hle_func,hle_spc_upload=c.hle_spc_upload,source_task_resume_stops=decode_function(rom,pc>>16,pc&65535,m,x,data_regions=masks,stop_on_unknown_callee_exit=True).unknown_callee_exit_sites,native_region_collector=local,_native_collector_only=True)
+            one=[r for r in local if(r['pc24'],r['m'],r['x'])==(pc,m,x)]
+            if not one:refused.append([pc,m,x]);continue
+            if len(one)!=1:raise ValueError('ambiguous source return step')
+            row=dict(one[0]);row['source_return_contract']=SOURCE_RETURN_CONTRACT
+            if not validate_return(rom,parsed,row)or not _independent(rom,parsed,row):refused.append([pc,m,x]);continue
+            rows[(pc,m,x)]=row
+    return [rows[k]for k in sorted(rows)],{'contract':SOURCE_RETURN_CONTRACT,'origins':origins,'source_return_starts':sorted(starts),'refused':refused,'static_return_target_exported':False,'successor_mode_exported':False,'callee_exit_modes_added':False,'caller_owner_added':False}
