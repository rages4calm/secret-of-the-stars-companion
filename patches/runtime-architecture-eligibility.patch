--- /dev/null
+++ b/recompiler/v2/architecture_eligibility.py
@@ -0,0 +1,76 @@
+"""Independent source-owned instruction union; never callable roots/exit facts."""
+from snes65816 import decode_insn,rom_offset
+from .architecture_ff20_sources import derive as derive_ff20
+
+ARCHITECTURE_CONTRACT='source-reviewed-independent-instruction-union-v1'
+FIELDS=('pc24','m','x','length','cycles','bytes','next_pc','body','mnemonic')
+
+def _key(row):return tuple(row[k]for k in ('pc24','m','x'))
+def _mask(parsed,pc,length):
+    for bank,_path,cfg in parsed:
+        spans=list(cfg.data_regions)+[(cfg.bank,a,b)for a,b in cfg.authority_data+cfg.exclude_ranges]
+        hle={((cfg.bank<<16)|p)&0x7fffff for p in set(cfg.hle_func)|set(cfg.hle_spc_upload)}
+        forced={p&0x7fffff for p in cfg.force_lle}
+        for n in range(length):
+            at=(pc&0xff0000)|((pc+n)&65535)
+            if at&0x7fffff in forced|hle:return True
+            if any(at>>16 in(b,b^128)and lo<=at&65535<hi for b,lo,hi in spans):return True
+    return False
+
+def _independent(rom,parsed,row):
+    pc,m,x=_key(row);length=row['length']
+    if m not in(0,1)or x not in(0,1)or not 0<length<=4 or pc>>16 in(0x7e,0x7f)or pc&65535<0x8000 or (pc&65535)+length>65536:return False
+    if _mask(parsed,pc,length):return False
+    off=rom_offset(pc>>16,pc&65535)
+    if off<0 or off+length>len(rom)or rom[off:off+length].hex()!=row['bytes']:return False
+    insn=decode_insn(rom,off,pc&65535,pc>>16,m,x)
+    if not insn or insn.length!=length or insn.mnem!=row['mnemonic']or insn.data_region_exec:return False
+    # Rows originate only from current source decoder + typed faithful collectors;
+    # no generated/external JSON body may create a certificate at runtime.
+    code=row['body']
+    if any(t in code for t in ('RecompReturn','interp_','_entry_s','_hrv','host_return_valid','cpu_aot_prefix','precise-mode unsupported:')):return False
+    if insn.mnem in('RTS','RTL','RTI'):return False
+    if insn.mnem in('JSR','JSL'):
+        if not row.get('original_scheduler_call')or row.get('contract')!='source-direct-call-architectural-prefix-v1':return False
+        if _mask(parsed,row['next_pc'],1):return False
+    return True
+
+def merge_source_union(rom,parsed,ordinary,sources):
+    """Only source derivation factories below supply candidate faithful bodies."""
+    output={_key(r):r for r in ordinary};summary=[]
+    for origin,candidates in sources:
+        added=[];reused=[];refused=[]
+        for source in candidates:
+            row=dict(source)
+            if row.pop('causal_suspended_child',False):
+                if row.pop('contract',None)!='native-e0-causal-suspended-child-v1':raise ValueError('child source instruction tag')
+            key=_key(row)
+            if not _independent(rom,parsed,row):refused.append(list(key));continue
+            if key in output:
+                if any(output[key].get(k)!=row.get(k)for k in FIELDS):raise ValueError('independent architectural body conflict '+repr(key))
+                reused.append(list(key));continue
+            output[key]=row;added.append(list(key))
+        summary.append({'origin':origin,'source_rows':len(candidates),'added':added,'reused':reused,'refused':refused})
+    return [output[k]for k in sorted(output)],{'contract':ARCHITECTURE_CONTRACT,'sources':summary,'ordinary_roots_added':False,'callee_exit_modes_added':False,'task_ownership_changed':False}
+
+def extend(rom,parsed,ordinary,task_rows,task_recipe,*,enable_native_call_prefix=True):
+    # Existing reviewed child derivation retained its seven source-known BRA
+    # bodies in the causal table. Union only the independently architecture-safe
+    # bodies; its source slot/host/publication recipe remains untouched.
+    child=[r for r in task_rows if r.get('causal_suspended_child')]
+    family=(task_recipe or {}).get('suspended_child')
+    if child and(not family or any(r['mnemonic']!='BRA'for r in child)):
+        raise ValueError('reviewed child architecture boundary')
+    ff20=derive_ff20(rom,parsed,enable_native_call_prefix=enable_native_call_prefix)
+    return merge_source_union(rom,parsed,ordinary,[('reviewed_original_task_child',child),('reviewed_original_ff20_receiving_starts',ff20['rows'])])
+
+
+def emit_membership(metadata,module_prefix=None):
+    if module_prefix:return ''
+    keys=sorted({tuple(k)for source in metadata['sources']for field in ('added','reused')for k in source[field]})
+    out=['bool cpu_source_architecture_member(uint32 pc,uint8 mx){',
+         '  if(mx>3u || pc>0xffffffu)return false;',
+         '  switch(((pc&0x7fffffu)<<2)|mx){']
+    out.extend(f'    case {(pc<<2)|(m<<1)|x}u:return true;'for pc,m,x in keys)
+    out.extend(['    default:return false;','  }','}',''])
+    return '\n'.join(out)
