--- /dev/null
+++ b/recompiler/v2/architecture_ff20_sources.py
@@ -0,0 +1,48 @@
+"""Reviewed original FF20 table-derived architectural starts; no runtime authority."""
+from snes65816 import rom_offset
+from .decoder import decode_function
+from .emit_function import emit_function
+
+# This is the source-reviewed call/table schema, not runtime selector values.
+SCHEMA=((0x01f4b9,0x01f4bb,0x01f4bf,7),(0x01f4cd,0x01f4cf,0x01f4d3,3))
+def derive(rom,parsed,*,enable_native_call_prefix=True):
+ raw=lambda p,n:rom[rom_offset(p>>16,p&65535):rom_offset(p>>16,p&65535)+n]
+ spans=[(0x01f4b5,bytes.fromhex('e230a000b7002220ff00')),(0x01f4cd,bytes.fromhex('a5532220ff00')),(0x00ff20,bytes.fromhex('4cd984')),(0x0084d9,bytes.fromhex('088bc23029ff000aaae220a30548abc2208a386303a8b9000038e901008303ab286b'))]
+ for p,b in spans:
+  if raw(p,len(b))!=b:raise ValueError('original FF20 source bytes')
+ cfg={b:c for b,_p,c in parsed}
+ if len(cfg)!=len(parsed):raise ValueError('duplicate source bank')
+ masks=[r for c in cfg.values()for r in c.data_regions]+[(c.bank,a,b)for c in cfg.values()for a,b in c.authority_data+c.exclude_ranges]
+ def data_masked(pc,n):return any(any((pc>>16)in(b,b^128)and lo<=((pc+j)&65535)<hi for b,lo,hi in masks)for j in range(n))
+ for producer,call,table,count in SCHEMA:
+  if data_masked(producer,2)or data_masked(call,4):raise ValueError('source producer/call data mask')
+  if any(p&65535 in(set(cfg[1].hle_func)|set(cfg[1].hle_spc_upload))for p in (producer,call)):raise ValueError('source producer/call HLE boundary')
+ forced={p&0x7fffff for c in cfg.values()for p in c.force_lle}
+ if not {0xff20,0x84d9}<=forced:raise ValueError('original dispatcher masks')
+ cases=[];rows={};graphs=[]
+ for producer,call,table,count in SCHEMA:
+  tablebytes=raw(table,count*2)
+  if len(tablebytes)!=count*2:raise ValueError('source table bound')
+  spans.append((table,tablebytes))
+  for selector in range(count):
+   target=int.from_bytes(tablebytes[selector*2:selector*2+2],'little')
+   # Exact bank-local original table, no inferred code/data extension.
+   if not 0x8001<=target<=0xffff:raise ValueError('source table target')
+   landing=(call&0xff0000)|target
+   graph=decode_function(rom,1,target,1,1,max_insns=128,data_regions=masks,stop_on_unknown_callee_exit=True)
+   if graph.authority_conflict or graph.data_region_exec_pcs or graph.unresolved_indirects or graph.suppressed_indirect_calls or len(graph.insns)>=128:raise ValueError('receiving graph authority')
+   local=[];calls=[]
+   emit_function(rom,1,target,1,1,func_name='DiscardedFF20Prefix',data_regions=masks,exclude_ranges=cfg[1].exclude_ranges,source_task_resume_stops=graph.unknown_callee_exit_sites,native_call_prefix_forced=forced,native_region_collector=local,native_call_prefix_collector=calls if enable_native_call_prefix else None)
+   members={(k.pc,k.m,k.x):di for k,di in graph.insns.items()}
+   keys=[]
+   for row in local+calls:
+    key=tuple(row[k]for k in ('pc24','m','x'));di=members.get(key)
+    if not di or di.insn.mnem in ('RTS','RTL','RTI'):continue
+    if any((((row['pc24']&0xff0000)|((row['pc24']+j)&65535))&0x7fffff)in forced for j in range(row['length'])):continue
+    if row['bytes']!=raw(row['pc24'],row['length']).hex():raise ValueError('independent whole instruction source')
+    row=dict(row)
+    if key in rows and rows[key]!=row:raise ValueError('unequal receiving context body')
+    rows[key]=row;keys.append(list(key))
+   cases.append(dict(producer=producer,call=call,table=table,selector=selector,landing=landing,mx=3))
+   graphs.append(dict(landing=landing,m=1,x=1,rows=keys,unknown_calls=[list(v)for v in sorted(graph.unknown_callee_exit_sites)],return_sites=[[k.pc,k.m,k.x,di.insn.mnem]for k,di in graph.insns.items()if di.insn.mnem in ('RTS','RTL')],closed_exit_summary=False))
+ return dict(cases=cases,rows=[rows[k]for k in sorted(rows)],graphs=graphs,spans=spans,ordinary_roots_added=False,forced_dispatcher_original=True,callee_exit_modes_added=False)
