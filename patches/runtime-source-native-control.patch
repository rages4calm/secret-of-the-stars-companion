+/* Invoked only in the original bridge supervisor execution slot. Refusal is
+ * before callbacks/fetch/mutation. Native instruction accounting is owned by
+ * that supervisor; this never calls doOpcode/runOpcode or decodes other ISA. */
+static int interp816_native_control_begin(Interp816 *cpu, uint8_t expected_opcode) {
+  if (!cpu || cpu->e || cpu->stopped || cpu->waiting || cpu->nmiWanted ||
+      (!cpu->i && cpu->irqWanted)) return 0;
+  interp_bridge_source_call_interp_enter(cpu);
+  cpu->cyclesUsed = 0;
+  uint8_t opcode = interp816_readOpcode(cpu);
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  g_interp816_cur_pc = source;
+  if (opcode != expected_opcode) {
+    fputs("Native control source changed after preflight\n", stderr);abort();
+  }
+  cpu->cyclesUsed = opcode == 0x22 ? 8 : 6;
+  return 1;
+}
+int interp816_native_jsr(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x20)) return 0;
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_jsr(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x20);
+  return cpu->cyclesUsed;
+}
+int interp816_native_jsl(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x22)) return 0;
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_jsl(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x22);
+  return cpu->cyclesUsed;
+}
+int interp816_native_rts(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x60)) return 0;
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_rts(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x60);
+  return cpu->cyclesUsed;
+}
+int interp816_native_rtl(Interp816 *cpu) {
+  if (!interp816_native_control_begin(cpu, 0x6b)) return 0;
+  uint32_t source = ((uint32_t)cpu->k << 16) | (uint16_t)(cpu->pc - 1u);
+  interp816_arch_rtl(cpu);
+  interp_bridge_source_call_interp_exit(cpu, source, 0x6b);
+  return cpu->cyclesUsed;
+}
