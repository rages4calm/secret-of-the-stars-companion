+ * CALL/return sites. No host-C call, return certificate, saved history or owner
+ * inference occurs here: only actual operand fetches and physical stack bytes. */
+static void interp816_arch_jsr(Interp816 *cpu) {
+      uint16_t value = interp816_readOpcodeWord(cpu);
+      /* Permission is issued only AFTER the real operand fetch completed. */
+      interp_bridge_source_call_interp_fetched(cpu,
+          ((uint32_t)cpu->k<<16)|(uint16_t)(cpu->pc-3u),
+          ((uint32_t)cpu->k<<16)|value,2u);
+      interp816_pushWord(cpu, cpu->pc - 1);
+      cpu->pc = value;
+}
+static void interp816_arch_jsl(Interp816 *cpu) {
+      uint16_t value = interp816_readOpcodeWord(cpu);
+      uint8_t newK = interp816_readOpcode(cpu);
+      interp_bridge_source_call_interp_fetched(cpu,
+          ((uint32_t)cpu->k<<16)|(uint16_t)(cpu->pc-4u),
+          ((uint32_t)newK<<16)|value,3u);
+      interp816_pushByte(cpu, cpu->k);
+      interp816_pushWord(cpu, cpu->pc - 1);
+      cpu->pc = value;
+      /* Do not mask PB to 7 bits. JSL $9E:xxxx must keep K=$9E so PHK/PLB
+       * sets DB into the $80-$BF register window (Metal Warriors Konami). */
+      cpu->k = newK;
+}
+static void interp816_arch_rts(Interp816 *cpu) {
+      uint16_t before_s=cpu->sp;
+      uint32_t source=((uint32_t)cpu->k<<16)|(uint16_t)(cpu->pc-1u);
+      uint16_t word=interp816_pullWord(cpu);
+      cpu->pc = word + 1;
+      interp_bridge_source_call_interp_pop(cpu,source,0x60u,before_s,word,cpu->k);
+}
+static void interp816_arch_rtl(Interp816 *cpu) {
+      uint16_t before_s=cpu->sp;
+      uint32_t source=((uint32_t)cpu->k<<16)|(uint16_t)(cpu->pc-1u);
+      uint16_t word=interp816_pullWord(cpu);
+      cpu->pc = word + 1;
+      cpu->k = interp816_pullByte(cpu);
+      interp_bridge_source_call_interp_pop(cpu,source,0x6bu,before_s,word,cpu->k);
+}
