+/* Source-only title opt-in: copied exact ROM bytes, no callback validation,
+ * persistent CPU proof, global exit set or replacement interpreter backend. */
+typedef struct NativeControlSite {
+    uint32_t pc24; uint8_t bytes[4], length;
+    const int *enabled; uint64_t completed; int (*step)(Interp816 *);
+} NativeControlSite;
+static NativeControlSite s_native_control_sites[32];
+static unsigned s_native_control_site_count;
+bool interp_bridge_add_native_control_site(uint32_t pc, const uint8_t *bytes,
+                                           unsigned length, const int *enabled) {
+    if (!bytes || !enabled || pc > 0xffffff || (pc & 0xffff) < 0x8000 ||
+        (pc >> 16) == 0x7e || (pc >> 16) == 0x7f ||
+        length != (bytes[0] == 0x22 ? 4u : bytes[0] == 0x20 ? 3u :
+                  bytes[0] == 0x60 || bytes[0] == 0x6b ? 1u : 0u) ||
+        !length || (pc & 0xffff) + length > 0x10000 ||
+        s_native_control_site_count == 32 || s_pre_opcode_callback_cpu ||
+        s_native_instruction_cpu || s_interp_bus_timing_active) return false;
+    for (unsigned n=0;n<s_native_control_site_count;++n)
+        if (s_native_control_sites[n].pc24 == pc) return false;
+    NativeControlSite *site=&s_native_control_sites[s_native_control_site_count++];
+    site->pc24=pc;site->length=(uint8_t)length;site->enabled=enabled;
+    memcpy(site->bytes,bytes,length);
+    site->step=bytes[0]==0x20?interp816_native_jsr:bytes[0]==0x22?interp816_native_jsl:
+               bytes[0]==0x60?interp816_native_rts:interp816_native_rtl;
+    return true;
+}
+uint64_t interp_bridge_native_control_site_count(uint32_t pc) {
+    for (unsigned n=0;n<s_native_control_site_count;++n)
+        if (s_native_control_sites[n].pc24==pc)return s_native_control_sites[n].completed;
+    return 0;
+}
+static int bridge_try_native_control(CpuState *cpu, Interp816 *in,
+                                     uint32_t pc, uint8_t opcode) {
+    if (cpu!=&g_cpu || in->e || in->stopped || in->waiting || in->nmiWanted ||
+        (!in->i && in->irqWanted)) return 0;
+    for (unsigned n=0;n<s_native_control_site_count;++n) {
+        NativeControlSite *site=&s_native_control_sites[n];
+        if (site->pc24!=pc || *site->enabled!=1 || site->bytes[0]!=opcode)continue;
+        const uint8_t *source=RomPtr(pc);
+        if(!source || memcmp(source,site->bytes,site->length))return 0;
+        int cycles=site->step(in);
+        if(cycles>0)++site->completed;
+        return cycles;
+    }
+    return 0;
+}
