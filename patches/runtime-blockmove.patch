+}
+
+uint16 cpu_aot_get_blockmove_operand(CpuState *cpu,uint32 pc24,uint8 opcode) {
+  aot_require(cpu);
+  /* Readonly already-fetched destination/source bytes; no bus/clocks or authority. */
+  if(s_aot_pc!=pc24 || s_aot_length!=3u || s_aot_fetched[0]!=opcode ||
+     (opcode!=0x44u && opcode!=0x54u) ||
+     (((uint32)cpu->PB<<16)|(pc24&0xffffu))!=pc24) {
+    fputs("Invalid cached blockmove operands\n",stderr);abort();
   }
   return ((uint16)s_aot_fetched[2]<<8)|s_aot_fetched[1];
 }
