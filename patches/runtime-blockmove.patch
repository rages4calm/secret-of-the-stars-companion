diff --git a/recompiler/v2/native_blockmove.py b/recompiler/v2/native_blockmove.py
new file mode 100644
--- /dev/null
+++ b/recompiler/v2/native_blockmove.py
@@ -0,0 +1,39 @@
+"""Source-bound E0 MVN/MVP: one byte, original scheduler re-dispatches each iteration."""
+from snes65816 import IMM,decode_insn,rom_offset
+from snes_cycles import instr_cpu_cycles
+from .ir import BlockMove
+from .lowering import lower
+
+
+def collect_blockmove(rom,key,insn,ops,cycles,*,data_regions=(),exclude_ranges=(),forced=()):
+    if key.m not in(0,1)or key.x not in(0,1)or insn.data_region_exec:return None
+    if getattr(insn,'const_z_fold_unconditional',False)or getattr(insn,'dispatch_entries',None):return None
+    opcode={'MVN':0x54,'MVP':0x44}.get(insn.mnem)
+    if opcode is None or(insn.opcode,insn.mode,insn.length)!=(opcode,IMM,3):return None
+    pc=insn.addr&0xffffff
+    if key.pc&65535!=pc&65535 or pc&65535<0x8000 or pc&65535>0xfffd or pc>>16 in(0x7e,0x7f):return None
+    if(getattr(insn,'m_flag',None),getattr(insn,'x_flag',None))!=(key.m,key.x):return None
+    for byte in range(3):
+        at=(pc&0xff0000)|((pc+byte)&65535)
+        if at&0x7fffff in forced or any(at>>16 in(b,b^128)and lo<=at&65535<hi for b,lo,hi in data_regions)or any(lo<=at&65535<hi for lo,hi in exclude_ranges):return None
+    off=rom_offset(pc>>16,pc&65535)
+    if off<0 or off+3>len(rom):return None
+    decoded=decode_insn(rom,off,pc&65535,pc>>16,key.m,key.x)
+    if decoded is None or(decoded.opcode,decoded.mnem,decoded.mode,decoded.operand,decoded.length)!=(insn.opcode,insn.mnem,insn.mode,insn.operand,insn.length):return None
+    decoded.m_flag,decoded.x_flag=key.m,key.x
+    if len(ops)!=1 or ops!=lower(decoded,value_factory=lambda:None):return None
+    op=ops[0]
+    if not isinstance(op,BlockMove)or op.direction!=('mvn'if opcode==0x54 else'mvp'):return None
+    if cycles!=instr_cpu_cycles(opcode,m=key.m,x=key.x,e=0)or cycles!=7:return None
+    delta='+'if opcode==0x54 else'-'
+    # Original interp816 opcode44/54 fetches destination then source; DB is
+    # visible during the source read/destination write. Count and index changes
+    # follow that write. This is exactly one byte, never a host transfer loop.
+    body=('{ uint16 _move_operand=cpu_aot_get_blockmove_operand(cpu,(((uint32)cpu->PB<<16)|0x%04xu),0x%02xu);\n'
+          'uint8 _move_dst=(uint8)_move_operand,_move_src=(uint8)(_move_operand>>8);\n'
+          'cpu->DB=_move_dst; uint8 _move_byte=cpu_aot_read8(cpu,_move_src,cpu->X);\n'
+          'cpu_aot_write8(cpu,_move_dst,cpu->Y,_move_byte);\n'
+          'cpu->A=(uint16)(cpu->A-1); cpu->X=(uint16)(cpu->X%s1); cpu->Y=(uint16)(cpu->Y%s1);\n'
+          '*next_pc=((uint32)cpu->PB<<16)|(cpu->A!=0xffffu?0x%04xu:0x%04xu);\n'
+          'if(cpu->x_flag){cpu->X&=0x00ffu;cpu->Y&=0x00ffu;} }')%(pc&65535,opcode,delta,delta,pc&65535,(pc+3)&65535)
+    return {'pc24':pc&0x7fffff,'m':key.m,'x':key.x,'length':3,'cycles':cycles,'bytes':rom[off:off+3].hex(),'next_pc':(pc+3)&65535,'body':body,'mnemonic':insn.mnem,'contract':'source-native-e0-blockmove-one-byte-v1','scheduler_repeated_opcode':True,'transferred_bytes_per_instruction':1}
