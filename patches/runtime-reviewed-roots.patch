+++ b/recompiler/v2/reviewed_roots.py
@@ -0,0 +1,203 @@
+"""Strict, metadata-only reviewed analysis roots; never an AOT disposition.
+
+The returned exact VariantKeys join normal additional_roots. Decoder, CFG
+authority, exit facts and faithful emission remain the analyzer's responsibility.
+No private evidence files are needed to use the hash-bound review metadata.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import stat
+
+from .program_analysis import VariantKey
+
+SCHEMA = "snesrecomp reviewed analysis roots v1"
+_HASH = re.compile(r"[0-9a-f]{64}\Z")
+_PC = re.compile(r"[0-9A-F]{6}\Z")
+_REVIEW = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}\Z")
+_REVIEW_KEYS = ("qualified_executable_sha256", "qualification_sha256",
+                "source_capture_identity_sha256")
+_MAX_BYTES = 1024 * 1024
+_MAX_ROOTS = 8192
+
+
+class SingleReviewedManifest(argparse.Action):
+    """A second reviewed manifest is an error, never last-argument-wins."""
+    def __call__(self, parser, namespace, values, option_string=None):
+        if getattr(namespace, self.dest, None) is not None:
+            parser.error("--reviewed-root-manifest may be supplied only once")
+        setattr(namespace, self.dest, values)
+
+
+@dataclass(frozen=True)
+class ReviewedRoots:
+    roots: tuple[VariantKey, ...]
+    path: Path
+    source_sha256: str
+    rom_sha256: str
+    mapper: str
+    module_id: str
+    reviewed_against: tuple[tuple[str, str], ...]
+
+    def metadata(self) -> dict:
+        """JSON-safe provenance; review hashes are identities, not file paths."""
+        return {"schema": SCHEMA, "path": str(self.path),
+                "source_sha256": self.source_sha256,
+                "rom_sha256": self.rom_sha256, "mapper": self.mapper,
+                "module_id": self.module_id,
+                "root_mode_contexts": len(self.roots),
+                "root_pcs": len({key.pc24 for key in self.roots}),
+                "reviewed_against": dict(self.reviewed_against),
+                "review_evidence_policy": "hash-bound metadata; no private file dependency",
+                "admission_policy": "analysis seeds only; analyzer may retain LLE"}
+
+
+def _keys(value, required, label):
+    if not isinstance(value, dict) or set(value) != set(required):
+        raise ValueError(f"reviewed roots: {label} has missing or unknown fields")
+
+
+def _pairs(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError(f"reviewed roots: repeated JSON key {key!r}")
+        result[key] = value
+    return result
+
+
+def _hash(value, label):
+    if not isinstance(value, str) or not _HASH.fullmatch(value) or value == "0" * 64:
+        raise ValueError(f"reviewed roots: invalid {label}")
+    return value
+
+
+def _no_links(path: Path):
+    # Walk lexical parents before resolve(), which would conceal a link.
+    for part in (path, *path.parents):
+        info = part.lstat()
+        if stat.S_ISLNK(info.st_mode) or getattr(info, "st_file_attributes", 0) & 0x400:
+            raise ValueError(f"reviewed roots: linked/reparse path is forbidden: {part}")
+
+
+def _read_manifest(manifest_path, cfg_dir):
+    cfg = Path(cfg_dir).expanduser()
+    path = Path(manifest_path).expanduser()
+    if ".." in cfg.parts or ".." in path.parts:
+        raise ValueError("reviewed roots: parent traversal is forbidden")
+    cfg = Path(os.path.abspath(cfg))
+    path = Path(os.path.abspath(path))
+    if any(":" in part for part in path.parts[1:]):
+        raise ValueError("reviewed roots: alternate stream path is forbidden")
+    _no_links(cfg)
+    _no_links(path)
+    if not cfg.is_dir() or not path.is_relative_to(cfg):
+        raise ValueError("reviewed roots: input must be inside cfg-dir")
+    if path.suffix != ".json" or not path.resolve().is_relative_to(cfg.resolve()):
+        raise ValueError("reviewed roots: expected cfg-dir-contained JSON file")
+    before = path.stat()
+    if not stat.S_ISREG(before.st_mode) or not 0 < before.st_size <= _MAX_BYTES:
+        raise ValueError("reviewed roots: input is not a bounded regular file")
+    # Recheck opened identity and path to refuse replacement/link races.
+    fd = os.open(path, os.O_RDONLY | getattr(os, "O_BINARY", 0) | getattr(os, "O_NOFOLLOW", 0))
+    with os.fdopen(fd, "rb") as stream:
+        opened = os.fstat(stream.fileno())
+        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (
+                opened.st_dev, opened.st_ino, opened.st_size, opened.st_mtime_ns):
+            raise ValueError("reviewed roots: input changed before reading")
+        raw = stream.read(_MAX_BYTES + 1)
+        after = os.fstat(stream.fileno())
+    _no_links(path)
+    current = path.stat()
+    identity = lambda s: (s.st_dev, s.st_ino, s.st_size, s.st_mtime_ns)
+    if identity(opened) != identity(after) or identity(after) != identity(current) or len(raw) != opened.st_size:
+        raise ValueError("reviewed roots: input changed while reading")
+    value = json.loads(raw.decode("utf-8"), object_pairs_hook=_pairs,
+                       parse_constant=lambda value: (_ for _ in ()).throw(
+                           ValueError("reviewed roots: nonfinite JSON number")))
+    return path, raw, value
+
+
+def _canonical(pc):
+    bank, offset = pc >> 16, pc & 0xffff
+    if 0x80 <= bank <= 0xbf and offset >= 0x8000:
+        return pc & 0x7fffff
+    return pc
+
+
+def _blocked(pc, parsed):
+    canonical = _canonical(pc)
+    for bank, _path, cfg in parsed:
+        if canonical in {_canonical(int(entry)) for entry in cfg.force_lle}:
+            return "force_lle"
+        ranges = [(bank, a, b) for a, b in cfg.authority_data]
+        ranges += [(bank, a, b) for a, b in cfg.exclude_ranges]
+        ranges += list(cfg.data_regions)
+        for region_bank, start, end in ranges:
+            region_pc = _canonical((region_bank << 16) | start)
+            if canonical >> 16 == region_pc >> 16 and start <= (canonical & 0xffff) < end:
+                return "CFG data/exclusion range"
+    return None
+
+
+def load_reviewed_roots(manifest_path, *, cfg_dir, parsed, expected_rom,
+                        expected_module, expected_mapper, rom_size) -> ReviewedRoots:
+    """Validate without running the analyzer or writing files.
+
+    ``parsed`` is the existing tools.v2_analyze._load_cfgs(cfg_dir) result.
+    This version deliberately supports canonical LoROM native-E0 seeds only.
+    Other mappers require a separately reviewed canonical-address contract.
+    """
+    path, raw, value = _read_manifest(manifest_path, cfg_dir)
+    _keys(value, ("schema", "rom_sha256", "mapper", "module_id", "reviewed_against", "roots"), "document")
+    if value["schema"] != SCHEMA:
+        raise ValueError("reviewed roots: unsupported schema")
+    rom_hash = _hash(value["rom_sha256"], "rom_sha256")
+    if rom_hash != expected_rom or value["module_id"] != expected_module:
+        raise ValueError("reviewed roots: ROM/module identity mismatch")
+    if value["mapper"] != "lorom" or expected_mapper != "lorom":
+        raise ValueError("reviewed roots: only the reviewed LoROM mapper contract is supported")
+    if type(rom_size) is not int or not 0 < rom_size <= 0x400000:
+        raise ValueError("reviewed roots: invalid LoROM image size")
+    review = value["reviewed_against"]
+    _keys(review, _REVIEW_KEYS, "reviewed_against")
+    review = tuple((key, _hash(review[key], key)) for key in _REVIEW_KEYS)
+    rows = value["roots"]
+    if not isinstance(rows, list) or not 0 < len(rows) <= _MAX_ROOTS:
+        raise ValueError("reviewed roots: expected bounded nonempty roots array")
+    roots, seen, reviews = [], set(), set()
+    for row in rows:
+        _keys(row, ("pc24", "m", "x", "emulation", "review_id"), "root")
+        text = row["pc24"]
+        if not isinstance(text, str) or not _PC.fullmatch(text):
+            raise ValueError("reviewed roots: pc24 must be uppercase six-digit hex")
+        pc = int(text, 16)
+        bank, offset = pc >> 16, pc & 0xffff
+        if (offset < 0x8000 or bank in (0x7e, 0x7f) or
+                not (bank < 0x40 or bank >= 0xc0) or _canonical(pc) != pc or
+                (bank & 0x7f) * 0x8000 + offset - 0x8000 >= rom_size):
+            raise ValueError(f"reviewed roots: {text} is not a canonical in-image LoROM entry")
+        if any(type(row[k]) is not int or row[k] not in (0, 1) for k in ("m", "x")):
+            raise ValueError("reviewed roots: M/X must be literal integer 0 or 1")
+        if type(row["emulation"]) is not int or row["emulation"] != 0:
+            raise ValueError("reviewed roots: only literal native emulation=0 is supported")
+        review_id = row["review_id"]
+        if not isinstance(review_id, str) or not _REVIEW.fullmatch(review_id) or review_id in reviews:
+            raise ValueError("reviewed roots: invalid or duplicate review_id")
+        key = VariantKey(pc, row["m"], row["x"])
+        if key in seen:
+            raise ValueError("reviewed roots: duplicate PC/M/X context")
+        reason = _blocked(pc, parsed)
+        if reason:
+            raise ValueError(f"reviewed roots: {text} is quarantined by {reason}")
+        seen.add(key)
+        reviews.add(review_id)
+        roots.append(key)
+    return ReviewedRoots(tuple(sorted(roots)), path, hashlib.sha256(raw).hexdigest(),
+                         rom_hash, value["mapper"], value["module_id"], review)
