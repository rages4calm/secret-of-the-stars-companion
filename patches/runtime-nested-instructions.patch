+"""Next source-known direct-call callee/return instruction wave; no exit facts."""
+from snes65816 import decode_insn,rom_offset
+from .architecture_callee_sources import derive as derive_callees
+from .architecture_mode_sources import derive as derive_modes
+from .decoder import decode_function
+from .emit_function import emit_function
+BARRIERS={'PLP','RTI','TCS','TXS','XCE','MVN','MVP','RTS','RTL'}
+
+def derive(rom,parsed,*,enable_native_call_prefix=True):
+    from .architecture_eligibility import _independent,_mask
+    cfg={b:c for b,_p,c in parsed}
+    if len(cfg)!=len(parsed):raise ValueError('duplicate nested source bank')
+    masks=[r for c in cfg.values()for r in c.data_regions]+[(c.bank,a,b)for c in cfg.values()for a,b in c.authority_data+c.exclude_ranges]
+    forced={p&0x7fffff for c in cfg.values()for p in c.force_lle}
+    source=derive_callees(rom,parsed,enable_native_call_prefix=True)[0]+derive_modes(rom,parsed,enable_native_call_prefix=True)[0]
+    entries={};source_calls=[]
+    for call in source:
+        if not call.get('original_scheduler_call'):continue
+        if not _independent(rom,parsed,call):continue
+        pc=call['pc24'];off=rom_offset(pc>>16,pc&65535);ins=decode_insn(rom,off,pc&65535,pc>>16,call['m'],call['x'])
+        target=((pc&0xff0000)|ins.operand)if ins and ins.mnem=='JSR'else(ins.operand if ins else None)
+        if not ins or ins.mnem not in('JSR','JSL')or ins.length!=call['length']or rom[off:off+ins.length].hex()!=call['bytes']or target!=call['next_pc']:raise ValueError('nested source original call')
+        if (pc&65535)+ins.length>=65536:raise ValueError('nested return-start wrap')
+        ret=(pc&0xff0000)|((pc&65535)+ins.length)
+        source_calls.append({k:call[k]for k in('pc24','m','x','bytes','length','next_pc')})
+        for kind,start in(('callee',target),('return',ret)):
+            if not _mask(parsed,start,1):entries.setdefault((kind,start),set()).add(pc)
+    rows={};graphs=[]
+    for(kind,start),origins in sorted(entries.items()):
+        bank=start>>16
+        if bank not in cfg or start&65535<0x8000:raise ValueError('nested source mapped target')
+        for m,x in((0,0),(0,1),(1,0),(1,1)):
+            g=decode_function(rom,bank,start&65535,m,x,max_insns=128,data_regions=masks,stop_on_unknown_callee_exit=True)
+            if g.authority_conflict or g.data_region_exec_pcs or len(g.insns)>=128:raise ValueError('nested instruction source authority')
+            local=[];calls=[];c=cfg[bank]
+            emit_function(rom,bank,start&65535,m,x,func_name='DiscardedNestedSourceInstructions',data_regions=masks,exclude_ranges=c.exclude_ranges,hle_func=c.hle_func,hle_spc_upload=c.hle_spc_upload,source_task_resume_stops=g.unknown_callee_exit_sites,native_region_collector=local,native_call_prefix_collector=calls if enable_native_call_prefix else None,native_call_prefix_forced=forced,_native_collector_only=True)
+            supported={tuple(r[k]for k in('pc24','m','x'))for r in local+calls if _independent(rom,parsed,r)};todo=[g.entry];allowed=set();barriers=[]
+            while todo:
+                key=todo.pop()
+                if key in allowed:continue
+                d=g.insns.get(key)
+                if not d:continue
+                if d.insn.data_region_exec or d.insn.mnem in BARRIERS or (key.pc,key.m,key.x)not in supported or getattr(d.insn,'const_z_fold_unconditional',False):barriers.append([key.pc,key.m,key.x,d.insn.mnem]);continue
+                allowed.add(key)
+                if d.insn.mnem not in('JSR','JSL'):todo.extend(d.successors)
+            members={(k.pc,k.m,k.x)for k in allowed};keys=[]
+            for r in local+calls:
+                k=tuple(r[v]for v in('pc24','m','x'))
+                if k not in members:continue
+                if k in rows and rows[k]!=r:raise ValueError('unequal nested-source live body')
+                rows[k]=r;keys.append(list(k))
+            graphs.append({'source_calls':sorted(origins),'source_kind':kind,'source_start':start,'parameter_m':m,'parameter_x':x,'instruction_keys':keys,'barriers':barriers,'unknown_calls':[list(v)for v in sorted(g.unknown_callee_exit_sites)],'unresolved_indirects':len(g.unresolved_indirects),'callee_exit_modes_added':False,'caller_owner_added':False})
+    return [rows[k]for k in sorted(rows)],{'source_calls':source_calls,'graphs':graphs,'callee_exit_modes_added':False,'caller_owner_added':False}
