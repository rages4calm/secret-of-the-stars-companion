+def _faithful_accumulator_shift(insn) -> bool:
+    """Admit only exact one-byte accumulator shifts; memory RMW stays original."""
+    expected = {0x0A: 'ASL', 0x4A: 'LSR', 0x2A: 'ROL', 0x6A: 'ROR'}
+    opcode = getattr(insn, 'opcode', None)
+    return (getattr(insn, 'mode', -1) == _MODE_ACC
+            and getattr(insn, 'length', None) == 1
+            and opcode in expected
+            and getattr(insn, 'mnem', None) == expected[opcode]
+            and getattr(insn, 'm_flag', None) in (0, 1)
+            and getattr(insn, 'x_flag', None) in (0, 1))
 
 
