+    if(read && (transfer==NATIVE_BLOCK_TRANSFER_RETURN_SHORT || transfer==NATIVE_BLOCK_TRANSFER_RETURN_LONG)) {
+        unsigned wanted=transfer==NATIVE_BLOCK_TRANSFER_RETURN_LONG?3:2;
+        if(s->return_count<wanted) {
