+def main():
+    parser=argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--rom',required=True,type=Path);parser.add_argument('--out',required=True,type=Path)
+    parser.add_argument('--symbol',default='sots_arch78')
+    parser.add_argument('--keys',type=Path,help='Explicit JSON list of [pc24,m,x,e] architectural discovery keys; absent means frozen reset slice')
