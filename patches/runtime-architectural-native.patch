+    patches=json.loads(args.patches.read_text(encoding='utf-8')) if args.patches else ()
+    source=emit_native_blocks(args.rom.read_bytes(),symbol=args.symbol,profile=args.profile,keys=keys,include_reset=args.include_reset,patches=patches)
