+    bool (*admit)(void*, const struct NativeBlockProgram*, CpuState*, const NativeBlockInstruction*);
+    bool (*mapping)(void*, CpuState*, const NativeBlockInstruction*);
+    /* Bus operations are total once admitted. They preserve actual device
