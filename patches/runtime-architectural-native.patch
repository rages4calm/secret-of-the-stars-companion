+        text.append('''static uint8_t nb69_pull(NativeBlockScope *s,CpuState *cpu) {
+  cpu->S=(uint16_t)(cpu->S+1);if(cpu->emulation)cpu->S=(cpu->S&255)|0x100;
+  return nb69_read8(s,cpu,0,cpu->S);
+}''')
+    memory_ops=[op for b in blocks if b.p_mask==0 for op in b.ops if isinstance(op,(Read,Write,IncMem,BitSetMem,BitClearMem))]
+    indirect_memory=(SegKind.DP_INDIRECT,SegKind.DP_INDIRECT_X,SegKind.DP_INDIRECT_LONG,SegKind.STACK_REL_INDIRECT_Y)
