+  scope.cpu_cycles=instruction->base_cpu_cycles;scope.next_pc24=(key.pc24&0xff0000u)|((key.pc24+instruction->length)&0xffffu);
+  host->begin(host->context,cpu,instruction,scope.prior_master);
+  uint64_t fetch_extra=0;
+  for(unsigned i=0;i<instruction->length;i++)fetch_extra+=host->region_speed(host->context,((key.pc24&0xff0000)|((key.pc24+i)&65535)))-6;
+  cpu->coprocessor_master_cycles=scope.prior_master;cpu->open_bus=instruction->bytes[instruction->length-1];
+  instruction->execute(cpu,&scope);cpu_mirrors_to_p(cpu);
+  uint64_t opcode_master=(uint64_t)scope.cpu_cycles*6+scope.data_extra+fetch_extra;
+  cpu->cycles+=scope.cpu_cycles;cpu->master_cycles+=opcode_master;
+  host->commit(host->context,cpu,instruction,scope.prior_master,opcode_master,scope.wrote_memory);
+  host->end(host->context,cpu,instruction);
+  return nb69_result(nb69_next(cpu,scope.next_pc24,key.profile),scope.action,NATIVE_BLOCK_FAULT_NONE,1);
+}
+static NativeBlockResult nb69_run(const NativeBlockProgram *program,const NativeBlockHost *host,
+                                 CpuState *cpu,NativeBlockKey key,uint64_t deadline,uint64_t limit) {
+  uint64_t count=0;
+  while(count<limit){NativeBlockResult r=program->step(program,host,cpu,key,deadline);count+=r.executed;key=r.next;
+    if(r.action!=NATIVE_BLOCK_CONTINUE){r.executed=count;return r;}}
+  return nb69_result(key,NATIVE_BLOCK_STEP_LIMIT,NATIVE_BLOCK_FAULT_NONE,count);
+}
