--- /dev/null
+++ b/recompiler/v2/emit_native_blocks.py
@@ -0,0 +1,506 @@
+"""Additive typed-IR native reset blocks, independent of CPU interpretation.
+
+First finite backend: the actual reset graph from start to an explicit stop.
+Runtime dispatch uses PC/M/X/E/profile keys, never an opcode switch. Ordinary
+IR lowers through the established v2 emitter; architectural branches and block
+boundaries use an iterative next-PC ABI. Unsupported semantics fail generation.
+This prototype intentionally does not change emit_function/codegen or claim
+native closure beyond the declared graph.
+"""
+from __future__ import annotations
+import argparse
+from dataclasses import dataclass
+import hashlib
+import itertools
+import json
+from pathlib import Path
+import re
+import sys
+
+RECOMPILER=Path(__file__).resolve().parents[1]
+if str(RECOMPILER) not in sys.path:sys.path.insert(0,str(RECOMPILER))
+from v2.decoder import decode_function
+from v2.cfg import build_cfg
+from v2.lowering import lower
+from v2.codegen import emit_op, _reg, _v
+from v2.ir import (Value, CondBranch, SetFlag, Reg, XCE, Goto, IndirectGoto, Call, Return,
+    PushReg, PullReg, RepFlags, SepFlags, Read, Write, SegKind, IncMem, BitSetMem, BitClearMem, Nop, Transfer, PushEffectiveAddress, BlockMove)
+from snes65816 import rom_offset, decode_insn, LONG
+from snes_cycles import instr_cpu_cycles, instr_runtime_charges
+
+ALLOWED_IR=frozenset({'ConstI','ReadReg','WriteReg','Read','Write','Alu','SetFlag',
+    'SetNZ','IncReg','Transfer','PushReg','PullReg','RepFlags','SepFlags','XBA','XCE',
+    'CondBranch','Goto','IndirectGoto','Call','Return','Shift','IncMem','BitTest',
+    'BitSetMem','BitClearMem','Nop','PushEffectiveAddress','BlockMove'})
+
+@dataclass(frozen=True)
+class Block:
+    pc: int
+    m: int
+    x: int
+    e: int
+    insn: object
+    ops: tuple
+    p_mask: int
+    p_value: int
+
+def architecture_blocks(rom: bytes, keys):
+    """Compile explicit source/mode discovery keys without inferring callers.
+
+    Keys are (pc24,m,x,e). They do not assert observed I/D/C values. Runtime
+    transfers produce their actual next key, including an explicit MISSING
+    result for targets not in this source profile. A caller may iteratively
+    supply newly discovered keys; this never decodes an opcode at runtime.
+    Approved patched images must be separate explicit profile inputs.
+    """
+    blocks=[]
+    for pc,m,x,e in sorted(set(tuple(key) for key in keys)):
+        if not 0<=pc<=0xffffff or any(v not in (0,1) for v in (m,x,e)) or (e and (not m or not x)):
+            raise ValueError('Invalid architectural native key')
+        offset=rom_offset(pc>>16,pc&65535)
+        if offset is None or offset<0 or offset>=len(rom):raise ValueError('Unmaterialized source key')
+        try:insn=decode_insn(rom,offset,pc&65535,pc>>16,m,x)
+        except IndexError as error:raise ValueError('Truncated native source') from error
+        if insn is None:raise ValueError('Unknown native opcode')
+        insn.m_flag=m;insn.x_flag=x
+        counter=itertools.count();ops=tuple(lower(insn,value_factory=lambda:Value(next(counter))))
+        if not ops or any(type(op).__name__ not in ALLOWED_IR for op in ops):
+            raise ValueError(f'Unsupported architectural IR at {pc:06X}')
+        if e and any(isinstance(op,Return) and op.interrupt for op in ops):
+            raise ValueError('E1 RTI requires independent architectural frame qualification')
+        if e and any(isinstance(op,Transfer) and op.dst==Reg.S for op in ops):
+            raise ValueError('E1 stack-pointer transfer requires independent architectural reference')
+        if any(isinstance(op,Nop) for op in ops) and insn.opcode not in (0xea,0x42):
+            raise ValueError('Unmodeled instruction is not an architectural NOP')
+        if e and any(isinstance(op,CondBranch) for op in ops) and (((pc+insn.length)^insn.operand)&0xff00):
+            raise ValueError('Emulation page-cross branch requires independent clock qualification')
+        blocks.append(Block(pc,m,x,e,insn,ops,0,0))
+    if not blocks:raise ValueError('Empty architectural native profile')
+    return blocks
+
+def _address(block,seg):
+    """Emit one ordered effective-address evaluation from the typed SegRef.
+
+    Explicit low/high addresses preserve bank0 wrap for DP/stack and full24
+    carry for DB/long data. Indirection is sequenced once, never duplicated
+    through unspecified C argument evaluation order.
+    """
+    k=seg.kind;o=seg.offset
+    idx='cpu->Y' if k==SegKind.STACK_REL_INDIRECT_Y else (_reg(seg.index) if seg.index else '0')
+    out=[];wrapped=False;cross_base=None
+    if k==SegKind.DIRECT:base=f'(uint16_t)(cpu->D+0x{o:04x}u+{idx})';wrapped=True
+    elif k==SegKind.STACK:base=f'(uint16_t)(cpu->S+0x{o:04x}u)';wrapped=True
+    elif k==SegKind.ABS_BANK:
+        base=f'(((uint32_t)cpu->DB<<16)+0x{o:04x}u+{idx})&0xffffffu'
+        if seg.index:cross_base=f'0x{o:04x}u'
+    elif k==SegKind.LONG:base=f'(0x{((seg.bank or 0)<<16)|o:06x}u+{idx})&0xffffffu'
+    elif k in (SegKind.DP_INDIRECT,SegKind.DP_INDIRECT_X,SegKind.DP_INDIRECT_LONG,SegKind.STACK_REL_INDIRECT_Y):
+        if k==SegKind.STACK_REL_INDIRECT_Y:pointer=f'(uint16_t)(cpu->S+0x{o:04x}u)'
+        elif k==SegKind.DP_INDIRECT_X:pointer=f'(uint16_t)(cpu->D+0x{o:04x}u+cpu->X)'
+        else:pointer=f'(uint16_t)(cpu->D+0x{o:04x}u)'
+        out += [f'uint16_t pointer={pointer};',
+                'uint32_t indirect=nb69_read_pointer(scope,cpu,pointer,(uint16_t)(pointer+1));']
+        if k==SegKind.DP_INDIRECT_LONG:
+            out.append('indirect|=(uint32_t)nb69_read8(scope,cpu,0,(uint16_t)(pointer+2))<<16;')
+            base=f'(indirect+{idx})&0xffffffu'
+        else:
+            base=f'(((uint32_t)cpu->DB<<16)+indirect+{idx})&0xffffffu'
+            if k==SegKind.DP_INDIRECT and seg.index:cross_base='indirect'
+    else:raise ValueError(f'Unqualified native memory address kind {k}')
+    out.append(f'uint32_t low={base};')
+    out.append('uint32_t high=(uint16_t)(low+1);' if wrapped else 'uint32_t high=(low+1)&0xffffffu;')
+    if instr_runtime_charges(block.insn.opcode,block.x).get('xcross'):
+        if cross_base is None:raise ValueError('Missing indexed crossing predicate')
+        out.append(f'if(({cross_base}>>8)!=(({cross_base}+{idx})>>8))scope->cpu_cycles+=1;')
+    return out
+
+def _stack_width(block,reg):
+    if reg==Reg.A:return 1 if block.m else 2
+    if reg in (Reg.X,Reg.Y):return 1 if block.x else 2
+    return 2 if reg==Reg.D else 1
+
+def materialize_profile(rom: bytes, patches):
+    """Apply explicit before/after spans; never infer approval from live bytes.
+
+    Each JSON-compatible row is {rom_offset:int, original:hex, runtime:hex}.
+    Spans are equal-length, nonempty, disjoint and fully source-attested.
+    The original whole-ROM digest remains the program's registration identity.
+    """
+    image=bytearray(rom);normalized=[];last_end=0
+    for row in sorted(patches,key=lambda r:r['rom_offset']):
+        offset=row['rom_offset']
+        if type(offset) is not int or offset<0:raise ValueError('Invalid profile patch offset')
+        try:before=bytes.fromhex(row['original']);after=bytes.fromhex(row['runtime'])
+        except (TypeError,ValueError) as error:raise ValueError('Invalid profile patch bytes') from error
+        if not before or len(before)!=len(after) or offset+len(before)>len(rom):
+            raise ValueError('Invalid profile patch span')
+        if offset<last_end:raise ValueError('Overlapping profile patch spans')
+        if rom[offset:offset+len(before)]!=before:raise ValueError('Original profile patch bytes differ')
+        if before==after:raise ValueError('Profile patch must declare an actual source difference')
+        normalized.append((offset,before,after));image[offset:offset+len(after)]=after
+        last_end=offset+len(before)
+    return bytes(image),normalized
+
+def reset_blocks(rom: bytes, bank=0, start=0x8013, end=0x8059):
+    """Build source-authoritative instruction blocks; no runtime CPU decoder.
+
+    Current finite admission supports the real cold-reset CLC/XCE transition.
+    A compile-time carry proof admits XCE only with C=0. Extra E1 entries before
+    that transition cover actual architectural cold boot. This is not a claim
+    that arbitrary E1 code after XCE has already been qualified.
+    """
+    graph=decode_function(rom,bank,start,1,1,end=end)
+    if graph.authority_conflict:raise ValueError('Conflicting instruction/data authority')
+    cfg=build_cfg(graph,instruction_blocks=True)
+    if not cfg.blocks:raise ValueError('Empty native block graph')
+    blocks=[]
+    for key,block in sorted(cfg.blocks.items(),key=lambda row:(row[0].pc,row[0].m,row[0].x)):
+        if len(block.insns)!=1:raise ValueError('Expected exact instruction blocks')
+        di=block.insns[0];insn=di.insn
+        counter=itertools.count()
+        ops=tuple(lower(insn,value_factory=lambda:Value(next(counter))))
+        unknown=[type(op).__name__ for op in ops if type(op).__name__ not in ALLOWED_IR]
+        if unknown:raise ValueError(f'Unsupported native IR at {insn.addr:06X}: {unknown}')
+        if any(getattr(op,'noreturn',False) for op in ops):raise ValueError('Unsupported control policy')
+        for op in ops:
+            # Reset's pushes/pulls are byte-width and occur after leaving E1.
+            if type(op).__name__ in ('PushReg','PullReg') and getattr(op,'reg',None)==Reg.A and getattr(op,'static_m',None)!=1:
+                raise ValueError('Word stack bus ordering not qualified in this finite slice')
+        pc=insn.addr&0xffffff
+        e_values=[0]
+        p_mask,p_value=0x0c,4   # observed cold-reset contract: I=1, decimal clear
+        if isinstance(ops[0],XCE):
+            previous=graph.insns.get(next((k for k in graph.insns if k.pc==key.pc-1 and k.m==key.m and k.x==key.x),None))
+            if not previous or previous.insn.mnem!='CLC':raise ValueError('XCE needs a proven cold-reset CLC predecessor')
+            p_mask|=1
+            e_values=[0,1]
+        elif key.pc==start:
+            if len(ops)!=1 or not isinstance(ops[0],SetFlag) or ops[0].flag!=Reg.C or ops[0].value!=0:
+                raise ValueError('Cold reset must begin with actual CLC')
+            e_values=[0,1]
+        charges=instr_runtime_charges(insn.opcode,key.x)
+        if charges.get('xcross'):raise ValueError('Indexed read cycle proof outside current reset slice')
+        for e in e_values:
+            if e and (key.m!=1 or key.x!=1):raise ValueError('Invalid emulation width key')
+            blocks.append(Block(pc,key.m,key.x,e,insn,ops,p_mask,p_value))
+    return sorted(blocks,key=lambda b:(b.pc,b.m,b.x,b.e))
+
+def _effect(block: Block):
+    out=[];addressed=False
+    for op in block.ops:
+        if isinstance(op,PushEffectiveAddress):
+            # Source-known PEA/PER literal or PEI direct-page word. Each
+            # instruction pushes high then low through the real stack bus.
+            if block.insn.opcode in (0xf4,0x62):
+                out.append(f'uint16_t value=0x{block.insn.operand&65535:04x}u;')
+            elif block.insn.opcode==0xd4:
+                out += [f'uint16_t pointer=(uint16_t)(cpu->D+0x{block.insn.operand:04x}u);',
+                        'uint16_t value=nb69_read_pointer(scope,cpu,pointer,(uint16_t)(pointer+1));']
+            else:raise ValueError('Unknown effective-address push opcode')
+            out += ['nb69_push(scope,cpu,(uint8_t)(value>>8));',
+                    'nb69_push(scope,cpu,(uint8_t)value);']
+            continue
+        if isinstance(op,BlockMove):
+            # One original MVN/MVP iteration per architectural step. Returning
+            # the same actual PC makes deadline/IRQ admission interruptible.
+            if op.direction not in ('mvn','mvp'):raise ValueError('Unknown block-move direction')
+            delta=1 if op.direction=='mvn' else -1
+            out += [f'cpu->DB=0x{op.dst_bank:02x}u;',
+                    f'uint8_t value=nb69_read8(scope,cpu,0x{op.src_bank:02x}u,cpu->X);',
+                    f'nb69_write8(scope,cpu,0x{op.dst_bank:02x}u,cpu->Y,value);',
+                    'cpu->A=(uint16_t)(cpu->A-1);',
+                    f'cpu->X=(uint16_t)(cpu->X+({delta}));cpu->Y=(uint16_t)(cpu->Y+({delta}));',
+                    f'if(cpu->A!=0xffffu)scope->next_pc24=0x{block.pc:06x}u;',
+                    'if(cpu->x_flag){cpu->X&=255;cpu->Y&=255;}']
+            continue
+        if isinstance(op,Nop):
+            if block.insn.opcode not in (0xea,0x42):raise ValueError('Unmodeled NOP fallthrough')
+            continue
+        if block.p_mask==0 and isinstance(op,XCE):
+            out += ['uint8_t old_e=cpu->emulation;cpu->emulation=cpu->_flag_C;cpu->_flag_C=old_e;',
+                    'if(cpu->emulation){cpu->m_flag=cpu->x_flag=1;cpu->X&=255;cpu->Y&=255;cpu->S=(cpu->S&255)|0x100;}']
+            continue
+        if block.e and isinstance(op,(RepFlags,SepFlags)):
+            expr=f'cpu->P&~0x{op.mask:02x}u' if isinstance(op,RepFlags) else f'cpu->P|0x{op.mask:02x}u'
+            out += [f'cpu->P=(uint8_t)({expr})|0x30u;cpu_p_to_mirrors(cpu);']
+            continue
+        if block.e and isinstance(op,Transfer) and op.dst==Reg.S:
+            out.append(f'cpu->S=({_reg(op.src)}&255)|0x100;')
+            continue
+        if block.p_mask==0 and isinstance(op,(PushReg,PullReg)):
+            field=_reg(op.reg);width=_stack_width(block,op.reg)
+            if isinstance(op,PushReg):
+                if op.reg==Reg.P:out.append('cpu_mirrors_to_p(cpu);')
+                if width==2:out.append(f'nb69_push(scope,cpu,(uint8_t)({field}>>8));')
+                out.append(f'nb69_push(scope,cpu,(uint8_t){field});')
+            else:
+                out.append('uint16_t value=nb69_pull(scope,cpu);')
+                if width==2:out.append('value|=(uint16_t)nb69_pull(scope,cpu)<<8;')
+                if op.reg==Reg.P:
+                    out += ['cpu->P=(uint8_t)value;if(cpu->emulation)cpu->P|=0x30;cpu_p_to_mirrors(cpu);']
+                else:
+                    if op.reg==Reg.A and width==1:out.append('cpu->A=(cpu->A&0xff00)|value;')
+                    else:out.append(f'{field}=value;')
+                    out += ['cpu->_flag_Z=value==0;',f'cpu->_flag_N=(value&0x{(0x80 if width==1 else 0x8000):04x}u)!=0;']
+            continue
+        if block.p_mask==0 and isinstance(op,(Read,Write,IncMem,BitSetMem,BitClearMem)):
+            if not addressed:
+                out+=_address(block,op.seg);out.append('(void)high;');addressed=True
+            read='nb69_read8(scope,cpu,(uint8_t)(low>>16),(uint16_t)low)' if op.width==1 else 'nb69_read_pointer(scope,cpu,low,high)'
+            reversed_write=any(type(v).__name__=='Shift' for v in block.ops) or isinstance(op,(IncMem,BitSetMem,BitClearMem))
+            def write(value):
+                if op.width==1:return f'nb69_write8(scope,cpu,(uint8_t)(low>>16),(uint16_t)low,(uint8_t)({value}));'
+                return f'nb69_write_pair(scope,cpu,low,high,(uint16_t)({value}),{"true" if reversed_write else "false"});'
+            if isinstance(op,Read):out.append(f'uint{op.width*8}_t {_v(op.out)}={read};')
+            elif isinstance(op,Write):out.append(write(_v(op.src)))
+            else:
+                out.append(f'uint{op.width*8}_t value={read};')
+                if isinstance(op,IncMem):
+                    out += [f'value=(uint{op.width*8}_t)(value+({op.delta}));',
+                            'cpu->_flag_Z=value==0;',f'cpu->_flag_N=(value&0x{(0x80 if op.width==1 else 0x8000):04x}u)!=0;']
+                else:
+                    out.append('cpu->_flag_Z=(value&cpu->A)==0;')
+                    expr='value|cpu->A' if isinstance(op,BitSetMem) else 'value&~cpu->A'
+                    out.append(f'value=(uint{op.width*8}_t)({expr});')
+                out.append(write('value'))
+            continue
+        if isinstance(op,Return):
+            if op.interrupt:
+                if block.e:raise ValueError('E1 RTI has no qualified architectural frame lowering')
+                out += ['cpu->P=nb69_pull(scope,cpu);cpu_p_to_mirrors(cpu);',
+                        'uint16_t target=nb69_pull(scope,cpu);',
+                        'target|=(uint16_t)nb69_pull(scope,cpu)<<8;',
+                        'cpu->PB=nb69_pull(scope,cpu);',
+                        'scope->next_pc24=((uint32_t)cpu->PB<<16)|target;']
+                continue
+            out += ['uint16_t target=nb69_pull(scope,cpu);',
+                    'target|=(uint16_t)nb69_pull(scope,cpu)<<8;',
+                    'target=(uint16_t)(target+1);']
+            if op.long:out.append('cpu->PB=nb69_pull(scope,cpu);')
+            out.append('scope->next_pc24=((uint32_t)cpu->PB<<16)|target;')
+            continue
+        if isinstance(op,Call):
+            if op.indirect:
+                out += [f'uint16_t pointer=(uint16_t)(0x{op.table_base:04x}u+cpu->X);',
+                        'uint16_t target=nb69_read_pointer(scope,cpu,((uint32_t)cpu->PB<<16)|pointer,((uint32_t)cpu->PB<<16)|(uint16_t)(pointer+1));']
+            if op.long:out.append('nb69_push(scope,cpu,cpu->PB);')
+            ret=(block.pc+block.insn.length-1)&65535
+            out += [f'nb69_push(scope,cpu,0x{ret>>8:02x}u);',f'nb69_push(scope,cpu,0x{ret&255:02x}u);']
+            if op.indirect:out.append('scope->next_pc24=((uint32_t)cpu->PB<<16)|target;')
+            else:
+                out.append(f'scope->next_pc24=0x{op.target:06x}u;')
+                if op.long:out.append(f'cpu->PB=0x{op.target>>16:02x}u;')
+            continue
+        if isinstance(op,IndirectGoto):
+            # Original JMP(abs)/JML[abs] pointers are in bank0; indexed
+            # JMP(abs,X) pointer bytes are in the actual program bank.
+            pointer=block.insn.operand&65535
+            if block.insn.opcode==0x7c:
+                out += [f'uint16_t pointer=(uint16_t)(0x{pointer:04x}u+cpu->X);',
+                        'uint32_t low=((uint32_t)cpu->PB<<16)|pointer;',
+                        'uint32_t high=((uint32_t)cpu->PB<<16)|(uint16_t)(pointer+1);']
+            elif block.insn.opcode in (0x6c,0xdc):
+                out += [f'uint32_t low=0x{pointer:04x}u,high=0x{(pointer+1)&65535:04x}u;']
+            else:raise ValueError('Unknown indirect architectural jump')
+            out.append('uint16_t target=nb69_read_pointer(scope,cpu,low,high);')
+            if block.insn.opcode==0xdc:out.append(f'cpu->PB=nb69_read8(scope,cpu,0,0x{(pointer+2)&65535:04x}u);')
+            out.append('scope->next_pc24=((uint32_t)cpu->PB<<16)|target;')
+            continue
+        if isinstance(op,Goto):
+            target=block.insn.operand
+            if block.insn.mode!=LONG:target=(block.pc&0xff0000)|(target&65535)
+            out.append(f'scope->next_pc24=0x{target:06x}u;')
+            if block.insn.mode==LONG:out.append(f'cpu->PB=0x{target>>16:02x}u;')
+            continue
+        if isinstance(op,CondBranch):
+            fall=(block.pc+block.insn.length)&0xffffff
+            target=(block.pc&0xff0000)|(block.insn.operand&65535)
+            out += [f'if ({_reg(op.flag)} == {op.take_if}) {{',
+                    f'  scope->next_pc24 = 0x{target:06x}u;',
+                    '  scope->cpu_cycles += 1;',
+                    ('  if (cpu->emulation) scope->cpu_cycles += 1;' if ((fall^target)&0xff00) else f'  if (cpu->emulation && ((0x{fall&65535:04x}u ^ 0x{target&65535:04x}u) & 0xff00u)) scope->cpu_cycles += 1;'),
+                    '}']
+            continue
+        lines=emit_op(op,block.pc)
+        if any(any(bad in line for bad in ('TODO','UNHANDLED','interp_','cpu_dispatch','RecompReturn','goto L_')) for line in lines):
+            raise ValueError(f'Unsupported lowering output at {block.pc:06X}')
+        for line in lines:
+            for name in ('read8','read16','write8','write16'):
+                line=line.replace(f'cpu_{name}(',f'nb69_{name}(scope, ')
+            out.append(line)
+    return out
+
+COMMON=r'''
+static uint64_t nb69_key(NativeBlockKey k) {
+  return ((uint64_t)k.profile << 27) | ((uint64_t)k.pc24 << 3) | ((uint64_t)k.m << 2) | ((uint64_t)k.x << 1) | k.e;
+}
+static NativeBlockKey nb69_next(CpuState *cpu, uint32_t pc, uint32_t profile) {
+  NativeBlockKey k={0}; k.pc24=pc; k.profile=profile; k.m=cpu->m_flag; k.x=cpu->x_flag; k.e=cpu->emulation; return k;
+}
+static uint8_t nb69_read8(NativeBlockScope *s,CpuState *cpu,uint8_t bank,uint16_t address) {
+  uint32_t a=((uint32_t)bank<<16)|address;
+  uint32_t speed=s->host->region_speed(s->host->context,a);
+  uint8_t value=s->host->read8(s->host->context,cpu,a);
+  s->data_extra+=speed-6; cpu->open_bus=value; return value;
+}
+static void nb69_write8(NativeBlockScope *s,CpuState *cpu,uint8_t bank,uint16_t address,uint8_t value) {
+  uint32_t a=((uint32_t)bank<<16)|address;
+  uint32_t speed=s->host->region_speed(s->host->context,a);
+  s->host->write8(s->host->context,cpu,a,value);
+  s->data_extra+=speed-6; cpu->open_bus=value;s->wrote_memory=true;
+}
+static int nb69_mode(CpuState *cpu,NativeBlockKey key) {
+  if(!cpu||!cpu->ram||key.pc24>0xffffffu||key.m>1||key.x>1||key.e>1||cpu->PB!=(key.pc24>>16)||
+     cpu->m_flag!=key.m||cpu->x_flag!=key.x||cpu->emulation!=key.e||
+     cpu->_flag_N>1||cpu->_flag_V>1||cpu->_flag_Z>1||cpu->_flag_C>1||cpu->_flag_I>1||cpu->_flag_D>1||
+     (key.x&&(cpu->X>255||cpu->Y>255)))return 0;
+  uint8_t p=(cpu->m_flag?32:0)|(cpu->x_flag?16:0)|(cpu->_flag_N?128:0)|(cpu->_flag_V?64:0)|
+      (cpu->_flag_Z?2:0)|(cpu->_flag_C?1:0)|(cpu->_flag_I?4:0)|(cpu->_flag_D?8:0);
+  return p==cpu->P&&(!key.e||(key.m&&key.x&&cpu->S>=0x100&&cpu->S<=0x1ff&&cpu->X<=255&&cpu->Y<=255));
+}
+static NativeBlockResult nb69_result(NativeBlockKey key,NativeBlockAction action,NativeBlockFault fault,uint64_t count) {
+  NativeBlockResult r={0};r.next=key;r.action=action;r.fault=fault;r.executed=count;return r;
+}
+static NativeBlockResult nb69_step(const NativeBlockProgram *program,const NativeBlockHost *host,
+                                  CpuState *cpu,NativeBlockKey key,uint64_t deadline) {
+  if(!program||!host||!host->admit||!host->mapping||!host->read8||!host->write8||!host->region_speed||
+     !host->begin||!host->commit||!host->end)return nb69_result(key,NATIVE_BLOCK_REJECTED,NATIVE_BLOCK_FAULT_ABI,0);
+  if(!nb69_mode(cpu,key)||key.profile!=program->profile)return nb69_result(key,NATIVE_BLOCK_REJECTED,NATIVE_BLOCK_FAULT_MODE,0);
+  uint64_t wanted=nb69_key(key);size_t lo=0,hi=program->instruction_count;
+  while(lo<hi){size_t mid=lo+(hi-lo)/2;uint64_t have=nb69_key(program->instructions[mid].key);if(have<wanted)lo=mid+1;else hi=mid;}
+  if(lo==program->instruction_count||nb69_key(program->instructions[lo].key)!=wanted)
+    return nb69_result(key,NATIVE_BLOCK_MISSING,NATIVE_BLOCK_FAULT_NONE,0);
+  const NativeBlockInstruction *instruction=program->instructions+lo;
+  if((cpu->P&instruction->required_p_mask)!=instruction->required_p_value)
+    return nb69_result(key,NATIVE_BLOCK_REJECTED,NATIVE_BLOCK_FAULT_CONTEXT,0);
+  if(!host->admit(host->context,program,cpu,instruction))return nb69_result(key,NATIVE_BLOCK_REJECTED,NATIVE_BLOCK_FAULT_SOURCE,0);
+  if(!host->mapping(host->context,cpu,instruction))return nb69_result(key,NATIVE_BLOCK_REJECTED,NATIVE_BLOCK_FAULT_MAPPING,0);
+  if(deadline&&cpu->master_cycles>=deadline)return nb69_result(key,NATIVE_BLOCK_DEADLINE,NATIVE_BLOCK_FAULT_NONE,0);
