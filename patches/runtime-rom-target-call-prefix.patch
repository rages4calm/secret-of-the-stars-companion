+"""Original ROM-target SEP30/direct-JSR prefixes; no aftercall/owner/exit grants."""
+import weakref
+from snes65816 import rom_offset
+from .architecture_emission_policy import _digest,_graph_digest
+from .architecture_rom_stack_tail_sources import _scope_context,_validate,_role_ok,scope_context
+_RECORDS=weakref.WeakKeyDictionary()
+_REFUSALS=weakref.WeakKeyDictionary()
+_USED=weakref.WeakSet()
+CONTRACT='source-ROM-word-direct-call-prefix-v1'
+
+
+def _shape(rom,graph):
+    entry=graph.entry
+    if (entry.m,entry.x)!=(0,1)or len(graph.insns)!=2 or graph.authority_conflict or graph.data_region_exec_pcs or graph.unresolved_indirects:return None
+    sep=graph.insns.get(entry)
+    if sep is None or len(sep.successors)!=1:return None
+    callkey=next(iter(sep.successors));call=graph.insns.get(callkey)
+    if call is None or (callkey.pc,callkey.m,callkey.x)!=(entry.pc+2,1,1)or call.successors:return None
+    for key,di,opcode,mnem,operand,length in((entry,sep,0xe2,'SEP',0x30,2),(callkey,call,0x20,'JSR',call.insn.operand,3)):
+        ins=di.insn
+        if (ins.addr,ins.opcode,ins.mnem,ins.operand,ins.length)!=(key.pc,opcode,mnem,operand,length):return None
+        if ins.data_region_exec or getattr(ins,'const_z_fold_unconditional',False)or any(getattr(ins,f,None)for f in('dispatch_entries','dispatch_runtime','dispatch_consumed_stack_bytes','terminal_jsr','noreturn_jsr')):return None
+        if type(ins.operand)is not int or not 0<=ins.operand<=(0xff if length==2 else 0xffff):return None
+        raw=bytes((opcode,operand))if length==2 else bytes((opcode,operand&255,operand>>8))
+        off=rom_offset(key.pc>>16,key.pc&65535)
+        if off<0 or off+length>len(rom)or rom[off:off+length]!=raw:return None
+    target=(callkey.pc&0xff0000)|call.insn.operand
+    if tuple(graph.unknown_callee_exit_sites)!=((callkey.pc,target,1,1),):return None
+    if set(graph.insns)!={entry,callkey}:return None
+    return entry,callkey
+
+
+def _rows(collector):
+    result={}
+    for row in collector:
+        key=tuple(row[f]for f in('pc24','m','x'))
+        if key in result:raise ValueError('ambiguous original target prefix collector')
+        result[key]=row
+    return result
+
+
+def _record_original_prefix(producer,stream,scope,rom,parsed,local,calls,*,enable_native_call_prefix):
+    from .architecture_rom_stack_dispatch_sources import _PREFIX_PRODUCER
+    from .architecture_eligibility import _mask,_independent
+    if producer is not _PREFIX_PRODUCER or stream in _USED:raise ValueError('original target prefix completion issuer required')
+    if not enable_native_call_prefix:return
+    cert,graph=_scope_context(rom,parsed,stream,scope)
+    keys=_shape(rom,graph)
+    if keys is None:return # no new row, source record or authority
+    cert,graph=_validate(rom,parsed,stream,scope)
+    if _shape(rom,graph)!=keys:raise ValueError('prefix changed during original full validation')
+    if scope._start&65535 in(scope._role.get('sibling_entry_pcs')or()):raise ValueError('original sibling target role refused')
+    ordinary=_rows(local);prefixes=_rows(calls);output=[];missing=[]
+    for index,key in enumerate(keys):
+        ins=graph.insns[key].insn
+        if _mask(parsed,key.pc,ins.length)or not _role_ok(cert,key.pc,key.m,key.x,ins.length):raise ValueError('prefix original byte role/mask refused')
+        row=(ordinary if index==0 else prefixes).get((key.pc,key.m,key.x))
+        if row is None:missing.append([key.pc,key.m,key.x]);continue
+        row=dict(row)
+        if (row['pc24'],row['m'],row['x'],row['bytes'],row['length'],row['mnemonic'])!=(key.pc,key.m,key.x,rom[rom_offset(key.pc>>16,key.pc&65535):rom_offset(key.pc>>16,key.pc&65535)+ins.length].hex(),ins.length,ins.mnem):raise ValueError('original prefix collector typed source mismatch')
+        if index==1:
+            fields={'pc24','m','x','length','cycles','bytes','next_pc','body','mnemonic','contract','original_scheduler_call','frame_bytes','runtime_adapter'}
+            if set(row)!=fields or row['next_pc']!=((key.pc&0xff0000)|ins.operand)or row['contract']!='source-direct-call-architectural-prefix-v1'or row['original_scheduler_call']is not True or row['frame_bytes']!=2:raise ValueError('original direct JSR prefix contract required')
+        if not _independent(rom,parsed,row):raise ValueError('original canonical prefix body refused')
+        output.append(row)
+    if missing:
+        _REFUSALS.setdefault(stream,[]).append({'target':scope._start,'source_graph_sha256':_graph_digest(rom,graph),'reason':'original prefix collector unavailable; interpreter fallback retained','missing_keys':missing})
+        return
+    records=_RECORDS.setdefault(stream,[])
+    if any(r['scope']is scope or r['start']==scope._start for r in records):raise ValueError('original prefix target issued twice')
+    record={'scope':scope,'certificate':cert,'start':scope._start,'graph':graph,'graph_sha':_graph_digest(rom,graph),'keys':tuple((k.pc,k.m,k.x)for k in keys),'rows':tuple(output),'row_sha':_digest(output),'options_sha':scope._options_sha,'role_sha':scope._role_sha}
+    record['seal']=_digest((record['start'],record['graph_sha'],record['keys'],record['rows'],record['options_sha'],record['role_sha']))
+    records.append(record)
+
+
+def _metadata(enabled,origins,refused):
+    return {'contract':CONTRACT,'enabled':enabled,'origins':origins,'refused':refused,'shape':'actual typed SEP30 -> direct JSR unknown-call boundary only','original_call_collector':True,'ordinary_roots_added':False,'callee_exit_modes_added':False,'caller_owner_added':False,'saved_history_exported':False,'aftercall_closure_added':False,'old_pure_family_changed':False,'old_terminal_tail_contract_changed':False,'source_bound_changes':False,'E0_runtime_guard_unchanged':True}
+
+
+def derive(rom,parsed,stream,*,enable_native_call_prefix=True):
+    from .architecture_eligibility import _mask,_independent
+    if stream in _USED or not stream._sealed or stream._parsed is not parsed or stream._rom_object is not rom:raise ValueError('sealed one-use original prefix stream required')
+    _USED.add(stream) # consumed before current proof checks, callbacks or refusal
+    records=_RECORDS.pop(stream,[]);refused=_REFUSALS.pop(stream,[]);rows={};origins=[]
+    if not enable_native_call_prefix:
+        if records or refused:raise ValueError('disabled prefix consumer has issued source records')
+        return [],_metadata(False,[],[])
+    for record in records:
+        cert,graph=_validate(rom,parsed,stream,record['scope'])
+        if cert is not record['certificate']or scope_context(record['scope'])!=(record['options_sha'],record['role_sha'])or graph is not record['graph']or _graph_digest(rom,graph)!=record['graph_sha']or _digest(list(record['rows']))!=record['row_sha']or _digest((record['start'],record['graph_sha'],record['keys'],record['rows'],record['options_sha'],record['role_sha']))!=record['seal']:raise ValueError('prefix graph/body/current context seal changed')
+        keys=_shape(rom,graph)
+        if keys is None or tuple((k.pc,k.m,k.x)for k in keys)!=record['keys']:raise ValueError('prefix typed source changed')
+        for row in record['rows']:
+            key=tuple(row[f]for f in('pc24','m','x'))
+            if _mask(parsed,key[0],row['length'])or not _role_ok(cert,*key,row['length'])or not _independent(rom,parsed,row):raise ValueError('prefix consume mask/body/role refused')
+            if key in rows and rows[key]!=row:raise ValueError('unequal original canonical prefix row')
+            rows[key]=dict(row)
+        origins.append({'target':record['start'],'entry_m':0,'entry_x':1,'source_graph_sha256':record['graph_sha'],'instruction_keys':[list(k)for k in record['keys']],'producer_keys':[[k.pc,k.m,k.x]for k in cert._keys],'unknown_call_exit_preserved':True,'numeric_aftercall_start_added':False})
+    return [rows[k]for k in sorted(rows)],_metadata(True,origins,refused)
