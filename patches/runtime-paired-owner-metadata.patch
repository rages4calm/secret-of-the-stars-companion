diff --git a/runner/src/cpu_state.c b/runner/src/cpu_state.c
--- a/runner/src/cpu_state.c
+++ b/runner/src/cpu_state.c
@@ -1490,11 +1490,27 @@
 int cpu_take_continuation_snapshot(CpuState *cpu, uint16 entry_s, uint8 hrv,
                                    uint32 *out) {
     NativeContinuationInvocation *c = continuation_current();
-    if (!c || !out || c->cpu != cpu || !c->snapshot_pending ||
-        g_recomp_stack_top != c->root_depth || entry_s != c->frame.entry_s ||
-        cpu->S != entry_s || hrv != c->frame.entry->remaining_frame) return 0;
-    c->snapshot_pending = 0;
-    *out = c->frame.outer_return_pc;
+    if (c && out && c->cpu == cpu && c->snapshot_pending &&
+        g_recomp_stack_top == c->root_depth && entry_s == c->frame.entry_s &&
+        cpu->S == entry_s && hrv == c->frame.entry->remaining_frame) {
+        c->snapshot_pending = 0;
+        *out = c->frame.outer_return_pc;
+        return 1;
+    }
+    /* Legacy generated bodies call this API solely to obtain host return-PC
+     * metadata. Their existing fallback performs these exact mapped reads.
+     * Handle that fallback here so immutable generated51 code also preserves
+     * the guest bus latch, without publishing/acquiring continuation ownership.
+     * Managed snapshot admission/refusal and pending/publication stay intact. */
+    if (!cpu || !out || (hrv != 2 && hrv != 3)) return 0;
+    const uint8 saved_bus = cpu->open_bus;
+    const uint16 lo = cpu_read8(cpu, 0x00, (uint16)(entry_s + 1u));
+    const uint16 hi = cpu_read8(cpu, 0x00, (uint16)(entry_s + 2u));
+    const uint8 bank = (hrv == 3)
+        ? cpu_read8(cpu, 0x00, (uint16)(entry_s + 3u)) : cpu->PB;
+    *out = ((uint32)bank << 16) |
+        (uint16)((((hi << 8) | lo) + 1u) & 0xFFFFu);
+    cpu->open_bus = saved_bus;
     return 1;
 }
 int cpu_publish_continuation_return(CpuState *cpu, uint16 entry_s, uint16 pre_s,
