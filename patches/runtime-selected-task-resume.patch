+/* Private source-selected task observer; original guest/runtime ownership wins. */
+#include "../task_resume_contract.h"
+#include "../task_resume_contract.inc"
+#include "cart.h"
+#include "../program_module.h"
+__attribute__((weak)) const TaskResumeRecipe g_native_task_resume_recipe={0};
+__attribute__((weak)) int cpu_source_task_recipe_matches(int (*peek)(void *,uint32,unsigned char *),void *ctx){(void)peek;(void)ctx;return 0;}
+__attribute__((weak)) bool cpu_source_task_region_step(CpuState *cpu,uint32 pc,uint8 mx,uint32 *next) {
+ (void)cpu;(void)pc;(void)mx;(void)next;return false;
+}
+extern SnesProgramModule g_program_module;
+static TaskResumeSnapshot s_task_proof,s_task_active;
+static uint64_t s_task_owner_serial,s_task_next_serial;
+static uint64_t s_task_hook_generation;
+static unsigned s_task_prepared;
+static TaskResumeState s_task_from;
+static uint32 s_task_prepared_source,s_task_prepared_target;
+void interp_bridge_source_task_reset(void) {
+ task_resume_reset(&s_task_proof);task_resume_reset(&s_task_active);
+ s_task_prepared=0;memset(&s_task_from,0,sizeof(s_task_from));
+}
+static int task_peek(void *ctx,uint32 at,uint8 *out) {
+ CpuState *cpu=(CpuState*)ctx;
+ if(at<0x2000u&&cpu&&cpu->ram){*out=cpu->ram[at];return 1;}
+ if(at>0xffffffu||(at&0xffffu)<0x8000u||!g_snes||!g_snes->cart||!g_snes->cart->rom)return 0;
+ Cart *c=g_snes->cart;const uint8 *p=cart_getRomPtr(c,(uint8)(at>>16),(uint16)at);
+ uintptr_t start=(uintptr_t)c->rom,where=(uintptr_t)p;
+ if(!p||where<start||where-start>=c->romSize)return 0;*out=*p;return 1;
+}
+static uint8 task_pack_p(const CpuState *c) {
+ return (uint8)((c->m_flag?CPU_P_M:0)|(c->x_flag?CPU_P_X:0)|
+ (c->_flag_C?CPU_P_C:0)|(c->_flag_Z?CPU_P_Z:0)|(c->_flag_I?CPU_P_I:0)|
+ (c->_flag_D?CPU_P_D:0)|(c->_flag_V?CPU_P_V:0)|(c->_flag_N?CPU_P_N:0));
+}
+static TaskResumeState task_cpu_view(CpuState *c,uint32 actual) {
+ const SnesProgramModule *m=snes_program_module_active();if(!m)m=&g_program_module;
+ TaskResumeState v={(uintptr_t)c,(uintptr_t)m,
+  s_interp_owner_exit_valid?(uintptr_t)&s_interp_owner_exit_valid:0,
+  RtlStateGeneration(),(uint64_t)snes_frame_counter,s_task_owner_serial,
+  actual,c->S,c->A,c->X,c->Y,c->D,task_pack_p(c),c->DB,c->emulation};return v;
+}
+static TaskResumeState task_local_view(CpuState *c,const Interp816 *in,uint32 actual) {
+ TaskResumeState v=task_cpu_view(c,actual);
+ v.s=in->sp;v.a=in->a;v.x=in->x;v.y=in->y;v.d=in->dp;v.db=in->db;v.e=in->e;
+ v.p=(uint8)((in->mf?CPU_P_M:0)|(in->xf?CPU_P_X:0)|(in->c?CPU_P_C:0)|
+  (in->z?CPU_P_Z:0)|(in->i?CPU_P_I:0)|(in->d?CPU_P_D:0)|(in->v?CPU_P_V:0)|(in->n?CPU_P_N:0));return v;
+}
+static void task_committed_view(CpuState *c,uint32 source,const TaskResumeState *v) {
+ const TaskResumeRecipe *r=&g_native_task_resume_recipe;
+ if(v->module!=(uintptr_t)&g_program_module||!r->count)return;
+ if(source==r->select_pc){interp_bridge_source_task_reset();s_task_hook_generation=s_pre_opcode_hook_generation;
+  if(cpu_source_task_recipe_matches(task_peek,c))task_resume_selected(&s_task_proof,r,source,v,task_peek,c);}
+ else if(source==r->return_pc){task_resume_reset(&s_task_active);
+  if(s_task_hook_generation!=s_pre_opcode_hook_generation){interp_bridge_source_task_reset();return;}
+  task_resume_publish(&s_task_proof,source,v,task_peek,c);}
+}
+void interp_bridge_source_task_committed(CpuState *c,uint32 source,uint32 actual) {
+ if(!c)return;TaskResumeState v=task_cpu_view(c,actual);task_committed_view(c,source,&v);
+}
+static int task_prepare_return(CpuState *c,uint32 source,uint32 actual,unsigned route) {
+ s_task_prepared=0;
+ if(!s_task_proof.published||s_task_proof.handoff||source!=s_task_proof.recipe->return_pc)return 0;
+ TaskResumeState v=task_cpu_view(c,actual);
+ if(v.pc!=s_task_proof.actual_landing||v.s!=s_task_proof.actual_s||v.p!=s_task_proof.actual_p)return 0;
+ s_task_from=v;s_task_prepared_source=source;s_task_prepared_target=actual;s_task_prepared=route;return 1;
+}
+static void task_owner_enter(CpuState *c,uint32 entry,int interrupt_run) {
+ TaskResumeState v=task_cpu_view(c,entry);
+ if(!interrupt_run&&s_task_prepared&&entry==s_task_prepared_target){
+  unsigned route=s_task_prepared;s_task_prepared=0;
+  if(task_resume_handoff(&s_task_proof,s_task_prepared_source,route,&s_task_from,&v))return;
+ }
+ interp_bridge_source_task_reset();
+}
+static int task_pre_opcode(CpuState *c,uint32 pc,uint8 mx) {
+ TaskResumeState v=task_cpu_view(c,pc);uint32 landing;uint8 mode;
+ if(s_task_hook_generation!=s_pre_opcode_hook_generation){interp_bridge_source_task_reset();return 0;}
+ if(s_task_proof.published){TaskResumeSnapshot keep=s_task_proof;
+  if(task_resume_take(&s_task_proof,&v,task_peek,c,&landing,&mode)){
+   s_task_active=keep;s_task_active.actual=v;s_task_active.actual_landing=landing;s_task_active.actual_p=v.p;
+  }
+ }
+ if(!s_task_active.published)return 0;
+ TaskResumeSnapshot *a=&s_task_active;
+ int valid=v.cpu==a->actual.cpu&&v.module==a->actual.module&&v.owner==a->actual.owner&&
+  v.owner_epoch==a->actual.owner_epoch&&v.frame==a->actual.frame&&v.generation==a->actual.generation&&
+  v.pc==a->actual.pc&&v.s==a->actual.s&&v.p==a->actual.p&&v.a==a->actual.a&&
+  v.x==a->actual.x&&v.y==a->actual.y&&v.d==a->actual.d&&v.db==a->actual.db&&!v.e&&
+  mx==(((v.p>>5)&1)*2+((v.p>>4)&1));
+ uint8 b;for(unsigned n=0;valid&&n<11;n++)valid=task_peek(c,a->saved_s+1+n,&b)&&b==a->bytes[n];
+ uint8 lo,hi,status,slo,shi;
+ valid=valid&&task_peek(c,a->recipe->current_index,&lo)&&task_peek(c,a->recipe->current_index+1,&hi)&&
+  (uint16)(lo|((uint16)hi<<8))==a->index&&task_peek(c,a->recipe->status_base+a->index,&status)&&status==1&&
+  task_peek(c,a->recipe->saved_s_base+a->index,&slo)&&task_peek(c,a->recipe->saved_s_base+a->index+1,&shi)&&
+  (uint16)(slo|((uint16)shi<<8))==a->saved_s;
+ if(!valid){task_resume_reset(a);return 0;}return 1;
+}
+bool cpu_source_task_resume_active(CpuState *c,uint32 pc,uint8 mx){return task_pre_opcode(c,pc,mx)!=0;}
+static void task_step_finished(CpuState *c,uint32 actual,int completed) {
+ if(!completed){task_resume_reset(&s_task_active);return;}
+ s_task_active.actual=task_cpu_view(c,actual);
+}
