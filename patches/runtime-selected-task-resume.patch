diff --git a/runner/src/task_resume_contract.h b/runner/src/task_resume_contract.h
new file mode 100644
--- /dev/null
+++ b/runner/src/task_resume_contract.h
@@ -0,0 +1,46 @@
+#ifndef SOURCE_SELECTED_TASK_RESUME_H
+#define SOURCE_SELECTED_TASK_RESUME_H
+#include <stdint.h>
+#include <stddef.h>
+
+/* Transient proof state only. Original guest WRAM is the suspended task. */
+typedef struct {
+ uint32_t select_pc, return_pc, callee_pc;
+ uint16_t current_index, status_base, saved_s_base;
+ uint8_t count, stride, status, frame_bytes;
+ uint32_t callsite[2], landing[2];
+} TaskResumeRecipe;
+typedef struct {
+ uintptr_t cpu, module, owner;
+ uint64_t generation, frame, owner_epoch;
+ uint32_t pc;
+ uint16_t s,a,x,y,d;
+ uint8_t p,db,e;
+} TaskResumeState;
+typedef int (*TaskResumePeek)(void *,uint32_t,uint8_t *);
+typedef struct {
+ TaskResumeState epoch,actual;
+ const TaskResumeRecipe *recipe;
+ uint16_t index,saved_s;
+ uint8_t bytes[11], pending;
+ uint32_t actual_landing;
+ uint16_t actual_s;
+ uint8_t actual_p,published,handoff;
+} TaskResumeSnapshot;
+
+void task_resume_reset(TaskResumeSnapshot *);
+/* Called after committed TCS, never writes/fetches/charges guest state. */
+int task_resume_selected(TaskResumeSnapshot *,const TaskResumeRecipe *,uint32_t,
+                         const TaskResumeState *,TaskResumePeek,void *);
+/* Called after actual committed RTL; never changes host return ownership. */
+int task_resume_publish(TaskResumeSnapshot *,uint32_t,const TaskResumeState *,
+                        TaskResumePeek,void *);
+enum TaskResumeOwnerRoute { TASK_OWNER_POPPED_RETURN=1,TASK_OWNER_REWRITTEN_RETURN=2 };
+/* Only the actual original popped/rewritten-return handler may issue this.
+   It records a handoff already chosen by original ownership code. */
+int task_resume_handoff(TaskResumeSnapshot *,uint32_t,unsigned,
+                         const TaskResumeState *,const TaskResumeState *);
+/* Consume once at scheduler safe admission, after existing pre-opcode gates. */
+int task_resume_take(TaskResumeSnapshot *,const TaskResumeState *,
+                     TaskResumePeek,void *,uint32_t *,uint8_t *);
+#endif
diff --git a/runner/src/task_resume_contract.inc b/runner/src/task_resume_contract.inc
new file mode 100644
--- /dev/null
+++ b/runner/src/task_resume_contract.inc
@@ -0,0 +1,87 @@
+#include "task_resume_contract.h"
+#include <string.h>
+
+void task_resume_reset(TaskResumeSnapshot *s) { if(s) memset(s,0,sizeof(*s)); }
+static uint16_t word(const uint8_t *p) { return (uint16_t)(p[0]|((uint16_t)p[1]<<8)); }
+static int epoch(const TaskResumeState *a,const TaskResumeState *b) {
+ return a->cpu==b->cpu && a->module==b->module && a->owner==b->owner &&
+ a->generation==b->generation && a->frame==b->frame && a->owner_epoch==b->owner_epoch;
+}
+static int peekword(TaskResumePeek peek,void *ctx,uint32_t at,uint16_t *out) {
+ uint8_t a,b;if(!peek(ctx,at,&a)||!peek(ctx,at+1,&b))return 0;
+ *out=(uint16_t)(a|((uint16_t)b<<8));return 1;
+}
+int task_resume_selected(TaskResumeSnapshot *s,const TaskResumeRecipe *r,uint32_t source_pc,
+ const TaskResumeState *v,TaskResumePeek peek,void *ctx) {
+ if(!s)return 0;task_resume_reset(s);
+ if(!r||!v||!peek||v->e||!v->cpu||!v->module||!v->owner||
+    source_pc!=r->select_pc||v->pc!=r->select_pc+1||r->count!=12||r->stride!=4||r->status!=1||
+    r->frame_bytes!=11||v->s>0x1ff4)return 0;
+ uint16_t index,saved;uint8_t status,delay;
+ if(!peekword(peek,ctx,r->current_index,&index)||index!=v->x||
+    index%r->stride||index>=r->count*r->stride||
+    !peek(ctx,r->status_base+index,&status)||status!=r->status||
+    !peek(ctx,r->status_base+index+1,&delay)||delay||
+    !peekword(peek,ctx,r->saved_s_base+index,&saved)||saved!=v->s||saved!=v->a)return 0;
+ uint8_t frame[11];
+ for(unsigned n=0;n<11;n++)if(!peek(ctx,saved+1+n,&frame[n]))return 0;
+ /* Both source suspension callsites immediately SEP20 before JSL FF03.
+    Saved X is symbolic and becomes the exact runtime variant selector. */
+ if(!(frame[7]&0x20))return 0;
+ uint32_t landing=((uint32_t)frame[10]<<16)|(uint16_t)(word(frame+8)+1);
+ int found=0;
+ for(unsigned n=0;n<2;n++)if(landing==r->landing[n]) {
+   uint8_t call[4];for(unsigned j=0;j<4;j++)if(!peek(ctx,r->callsite[n]+j,&call[j]))return 0;
+   uint32_t target=call[1]|((uint32_t)call[2]<<8)|((uint32_t)call[3]<<16);
+   found=call[0]==0x22&&target==r->callee_pc&&r->landing[n]==r->callsite[n]+4;
+ }
+ if(!found)return 0;
+ s->epoch=*v;s->recipe=r;s->index=index;s->saved_s=saved;
+ memcpy(s->bytes,frame,11);s->pending=1;return 1;
+}
+int task_resume_publish(TaskResumeSnapshot *s,uint32_t source_pc,const TaskResumeState *v,
+ TaskResumePeek peek,void *ctx) {
+ if(!s||!v||!peek||!s->pending||s->published)return 0;
+ int valid=epoch(&s->epoch,v)&&!v->e&&source_pc==s->recipe->return_pc;
+ uint16_t index,saved;
+ valid=valid&&peekword(peek,ctx,s->recipe->current_index,&index)&&index==s->index&&
+  peekword(peek,ctx,s->recipe->saved_s_base+index,&saved)&&saved==s->saved_s;
+ for(unsigned n=0;valid&&n<11;n++){uint8_t b;valid=peek(ctx,s->saved_s+1+n,&b)&&b==s->bytes[n];}
+ uint8_t p=s->bytes[7];uint16_t mask=(p&0x10)?0xff:0xffff;
+ uint32_t landing=((uint32_t)s->bytes[10]<<16)|(uint16_t)(word(s->bytes+8)+1);
+ valid=valid&&v->pc==landing&&v->a==s->saved_s&&v->s==s->saved_s+11&&v->db==s->bytes[0]&&v->d==word(s->bytes+1)&&
+  v->y==(word(s->bytes+3)&mask)&&v->x==(word(s->bytes+5)&mask)&&v->p==p;
+ if(!valid){task_resume_reset(s);return 0;}
+ s->pending=0;s->published=1;s->actual=*v;s->actual_landing=landing;s->actual_s=v->s;s->actual_p=p;
+ return 1;
+}
+int task_resume_take(TaskResumeSnapshot *s,const TaskResumeState *v,TaskResumePeek peek,void *ctx,uint32_t *pc,uint8_t *mx) {
+ if(!s||!v||!peek||!pc||!mx)return 0;
+ int ok=s->published&&!s->pending&&epoch(&s->epoch,v)&&!v->e&&
+  v->pc==s->actual_landing&&v->s==s->actual_s&&v->p==s->actual_p&&
+  v->a==s->actual.a&&v->x==s->actual.x&&v->y==s->actual.y&&v->d==s->actual.d&&v->db==s->actual.db;
+ uint16_t index,saved;uint8_t status;
+ ok=ok&&peekword(peek,ctx,s->recipe->current_index,&index)&&index==s->index&&
+  peek(ctx,s->recipe->status_base+index,&status)&&status==1&&
+  peekword(peek,ctx,s->recipe->saved_s_base+index,&saved)&&saved==s->saved_s;
+ for(unsigned n=0;ok&&n<11;n++){uint8_t b;ok=peek(ctx,s->saved_s+1+n,&b)&&b==s->bytes[n];}
+ if(ok){*pc=s->actual_landing;*mx=(uint8_t)(((v->p>>5)&1)*2+((v->p>>4)&1));}
+ task_resume_reset(s);return ok;
+}
+static int landing_state(const TaskResumeState *a,const TaskResumeState *b) {
+ return a->pc==b->pc&&a->s==b->s&&a->p==b->p&&a->a==b->a&&a->x==b->x&&a->y==b->y&&
+  a->d==b->d&&a->db==b->db&&a->e==b->e;
+}
+int task_resume_handoff(TaskResumeSnapshot *s,uint32_t source,unsigned route,
+ const TaskResumeState *from,const TaskResumeState *to) {
+ if(!s||!from||!to)return 0;
+ int valid=s->published&&!s->pending&&!s->handoff&&source==s->recipe->return_pc&&
+  (route==TASK_OWNER_POPPED_RETURN||route==TASK_OWNER_REWRITTEN_RETURN)&&
+  epoch(&s->epoch,from)&&landing_state(&s->actual,from)&&landing_state(from,to)&&
+  to->cpu==from->cpu&&to->module==from->module&&to->generation==from->generation&&
+  to->frame==from->frame&&to->owner&&to->owner_epoch;
+ if(!valid){task_resume_reset(s);return 0;}
+ /* No execution, register, memory, clock, unwind or C return decision here. */
+ s->epoch.owner=to->owner;s->epoch.owner_epoch=to->owner_epoch;
+ s->actual.owner=to->owner;s->actual.owner_epoch=to->owner_epoch;s->handoff=1;return 1;
+}
