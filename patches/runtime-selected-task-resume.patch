+    if any(((row['pc24']&0xff0000)|((row['pc24']+j)&65535))&0x7fffff in forced for j in range(row['length'])):continue
+    row['contract']='native-e0-source-selected-task-resume-v1';rows.append(row)
+   graphs.append({'landing':landing,'m':1,'x':x,'decoded_rows':len(graph.insns),'call_barriers':graph.unknown_callee_exit_sites})
+ unique={}
+ for row in rows:
+  k=(row['pc24'],row['m'],row['x'])
