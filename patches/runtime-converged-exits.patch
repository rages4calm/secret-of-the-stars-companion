+// A transient, early-round exit mismatch is not by itself a proof that the
+// complete final graph has conflicting exits. Re-certify only after convergence,
+// against closed, nonrecursive, nonquarantined dependencies. No assumed exits.
+fn converged_exit_certificate(
+    key: VariantKey,
+    graph: &FunctionDecodeGraph,
+    nodes: &BTreeMap<VariantKey, NodeSummary>,
+    exact: &HashMap<(u32, u8, u8), (u8, u8)>,
+    sets: &HashMap<(u32, u8, u8), Vec<(u8, u8)>>,
+    unstable: &HashSet<(u32, u8, u8)>,
+    inputs: &Inputs,
+    mapping: RomMapping,
+) -> Option<((u8, u8), String)> {
+    let node = nodes.get(&key)?;
+    if node.reasons != ["unstable_exit_fact"]
+        || graph.is_empty()
+        || graph.authority_conflict
+        || !graph.data_region_exec_pcs.is_empty()
+        || !graph.unknown_callee_exit_sites.is_empty()
+        || !graph.unresolved_indirects.is_empty()
+        || !graph.suppressed_indirect_calls.is_empty()
+        || graph.insns().iter().any(|di| {
+            di.insn.mnem == "RTI"
+                || di.insn.mnem == "XCE"
+                || (di.insn.mnem == "PLP" && di.key.p_stack.is_empty())
+        })
+        || has_truncated_call_continuation(graph)
+        || inputs.force_lle.contains(&key.pc24)
+        || mirror_pc24(mapping, key.pc24).is_some_and(|pc| inputs.force_lle.contains(&pc))
+    {
+        return None;
+    }
+    fn visit(
+        key: VariantKey,
+        nodes: &BTreeMap<VariantKey, NodeSummary>,
+        exact: &HashMap<(u32, u8, u8), (u8, u8)>,
+        sets: &HashMap<(u32, u8, u8), Vec<(u8, u8)>>,
+        unstable: &HashSet<(u32, u8, u8)>,
+        inputs: &Inputs,
+        mapping: RomMapping,
+        active: &mut HashSet<VariantKey>,
+        completed: &mut BTreeMap<VariantKey, Vec<(u8, u8)>>,
+    ) -> Option<()> {
+        if completed.contains_key(&key) {
+            return Some(());
+        }
+        if active.len() >= 256
+            || !active.insert(key)
+            || unstable.contains(&(key.pc24, key.m, key.x))
+            || inputs.force_lle.contains(&key.pc24)
+            || mirror_pc24(mapping, key.pc24).is_some_and(|pc| inputs.force_lle.contains(&pc))
+        {
+            return None;
+        }
+        let node = nodes.get(&key)?;
+        if node.disposition != "aot_eligible" || !node.reasons.is_empty() {
+            return None;
+        }
+        let mut modes = if let Some(pair) = exact.get(&(key.pc24, key.m, key.x)) {
+            vec![*pair]
+        } else {
+            sets.get(&(key.pc24, key.m, key.x))?.clone()
+        };
+        if modes.is_empty() {
+            return None;
+        }
+        modes.sort();
+        modes.dedup();
+        for edge in &node.demands {
+            if edge.resolution != "aot_exact" {
+                return None;
+            }
+            visit(
+                edge.target?,
+                nodes,
+                exact,
+                sets,
+                unstable,
+                inputs,
+                mapping,
+                active,
+                completed,
+            )?;
+        }
+        active.remove(&key);
+        completed.insert(key, modes);
+        Some(())
+    }
+    let mut active = HashSet::from([key]);
+    let mut dependencies = BTreeMap::new();
+    for edge in &node.demands {
+        if edge.resolution != "aot_exact" {
+            return None;
+        }
+        visit(
+            edge.target?,
+            nodes,
+            exact,
+            sets,
+            unstable,
+            inputs,
+            mapping,
+            &mut active,
+            &mut dependencies,
+        )?;
+    }
+    let modes = analyze_function_exit_mx_modes_with_sets(graph, Some(exact), Some(sets))?;
+    if modes.len() != 1 {
+        return None;
+    }
+    let pair = modes[0];
+    // Sort concrete decode records, including width, PHP history, original
+    // opcode/operand and all successors. Independent redecodes must agree.
+    let mut records: Vec<String> = graph.insns().iter().map(|di| format!("{di:?}")).collect();
+    records.sort();
+    let mut returns: Vec<_> = function_return_stack_delta_states(graph)
+        .into_iter()
+        .collect();
+    returns.sort_by_key(|item| item.0);
+    let certificate = format!(
+        "{key:?}|{pair:?}|{records:?}|{:?}|{dependencies:?}|{returns:?}",
+        graph.boundary_exits
+    );
+    Some((pair, certificate))
+}
