+
+    fn converged_fixture(
+        name: &str,
+    ) -> (
+        Inputs,
+        Vec<u8>,
+        VariantKey,
+        FunctionDecodeGraph,
+        BTreeMap<VariantKey, NodeSummary>,
+        HashMap<(u32, u8, u8), (u8, u8)>,
+        HashSet<(u32, u8, u8)>,
+    ) {
+        let path = Path::new(env!("CARGO_MANIFEST_DIR"))
+            .join("proof-config")
+            .join(name);
+        fs::create_dir_all(&path).unwrap();
+        fs::write(
+            path.join("bank00.cfg"),
+            "bank = 00\n# Synthetic conservative convergence controls\n",
+        )
+        .unwrap();
+        let mut rom = vec![0u8; 0x8000];
+        rom[..7].copy_from_slice(&[0x20, 0x00, 0x90, 0x20, 0x00, 0x91, 0x60]);
+        rom[0x1000..0x1003].copy_from_slice(&[0xe2, 0x30, 0x60]);
+        rom[0x1100..0x1103].copy_from_slice(&[0xc2, 0x10, 0x60]);
+        let inputs = load_inputs(&path, &mut rom, false).unwrap();
+        let key = VariantKey::new(0x008000, 1, 1);
+        let exact = HashMap::from([((0x009000, 1, 1), (1, 1)), ((0x009100, 1, 1), (1, 0))]);
+        let unstable = HashSet::from([(key.pc24, key.m, key.x)]);
+        let env = DecodeEnv {
+            callee_exit_mx: Some(&exact),
+            stop_on_unknown_callee_exit: true,
+            ..Default::default()
+        };
+        let graph = decode_function(&rom, 0, 0x8000, 1, 1, None, &env);
+        let root = summarize(
+            key,
+            &graph,
+            &inputs,
+            &rom,
+            RomMapping::LoRom,
+            &HashSet::new(),
+            true,
+        );
+        let mut nodes = BTreeMap::from([(key, root)]);
+        for pc in [0x009000, 0x009100] {
+            let entry = VariantKey::new(pc, 1, 1);
+            let g = decode_function(&rom, 0, pc & 0xffff, 1, 1, None, &env);
+            nodes.insert(
+                entry,
+                summarize(
+                    entry,
+                    &g,
+                    &inputs,
+                    &rom,
+                    RomMapping::LoRom,
+                    &HashSet::new(),
+                    false,
+                ),
+            );
+        }
+        (inputs, rom, key, graph, nodes, exact, unstable)
+    }
+
+    #[test]
+    fn complete_final_exit_certificate_is_repeatable() {
+        let (inputs, rom, key, graph, nodes, exact, unstable) = converged_fixture("repeat");
+        let first = converged_exit_certificate(
+            key,
+            &graph,
+            &nodes,
+            &exact,
+            &HashMap::new(),
+            &unstable,
+            &inputs,
+            RomMapping::LoRom,
+        )
+        .unwrap();
+        assert_eq!(first.0, (1, 0));
+        let env = DecodeEnv {
+            callee_exit_mx: Some(&exact),
+            stop_on_unknown_callee_exit: true,
+            ..Default::default()
+        };
+        let independent = decode_function(&rom, 0, 0x8000, 1, 1, None, &env);
+        assert_eq!(
+            Some(first),
+            converged_exit_certificate(
+                key,
+                &independent,
+                &nodes,
+                &exact,
+                &HashMap::new(),
+                &unstable,
+                &inputs,
+                RomMapping::LoRom
+            )
+        );
+    }
+
+    #[test]
+    fn converged_certificate_retains_root_and_dependency_refusals() {
+        let (mut inputs, _rom, key, mut graph, mut nodes, mut exact, mut unstable) =
+            converged_fixture("refusals");
+        let root = nodes[&key].clone();
+        for reason in [
+            "structural_poison",
+            "truncated_call_continuation",
+            "unproven_callee_exit",
+            "authority_conflict",
+            "decode_budget_exhausted",
+        ] {
+            nodes
+                .get_mut(&key)
+                .unwrap()
+                .reasons
+                .push(reason.to_string());
+            assert!(converged_exit_certificate(
+                key,
+                &graph,
+                &nodes,
+                &exact,
+                &HashMap::new(),
+                &unstable,
+                &inputs,
+                RomMapping::LoRom
+            )
+            .is_none());
+            nodes.insert(key, root.clone());
+        }
+        for pc in [key.pc24, key.pc24 ^ 0x800000, 0x009000, 0x809000] {
+            inputs.force_lle.insert(pc);
+            assert!(converged_exit_certificate(
+                key,
+                &graph,
+                &nodes,
+                &exact,
+                &HashMap::new(),
+                &unstable,
+                &inputs,
+                RomMapping::LoRom
+            )
+            .is_none());
+            inputs.force_lle.remove(&pc);
+        }
+        unstable.insert((0x009000, 1, 1));
+        assert!(converged_exit_certificate(
+            key,
+            &graph,
+            &nodes,
+            &exact,
+            &HashMap::new(),
+            &unstable,
+            &inputs,
+            RomMapping::LoRom
+        )
+        .is_none());
+        unstable.remove(&(0x009000, 1, 1));
+        exact.remove(&(0x009000, 1, 1));
+        assert!(converged_exit_certificate(
+            key,
+            &graph,
+            &nodes,
+            &exact,
+            &HashMap::new(),
+            &unstable,
+            &inputs,
+            RomMapping::LoRom
+        )
+        .is_none());
+        exact.insert((0x009000, 1, 1), (1, 1));
+        let dep = VariantKey::new(0x009000, 1, 1);
+        let original = nodes[&dep].clone();
+        nodes.get_mut(&dep).unwrap().demands.push(DemandEdge {
+            site_pc24: dep.pc24,
+            kind: "direct_call",
+            resolution: "aot_exact",
+            target: Some(dep),
+            detail: String::new(),
+        });
+        assert!(converged_exit_certificate(
+            key,
+            &graph,
+            &nodes,
+            &exact,
+            &HashMap::new(),
+            &unstable,
+            &inputs,
+            RomMapping::LoRom
+        )
+        .is_none());
+        nodes.insert(dep, original.clone());
+        nodes
+            .get_mut(&dep)
+            .unwrap()
+            .reasons
+            .push("unproven_callee_exit".to_string());
+        assert!(converged_exit_certificate(
+            key,
+            &graph,
+            &nodes,
+            &exact,
+            &HashMap::new(),
+            &unstable,
+            &inputs,
+            RomMapping::LoRom
+        )
+        .is_none());
+        nodes.insert(dep, original);
+        graph.authority_conflict = true;
+        assert!(converged_exit_certificate(
+            key,
+            &graph,
+            &nodes,
+            &exact,
+            &HashMap::new(),
+            &unstable,
+            &inputs,
+            RomMapping::LoRom
+        )
+        .is_none());
+        graph.authority_conflict = false;
+        graph.data_region_exec_pcs.insert(key.pc24);
+        assert!(converged_exit_certificate(
+            key,
+            &graph,
+            &nodes,
+            &exact,
+            &HashMap::new(),
+            &unstable,
+            &inputs,
+            RomMapping::LoRom
+        )
+        .is_none());
+        graph.data_region_exec_pcs.clear();
+        graph
+            .unknown_callee_exit_sites
+            .push((key.pc24, dep.pc24, 1, 1));
+        assert!(converged_exit_certificate(
+            key,
+            &graph,
+            &nodes,
+            &exact,
+            &HashMap::new(),
+            &unstable,
+            &inputs,
+            RomMapping::LoRom
+        )
+        .is_none());
+    }
+
+    #[test]
+    fn converged_certificate_refuses_real_conflicting_returns() {
+        let (inputs, mut rom, key, _graph, mut nodes, exact, unstable) =
+            converged_fixture("conflict");
+        rom[..8].copy_from_slice(&[0xd0, 0x03, 0xc2, 0x20, 0x60, 0xe2, 0x20, 0x60]);
+        let graph = decode_function(&rom, 0, 0x8000, 1, 1, None, &DecodeEnv::default());
+        nodes.get_mut(&key).unwrap().demands.clear();
+        assert_eq!(
+            analyze_function_exit_mx_modes_with_sets(&graph, Some(&exact), Some(&HashMap::new()))
+                .unwrap()
+                .len(),
+            2
+        );
+        assert!(converged_exit_certificate(
+            key,
+            &graph,
+            &nodes,
+            &exact,
+            &HashMap::new(),
+            &unstable,
+            &inputs,
+            RomMapping::LoRom
+        )
+        .is_none());
+        for opcode in [0x28, 0x40, 0xfb] {
+            // unpaired PLP, RTI, dynamic XCE
+            rom[..2].copy_from_slice(&[opcode, 0x60]);
+            let graph = decode_function(&rom, 0, 0x8000, 1, 1, None, &DecodeEnv::default());
+            assert!(converged_exit_certificate(
+                key,
+                &graph,
+                &nodes,
+                &exact,
+                &HashMap::new(),
+                &unstable,
+                &inputs,
+                RomMapping::LoRom
+            )
+            .is_none());
+        }
+    }
+
+    #[test]
+    fn optional_convergence_recovers_late_width_discovery_only() {
+        let (mut inputs, rom, key, _graph, _nodes, _exact, _unstable) = converged_fixture("late");
+        inputs.roots = BTreeSet::from([
+            key,
+            VariantKey::new(0x009000, 1, 1),
+            VariantKey::new(0x009100, 1, 1),
+        ]);
+        let (original, old_exact, _, _, _) = analyze(&inputs, &rom, 4096, 100, false).unwrap();
+        assert_eq!(original[&key].reasons, ["unstable_exit_fact"]);
+        assert!(!old_exact.contains_key(&(key.pc24, key.m, key.x)));
+        let (recovered, new_exact, _, _, _) = analyze(&inputs, &rom, 4096, 100, true).unwrap();
+        assert_eq!(recovered[&key].disposition, "aot_eligible");
+        assert_eq!(new_exact[&(key.pc24, key.m, key.x)], (1, 0));
+        for other in [
+            VariantKey::new(0x009000, 1, 1),
+            VariantKey::new(0x009100, 1, 1),
+        ] {
+            assert_eq!(original[&other].json(), recovered[&other].json());
+        }
+    }
+}
