+"""Private generic prefix contract: never assume an unknown callee exit."""
+from dataclasses import replace
+import re
+
+from .program_analysis import NodeDisposition
+
+_CALL = re.compile(r"unproven_call_at_([0-9A-F]{6})_to_([0-9A-F]{6})_m[01]x[01]$")
+_BASE = {"unproven_callee_exit", "truncated_call_continuation"}
+
+
+def unknown_call_sites(node):
+    return frozenset(int(m[1], 16) for reason in node.reasons
+                     if (m := _CALL.fullmatch(reason)))
+
+
+def prefix_admissible(node, force_lle=()):
+    """A distinct emission disposition, never full-function qualification."""
+    if node.disposition != NodeDisposition.LLE_ONLY:
+        return False
+    if node.key.pc24 in force_lle or node.key.pc24 >> 16 in (0x7E, 0x7F):
+        return False
+    reasons = set(node.reasons)
+    return (_BASE <= reasons and bool(unknown_call_sites(node)) and
+            all(reason in _BASE or _CALL.fullmatch(reason) for reason in reasons))
+
+
+def prepare_prefix_manifest(manifest, parsed):
+    excluded = set()
+    for _bank, _path, cfg in parsed:
+        for pc in cfg.force_lle:
+            excluded.add(pc)
+            if pc >> 16 < 0x40 and pc & 0xFFFF >= 0x8000:
+                excluded.add(pc ^ 0x800000)
+    nodes = {key: replace(node, disposition=NodeDisposition.AOT_PREFIX)
+             if prefix_admissible(node, excluded) else node
+             for key, node in manifest.nodes.items()}
+    return replace(manifest, nodes=nodes)
+
+
+def prefix_contracts(manifest, parsed):
+    """Exact stop sites and original hard masks, copied without relaxation."""
+    masks = []
+    for bank, _path, cfg in parsed:
+        for start, end in (*cfg.exclude_ranges, *cfg.authority_data):
+            masks.append((bank, start, end))
+        masks.extend(cfg.data_regions)
+    return {key: (unknown_call_sites(node), tuple(masks))
+            for key, node in manifest.nodes.items()
+            if node.disposition == NodeDisposition.AOT_PREFIX}
