+/* Only fixed-length source condition forms; live M/X/DB/DP/flags retain
+ * original instruction semantics. Direct function selected at registration. */
+bool interp_bridge_add_native_condition_site(uint32_t pc,const uint8_t *bytes,
+                          unsigned length,unsigned mask,const int *enabled) {
+    if(!bytes || !enabled || pc>0xffffff || (pc&0xffff)<0x8000 ||
+       (pc>>16)==0x7e || (pc>>16)==0x7f || !mask || (mask&~15u) ||
+       !length || length>3 || (pc&0xffff)+length>0x10000 ||
+       s_native_control_site_count==128 || s_pre_opcode_callback_cpu ||
+       s_native_instruction_cpu || s_interp_bus_timing_active)return false;
+    int (*step)(Interp816 *)=NULL;unsigned expected=2;
+    switch(bytes[0]) {
+    case 0x84:step=interp816_native_sty_dp;expected=2;break;
+    case 0xa4:step=interp816_native_ldy_dp;expected=2;break;
+    case 0xb7:step=interp816_native_lda_idly;expected=2;break;
+    case 0x85:step=interp816_native_sta_dp;expected=2;break;
+    case 0xc8:step=interp816_native_iny;expected=1;break;
+    case 0xa5:step=interp816_native_lda_dp;expected=2;break;
+    case 0xcd:step=interp816_native_cmp_abs;expected=3;break;
+    case 0xc5:step=interp816_native_cmp_dp;expected=2;break;
+    case 0x90:step=interp816_native_bcc;expected=2;break;
+    case 0xd0:step=interp816_native_bne;expected=2;break;
+    case 0xe6:step=interp816_native_inc_dp;expected=2;break;
+    case 0xc2:step=interp816_native_rep;expected=2;break;
+    case 0xe2:step=interp816_native_sep;expected=2;break;
+    case 0xad:step=interp816_native_lda_abs;expected=3;break;
+    case 0xf0:step=interp816_native_beq;expected=2;break;
+    default:return false;
+    }
+    if(length!=expected)return false;
     for(unsigned n=0;n<s_native_control_site_count;++n)
         if(s_native_control_sites[n].pc24==pc)return false;
     NativeControlSite *site=&s_native_control_sites[s_native_control_site_count++];
