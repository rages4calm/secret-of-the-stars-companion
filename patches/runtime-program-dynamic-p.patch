+            if not members or any(di.insn.opcode!=0x28 or di.insn.mnem!='PLP'or di.insn.length!=1 or getattr(di.insn,'const_z_fold_unconditional',False)for di in members):raise ValueError('program PLP actual typed graph member')
+            if _mask(parsed,pc,1):continue
+            for callpc in record['source_calls']:
+                sources=calls.get(callpc,[])
+                if not sources:raise ValueError('program PLP lost original call source')
+                expected={r['next_pc']if record['source_kind']=='callee'else((callpc&0xff0000)|((callpc&65535)+r['length']))for r in sources}
+                if record['source_kind']not in('callee','return')or start not in expected:raise ValueError('program PLP original source start')
+                boundaries.add(pc);origins.append({'source_call':callpc,'source_kind':record['source_kind'],'source_start':start,'boundary':pc,'typed_boundary_m':m,'typed_boundary_x':x})
+    rows={};successors=[]
+    for pc in sorted(boundaries):
+        active=False;bank=pc>>16
+        for m,x in((0,0),(0,1),(1,0),(1,1)):
+            off=rom_offset(bank,pc&65535);ins=decode_insn(rom,off,pc&65535,bank,m,x)
