+            ins.m_flag,ins.x_flag=m,x
+            row=collect_stack_control(rom,DecodeKey(pc,m,x),ins,lower(ins,value_factory=lambda:None),instr_cpu_cycles(ins.opcode,m=m,x=x,e=0))
+            if row and _independent(rom,parsed,row):rows[(pc,m,x)]=row;active=True
+        if not active:continue
+        start=(pc&65535)+1
+        if start>=65536:
+            refused.append({'source_PLP':pc,'reason':'nextPC wrap'});continue
+        for m,x in((0,0),(0,1),(1,0),(1,1)):
+            try:graph=decode_function(rom,bank,start,m,x,max_insns=128,data_regions=masks,stop_on_unknown_callee_exit=True)
+            except RuntimeError as error:
+                if 'v2 decoder exceeded max_insns=128'not in str(error):raise
+                refused.append({'source_PLP':pc,'m':m,'x':x,'reason':'128instruction source bound'});continue
+            if graph.authority_conflict or graph.data_region_exec_pcs or graph.unresolved_indirects or len(graph.insns)>=128:
+                refused.append({'source_PLP':pc,'m':m,'x':x,'reason':'conflict/data/indirect/128instruction bound'});continue
+            local=[];calls_local=[];c=cfg[bank]
+            emit_function(rom,bank,start,m,x,func_name='DiscardedProgramLiveModeSuccessor',data_regions=masks,exclude_ranges=c.exclude_ranges,hle_func=c.hle_func,hle_spc_upload=c.hle_spc_upload,source_task_resume_stops=graph.unknown_callee_exit_sites,native_region_collector=local,native_call_prefix_collector=calls_local if enable_native_call_prefix else None,native_call_prefix_forced=forced,_native_collector_only=True)
+            candidates=[r for r in local+calls_local if _independent(rom,parsed,r)]
+            supported={tuple(r[k]for k in('pc24','m','x'))for r in candidates};todo=[graph.entry];allowed=set();stops=[]
+            while todo:
+                key=todo.pop()
+                if key in allowed:continue
+                member=graph.insns.get(key)
+                if not member:continue
+                if member.insn.mnem in BARRIERS or (key.pc,key.m,key.x)not in supported or getattr(member.insn,'const_z_fold_unconditional',False):stops.append([key.pc,key.m,key.x,member.insn.mnem]);continue
+                allowed.add(key)
+                if member.insn.mnem not in('JSR','JSL'):todo.extend(member.successors)
+            admitted={(k.pc,k.m,k.x)for k in allowed};keys=[]
+            for row in candidates:
+                key=tuple(row[k]for k in('pc24','m','x'))
+                if key not in admitted:continue
+                if key in rows and rows[key]!=row:raise ValueError('unequal program live-mode body')
+                rows[key]=row;keys.append(list(key))
+            successors.append({'source_PLP':pc,'next_pc':(pc&0xff0000)|start,'parameter_m':m,'parameter_x':x,'instruction_keys':keys,'barriers':stops,'static_restored_mode_asserted':False})
+    return [rows[k]for k in sorted(rows)],{'source_stream':stream.metadata(),'origins':origins,'boundaries':sorted(boundaries),'successors':successors,'refused_source_contexts':refused,'callee_exit_modes_added':False,'caller_owner_added':False,'ordinary_roots_added':False,'restored_P_from_history':False}
