+BARRIERS={'PLP','RTI','TCS','TXS','XCE','MVN','MVP','RTS','RTL'}
+
+
+def derive(rom,parsed,stream,*,enable_native_call_prefix=True):
+    from .architecture_program_call_sources import derive as derive_program_calls
+    from .architecture_eligibility import _independent,_mask
+    # This factory authenticates the original stream/ROM/parsed/policy identity;
+    # no caller-supplied PC, row, graph metadata or history argument is accepted.
+    cert=derive_program_calls(rom,parsed,stream,enable_native_call_prefix=True)[1]
+    cfg={b:c for b,_p,c in parsed}
+    if len(cfg)!=len(parsed):raise ValueError('duplicate program live-mode bank')
+    masks=[r for c in cfg.values()for r in c.data_regions]+[(c.bank,a,b)for c in cfg.values()for a,b in c.authority_data+c.exclude_ranges]
+    forced={p&0x7fffff for c in cfg.values()for p in c.force_lle}
+    calls={}
+    for row in cert['calls']:
+        pc=row['pc24'];off=rom_offset(pc>>16,pc&65535)
+        ins=decode_insn(rom,off,pc&65535,pc>>16,row['m'],row['x'])
+        target=((pc&0xff0000)|ins.operand)if ins and ins.mnem=='JSR'else(ins.operand if ins else None)
+        if not ins or ins.mnem not in('JSR','JSL')or ins.length!=row['length']or rom[off:off+ins.length].hex()!=row['bytes']or target!=row['next_pc']:raise ValueError('program PLP original direct call')
+        if (pc&65535)+ins.length>=65536:raise ValueError('program PLP source return wrap')
+        if _mask(parsed,pc,ins.length):continue
+        calls.setdefault(pc,[]).append(row)
+    boundaries=set();origins=[];refused=[]
+    for record in cert['graphs']:
+        if record['parameter_m']not in(0,1)or record['parameter_x']not in(0,1):raise ValueError('program PLP original parameter')
+        selected=[b for b in record['barriers']if b[3]=='PLP']
